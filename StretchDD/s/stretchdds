 AREA StretchDDs, CODE

 EXPORT stretch_it

 IMPORT filename
 IMPORT quit
 IMPORT whinge
 IMPORT extend

stretch_it	STMFD	R13!,{R1-R5,R14}

		SWI	&400EA ; Wimp_BaseOfSprites
		MOV	R4,R1
		LDR	R0,extend
		CMP	R0,#0
		ADRLTL	R0,confirm_shrink_msg
		ADRLTL	R2,confirm_shrink_title
		ADRLTL	R5,confirm_shrink_opts
		ADRGTL	R0,confirm_stretch_msg
		ADRGTL	R2,confirm_stretch_title
		ADRGTL	R5,confirm_stretch_opts
		MOV	R1,#&990
		ADR	R3,confirm_sprite
		SWI	&400DF ; Wimp_ReportError
		CMP	R1,#3
		LDMNEFD	R13!,{R1-R5,PC}^

		MOV	R0,#&C3
		ADR	R1,filename
		SWI	&D ; OS_Find
		CMP	R0,#0
		ADREQL	R0,err_notfound
		BLEQ	whinge
		LDMEQFD	R13!,{R1-R5,PC}^
		MOV	R1,R0

		SWI	&406C0	; Hourglass_On

		MOV	R0,#2
		SWI	&9 + 1<<17 ; XOS_Args
		LDR	R3,extend
		ADD	R2,R2,R3,LSL#20
		MOV	R0,#3
		SWI	&9 + 1<<17 ; XOS_Args

		MOV	R0,#0
		SWI	&D ; OS_Find

		SWI	&406C1	; Hourglass_Off

		CMP	R3,#0
		ADRGTL	R0,stretch_final
		ADRLTL	R0,shrink_final
		BL	whinge

		MOV	R0,#1
		ADR	R1,quit
		STR	R0,[R1]

		LDMFD	R13!,{R1-R5,PC}^

confirm_sprite	DCB "!PC", 0

confirm_shrink_msg
		DCD 0
		DCB "If you didn't previously stretch this partition by exactly this amount, you may be about to destroy your files.  Shall I go ahead?",0
confirm_shrink_opts
		DCB "Shrink it!,No",0
confirm_shrink_title
		DCB "About to operate shrinking ray!",0
		ALIGN
confirm_stretch_msg
		DCD 0
		DCB "We disclaim all responsibility for stretching going horribly wrong; still feeling brave?",0
confirm_stretch_opts
		DCB "Stretch it!,No",0
confirm_stretch_title
		DCB "Insane stretch operation about to go ahead",0

err_notfound	DCB "Couldn't find partition file!",0
err_args	DCB "Error while resizing file",0
stretch_final	DCB "Remember to run PRESIZER.EXE on your new partition for DOS to recognise it.",0
shrink_final	DCB "Partition shrunk",0

 END
