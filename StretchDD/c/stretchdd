#include "stretchdds.h"

#define ER(x) if (x != NULL) wimp_report_error((void*) x, 0, "Socketeer");

static char         directory[32] = "<StretchDD$Dir>";
static void	    *sprite_area;
static void         *er;
extern int          quit = 0;
static MessagesFD   msg_block;
static IdBlock	    id_block;
static int          task_handle = 0, current_wimp = 0, interested = 0;

ObjectId            MainWin;

extern char     filename[256]="";
static long int filesize = 0;
extern int      extend = 0;

#define MAIN_FILENAME 0xB
#define MAIN_CURRENT  0x3
#define MAIN_EXTEND   0x5
#define MAIN_FINAL    0x8
#define MAIN_GO       0xC

void whinge(char *msg)
{
  _kernel_oserror    err;

  err.errnum = 0;
  strcpy(err.errmess, msg);
  wimp_report_error(&err, 0, "StretchDD");
}

int quit_handler(WimpMessage *message, void *handle)
{
  quit = 1;
  return(1);
}

int update_displays(int event_code, ToolboxEvent *event, IdBlock *id_block, void *handle)
{
  char str[16];
  int  oextend;

  oextend = extend;

  ER(numberrange_get_value(0, MainWin, MAIN_EXTEND, &extend));
  sprintf(str, "%d", filesize+extend);
  ER(displayfield_set_value(0, MainWin, MAIN_FINAL, str));
  if (extend < 0 && oextend >= 0)
    ER(actionbutton_set_text(0, MainWin, MAIN_GO, "Shrink"));
  if (extend >=0 && oextend < 0)
    ER(actionbutton_set_text(0, MainWin, MAIN_GO, "Stretch"));
  if ( (filesize+extend < 1 && filesize+oextend >=1) ||
       (extend == 0 && oextend != 0) )
    ER(gadget_set_flags(0, MainWin, MAIN_GO, 1<<31));
  if ( (filesize+extend >= 1 && filesize+oextend <1) ||
       (event !=0 && oextend == 0) )
    ER(gadget_set_flags(0, MainWin, MAIN_GO, 0));
}

int autocreate_handler(int event_code, ToolboxEvent *event, IdBlock *id_block, void *handle)
{
  ToolboxObjectAutoCreatedEvent    *event_a;

  event_a = (ToolboxObjectAutoCreatedEvent*) event;
  if (strcmp(event_a->template_name, "MainWin") == 0)
    MainWin = id_block->self_id;
}

int dataload_handler(WimpMessage *message, void *h)
{
  FILE *fh;
  char str[256];

  if (message->data.data_load.file_type == 0xFC8)
  {
    strcpy(filename, message->data.data_load.leaf_name);
    fh = fopen(filename, "rb+");
    fseek(fh, 0, SEEK_END);
    filesize = ftell(fh) >> 20;
    fclose(fh);

    ER(displayfield_set_value(0, MainWin, MAIN_FILENAME, filename));
    sprintf(str, "%d", filesize);
    ER(displayfield_set_value(0, MainWin, MAIN_CURRENT, str));

    ER(gadget_set_flags(0, MainWin, MAIN_CURRENT, 0));
    ER(gadget_set_flags(0, MainWin, MAIN_EXTEND, 0));
    ER(gadget_set_flags(0, MainWin, MAIN_FINAL, 0));
    ER(gadget_set_flags(0, MainWin, MAIN_GO, 0));
    update_displays(0,NULL,NULL,NULL);
    return(1);
  }
  else
  {
    whinge("DOS partitions only please!");
  }
  return(0);
}

int main(void)
{
  int              event_code;
  WimpPollBlock    poll_block;

  ER(event_register_message_handler(0, quit_handler, NULL));
  ER(event_register_toolbox_handler(-1, 0x100, (ToolboxEventHandler*) quit_handler, NULL));
  ER(event_register_toolbox_handler(-1, 0x110, (ToolboxEventHandler*) stretch_it, NULL));
  ER(event_register_toolbox_handler(-1, NumberRange_ValueChanged, update_displays, NULL));
  ER(event_register_toolbox_handler(-1, Toolbox_ObjectAutoCreated, autocreate_handler, NULL));
  ER(event_register_message_handler(Wimp_MDataLoad, dataload_handler, NULL));

  ER(event_initialise(&id_block));
  ER(toolbox_initialise(0, 310, &interested, &interested, directory, &msg_block,
                     &id_block, &current_wimp, &task_handle, &sprite_area));

  while (!quit)
    event_poll(&event_code, &poll_block, NULL);
}
