/* loadauto.c
**
** Ooo!  An excuse for recursive function calls!
*/

#include <stdlib.h>
#include <stdio.h>
#include <string.h>

#include "misc.h"

static char  buf[256];

static char *extension[77], done[77], order[77], next;
static char  before[77][32], before_next[77];

static char  num, c=0, c2=0, depth=0, mode=255, disabled=0;

#define MODE_LIST     0
#define MODE_STARTUP  1
#define MODE_SHUTDOWN 2

static char *lower(char *str)
{
  char *b;

  for (b=str; *b>=32; b++)
    if (*b>='A' && *b<='Z')
      *b+=32;
  return(str);
}

static void  order_it(char dep)
{
  int c3=0;

  /*printf("ordering %d\n", dep);*/

  if (++depth == 78)
  {
    system("Set Diva$Error Recursion detected in 'Order' files");
    exit(1);
  }

  if (done[dep])
    return;

  while (c3!=before_next[dep])
    order_it(before[dep][c3++]);

  order[next++] = dep;
      done[dep] = 1;
       depth--;
  /*printf("place = %d\n", next-1);*/
}

extern int main(int argc, char *argv[])
{
  FILE *fh;

  /* Zero all our workspace first */

  memset(before, 0, 77*32);
  memset(before_next, 0, 77);
  next = 0;

  /* Get list of extension module names into extension[] */

  while (num=c,(c=read_entry("<Diva$Dir>.PCBits", buf, (int)c, NULL)) != 255)
    strcpy(extension[num-1]=malloc(strlen(buf)+1), lower(buf));
  num--;

  /* Build list of dependencies */

  for (c=0; c!=num; c++)
  {
    sprintf(buf, "<Diva$Dir>.PCBits.%s.Order", extension[c]);
    if (file_exists(buf))
    {
      fh = fopen(buf, "rb");
      while (!feof(fh))
      {
        fgets(buf, 256, fh);
        *strstr(lower(buf), "\n") = 0;
        for (c2=0; c2!=num; )
          if (strcmp(strstr(buf, " ")+1, extension[c2]) == NULL) break; else c2++;
        if (c2 != num && buf[0] != '#')
        {
          if (strncmp(buf, "load_before_me:", 15) == 0)
            before[c][before_next[c]++] = c2;
          else if (strncmp(buf, "load_after_me:", 14) == 0)
            before[c2][before_next[c2]++] = c;
          else if (strncmp(buf, "dont_load:", 10) == 0)
            done[c2] = 1, disabled++;
          else if (strncmp(buf, "load_in_preference:", 19) == 0)
            done[c] = 1, disabled++;
          else
          {
            sprintf(buf, "Set Diva$Error Bad 'Order' file inside '%s' extension", extension[c]);
            system(buf);
            exit(1);
          }
        }
        ungetc(fgetc(fh), fh); /* tickle EOF flag if we're nearly there */
      }
      fclose(fh);
    }
  }

  /* Order the list */

  c=0; while(c!=num) order_it(c++);

  /* Decide what we're meant to do with it */

  if (argc == 1)
    mode = MODE_STARTUP;
  else
  {
    if (!strcmp(lower(argv[1]), "-list"))     mode = MODE_LIST;
    if (!strcmp(lower(argv[1]), "-startup"))  mode = MODE_STARTUP;
    if (!strcmp(lower(argv[1]), "-shutdown")) mode = MODE_SHUTDOWN;
  }
  if (ctrl_down()) mode = MODE_SHUTDOWN;

  switch (mode)
  {
    case MODE_LIST:
      for (c=0; c!=(num-disabled); c++)
        if (order[c] != 255)
          printf("%d (%d): %s\n", c, order[c], extension[order[c]]);
      break;
    case MODE_STARTUP:
      start_wimp();
      for (c=0; c!=(num-disabled); c++)
      {
        sprintf(buf, "<Diva$Dir>.PCBits.%s.Startup", extension[order[c]]);
        /*printf("%s\n", buf);*/
        if (file_exists(buf))
          start_task(buf);
      }
      break;
    case MODE_SHUTDOWN:
      start_wimp();
      for (c=(num-disabled); c!=0; c--)
      {
        sprintf(buf, "<Diva$Dir>.PCBits.%s.Shutdown", extension[order[c]]);
        /*printf("%s\n", buf);*/
        if (file_exists(buf))
          start_task(buf);
      }
      break;
    default:
      fprintf(stderr, "Syntax: LoadAuto [-list | -startup | -shutdown]\n");
      exit(1);
  }

  return(0);
}
