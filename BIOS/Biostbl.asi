; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSTBL.ASI	ROM tables: Video parameters,
;		FD and HD tables
;
; Versions
; 0.1	24-11-91 INH	Original
;	13-03-92	Fonts moved to BIOSFont.ASI
;	27-10-92	VGA_PtrTbl1 added
;	24-02-93	VGA mode parameters added
;	19-07-93	Mode tables made accurate
;	22-10-93	DAC Entry 10h (Flight-Sim green) corrected
; 1.24	27-01-94	HD Parameters made correct. Xtd BIOS area present
; *****************************************************************


	; System Parameters table definition
	; This is a table pointed to by use of Int 15h function C0h
	; Phoenix BIOS has it at FE6F5; I don't think anyone relies
	; on this though.

	; Note: when PIC2 is present, IO.SYS seems to want to write
	; lots of crap to I/O port 672h. I don't know why, but this
	; access needs to be ignored by ARM if so.

SYSParams:	DB	08h, 00h	; Size of table (minimum=8)
		DB	0FCh, 00h	; Model=AT
		DB	00, 074h	; Bios revision = 00,
					; System parameters are:
					; PIC2, RTC, Int15 function 4Fh,
					; present;
					; extended BIOS data present

		DB	0, 0, 0, 0	; Reserved

; Hard disk parameters ******************************

HD_parms1:
	; Test HD: 17x5x977
		DW	977		; NCyls
		DB	5		; NHeads
		DB	0, 0		; Reserved
		DW	0		; Write Precomp
		DB	0		; Reserved
		DB	00h		; Control byte
		DB	0,0,0
		DW	0		; Landing zone
		DB	17		; NSects
		DB	0


HD_parms2:
	; Standard HD: 17x5x1024
		DW	1024		; NCyls
		DB	5		; NHeads
		DB	0, 0		; Reserved
		DW	0		; Write Precomp
		DB	0		; Reserved
		DB	00h		; Control byte
		DB	0,0,0
		DW	0		; Landing zone
		DB	17		; NSects
		DB	0

; Video Parameters ====================================================

; 6845 parameters for MDA or CGA video modes
 
VID_params:   
        DB      38h, 28h, 2dh, 0ah, 1fh, 6, 19h         ; 40x25
        DB      1ch, 2, 7, 6, 7
        DB      0, 0, 0, 0
                
        DB      71h, 50h, 5ah, 0ah, 1fh, 6, 19h         ; 80x25
        DB      1ch, 2, 7, 6, 7
        DB      0, 0, 0, 0
                
        DB      38h, 28h, 2dh, 0ah, 7fh, 6, 64h         ; graphics
        DB      70h, 2, 1, 6, 7
        DB      0, 0, 0, 0
                
        DB      61h, 50h, 52h, 0fh, 19h, 6, 19h         ; 80x25 B&W card
        DB      19h, 2, 0dh, 0bh, 0ch
        DB      0, 0, 0, 0
                
regen_lengths   DW      2048                            ; regen lengths
                DW      4096
                DW      16384
                DW      16384
        
cols_in_mode    DB      40, 40, 80, 80, 40, 40, 80, 80          ; cols
        
VID_modevals    DB      2Ch, 28h, 2Dh, 29h, 2Ah, 2Eh, 1Eh, 29h  ; mode sets
		DB	3, 3, 5, 5, 3, 3, 3, 4			; Don't know
VID_CGApals	DB	30h, 30h, 30h, 30h, 30h, 30h, 3Fh, 0FFh 


; VGA Tables ===========================================================

VGA_PtrTbl1	DW	VGA_ModeTbl, BIOSROMSeg		; Video param tbl
		DW	0, 0				; Dynamic Save Area
		DW	0, 0				; Text Aux Char Gen
		DW	0, 0				; Graphics Char Set
		DW	VGA_PtrTbl2, BIOSROMSeg		; 2nd pointer tbl
		DW	0, 0				; Reserved
		DW	0, 0				; Reserved

VGA_PtrTbl2	DW	01Ah				; Length
		DW	VGA_DCCTbl, BIOSROMSeg
		DW	0, 0				; 2nd Aux Char Gen
		DW	0, 0				; User Palette Profile
		DW	0, 0				; Reserved #5
		DW	0, 0				; Reserved #6
		DW	0, 0				; Reserved #7


VGA_DCCTbl	DB	10h, 01h, 08h, 00h		; Mumble frotz
		DB	00, 00, 00, 01, 00, 02, 02, 01
		DB	00, 04, 04, 01, 00, 05, 02, 05
		DB	00, 06, 01, 06, 05, 06, 00, 08
		DB	01, 08, 00, 07, 02, 07, 02, 06

; VGA Mode Tables ====================================================

; For each mode, these have the following format

;  nCols,nRows-1,CharHeight, PageSizeL, PageSizeH, SR1, SR2, SR3
;		SR4,MiscOp, CR0,  CR1,  CR2,  CR3,  CR4,  CR5,
;		CR6,  CR7,  CR8,  CR9,  CRA,  CRB,  CRC,  CRD,
;		CRE,  CRF,  CR10, CR11, CR12, CR13, CR14, CR15,
;		CR16, CR17, CR18, AR0,  AR1,  AR2,  AR3,  AR4,
;		AR5,  AR6,  AR7,  AR8,  AR9,  ARA,  ARB,  ARC,
;		ARD,  ARE,  ARF,  AR10, AR11, AR12, AR13, GR0,
;		GR1,  GR2,  GR3,  GR4,  GR5,  GR6,  GR7,  GR8

; For each mode number, the position of its corresponding entry in
; this array is looked up according to a variety of circumstances
; (no VGA, 200/350/400-line text modes) by the VID_ModeChange routine.
; The order of entries in this table must be correlated to entries
; in the VID_noVGAtbl/VID_400linetbl (etc) tables.
; 26/11/93 - Cleared AR10 bit 3 (blink) in colour text modes
VGA_ModeTbl:
 
; Mode 00/01h, 200-line
	DB	028h, 018h, 008h, 000h, 010h, 009h, 003h, 000h
	DB	002h, 063h, 02Dh, 027h, 028h, 090h, 02Bh, 0A0h
	DB	0BFh, 01Fh, 000h, 0C7h, 006h, 007h, 000h, 000h
	DB	000h, 000h, 09Ch, 0AEh, 08Fh, 014h, 01Fh, 096h
	DB	0B9h, 0A3h, 0FFh, 000h, 001h, 002h, 003h, 004h
	DB	005h, 014h, 007h, 010h, 011h, 012h, 013h, 014h
	DB	015h, 016h, 017h, 000h, 000h, 00Fh, 000h, 000h
	DB	000h, 000h, 000h, 000h, 010h, 00Eh, 000h, 0FFh
; Mode 00/01h, 200-line
