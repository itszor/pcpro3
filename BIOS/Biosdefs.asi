; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSDEFS.ASI  I/O definitions for ROM BIOS
;
; Versions
; 0.1   12-08-91 INH    Original
;       10-11-91 INH    CMOS RAM addresses have MSB set
;       11-11-91        IO_Kbd_Ack is at 064h
;       02-12-91        1st and second printer swapped
;       21-12-91        DMA, surplus SVC defs scrapped
;                       RTC addresses added
;       06-02-92        New Keyboard Controller: Port 64h is IO_Kbd_Cmd
;       13-02-92        Mouse ports
;       19-02-92        CMOS_vidcfg added
;       26-02-92        Keyboard shift-key definitions moved
;                       IOWAIT removed from XIN, XOUT etc.
;       11-03-92        New mouse definitions
;       13-03-92        New VGA register definitions
;       06-05-92        Mouse regs redefined
;       12-06-92        CMOS defs for 486
;       01-07-92        CMOS defs readjusted; rammap removed
;       30-10-92        (0.97) DMAREQ bits added
;       11-01-93        (1.04) DMAREQ bits removed; CMOS_disktype added
; 1.11  01-04-93        COM_ScratchReg added
; 1.15  19-05-93        PUSHAframe structure definition
; 1.21  26-08-93        LONGJMP macro
; 1.24  07-01-94        HD Port definitions
;       31-01-94        FD/DMA Port definitions
; 1.64  14-11-94        Suspend & Quit commands for ARM
;      27-02-1998 MB    VESA register numbers moved here
; 2.34 1998.09.08 W     HPC_DebugT port and single-task reuqest added
; *****************************************************************

; SCAMP Controller chip ******************************

IO_EMS_Index    EQU     0E8H
IO_EMS_Data     EQU     0EAH

IO_CFG_Index    EQU     0ECH
IO_CFG_Data     EQU     0EDH

IO_SYS_A20Gate  EQU     0EEH
IO_SYS_Reset    EQU     0EFH
IO_SYS_FastCPU  EQU     0F5H
IO_SYS_SlowCPU  EQU     0F4H

IO_MultiIO_Addr EQU     03F0h
IO_MultiIO_Data EQU     03F1h

; Floppy disk controller ***********************************

IO_FDD_MtrCtrl  EQU     03F2H   ; Diskette motor control latch
IO_FDD_DataRate EQU     03F7H
IO_FDD_Changed  EQU     03F7H   ; Changed bit is bit 7
IO_FDD_Status   EQU     03F4H
IO_FDD_Data     EQU     03F5H

; 8259 Interrupt controllers *******************************

IO_PIC1_Ctrl    EQU     020H
IO_PIC1_Mask    EQU     021H

IO_PIC2_Ctrl    EQU     0A0H
IO_PIC2_Mask    EQU     0A1H


; 8237 DMA controllers ************************************

IO_FDD_DmaAddr  EQU     004H
IO_FDD_DmaCount EQU     005H
IO_FDD_DmaPage  EQU     081H

IO_DMA1_Cmd     EQU     008H
IO_DMA1_Mask    EQU     00AH
IO_DMA1_Mode    EQU     00BH
IO_DMA1_ByteFF  EQU     00CH
IO_DMA1_Clr     EQU     00DH

IO_DMA2_Cmd     EQU     0D0H
IO_DMA2_Mode    EQU     0D6H
IO_DMA2_Clr     EQU     0DAH
IO_DMA2_Status  EQU     0D0H
IO_DMA2_Mask    EQU     0D4H
IO_DMA2_ByteFF  EQU     0D8H

; 8254 Timer ***********************************************

IO_PIT_Cmd      EQU     043H
IO_PIT_Tmr0     EQU     040H
IO_PIT_Tmr1     EQU     041H
IO_PIT_Tmr2     EQU     042H

; Video ****************************************************

IO_VGA_GraphRegs        EQU     03CEH
IO_VGA_SeqRegs          EQU     03C4H
IO_VGA_AttrRegs         EQU     03C0h

GR_SetRes       EQU     0
GR_SetResEn     EQU     1
GR_RdColourCmp  EQU     2
GR_OpRotate     EQU     3
GR_RdPlaneSel   EQU     4
GR_RWMode       EQU     5
GR_Misc         EQU     6
GR_RdDontCare   EQU     7
GR_BitMask      EQU     8

SR_CharMap      EQU     3
SR_PlaneEnable  EQU     2

; Real-Time-Clock/CMOS RAM *********************************

IO_CMOS_Index   EQU     070H
IO_CMOS_Data    EQU     071H

; RAM addresses

CMOS_sec        EQU     80h
CMOS_min        EQU     82h
CMOS_hour       EQU     84h
CMOS_date       EQU     87h
CMOS_month      EQU     88h
CMOS_year       EQU     89h
CMOS_updateRTC  EQU     8Ah
CMOS_century    EQU     0B2h

CMOS_disktype   EQU     90h
CMOS_equip      EQU     94h
CMOS_ramsizeL   EQU     95h
CMOS_ramsizeH   EQU     96H
CMOS_XtdSizeL   EQU     97H
CMOS_XtdSizeH   EQU     98H
CMOS_XtdSiz2L   EQU     0B0H            ; For reasons unknown, extended RAM
CMOS_XtdSiz2H   EQU     0B1H            ; size is kept in 2 places!

CMOS_iocfg      EQU     9Bh
CMOS_gencfg     EQU     9Ch
CMOS_ramcfg     EQU     9Dh
CMOS_dskcfg     EQU     9Eh

CMOS_HD0cylsL   EQU     09Fh
CMOS_HD0cylsH   EQU     0A0h
CMOS_HD0heads   EQU     0A1h
CMOS_HD0sects   EQU     0A2h
CMOS_HD1cylsL   EQU     0A3h
CMOS_HD1cylsH   EQU     0A4h
CMOS_HD1heads   EQU     0A5h
CMOS_HD1sects   EQU     0A6h

CMOS_IDETimer   EQU     0A7h

; Keyboard controller ****************************************

IO_KBD_Data     EQU     060H
IO_KBD_Cmd      EQU     064H

; Keyboard shift definitions

k_rsh           EQU     01H
k_lsh           EQU     02H
k_ctrl          EQU     04H
k_alt           EQU     08H
k_scrlock       EQU     10H
k_numlock       EQU     20H
k_capslock      EQU     40H
k_insert        EQU     80H


; Parallel port *********************************************

IO_LPT1_Base    EQU     0378H
IO_LPT2_Base    EQU     03BCH

LPT_Data        EQU     0H
LPT_Status      EQU     1H
LPT_Control     EQU     2H


; Serial port **********************************************

IO_COM1_Base    EQU     03F8H
IO_COM2_Base    EQU     02F8h

COM_Data        EQU     0H
COM_BaudGenLo   EQU     0H
COM_BaudGenHi   EQU     1H
COM_IntEnable   EQU     1H
COM_IntStatus   EQU     2H
COM_LineCtrl    EQU     3H
COM_ModemCtrl   EQU     4H
COM_LineStat    EQU     5H
COM_ModemStat   EQU     6H
COM_ScratchReg  EQU     7H

; IDE hard disk ports ***********************************

IO_HD_Data      EQU     01F0h
IO_HD_Error     EQU     01F1h
IO_HD_PreComp   EQU     01F1h
IO_HD_NSects    EQU     01F2h
IO_HD_Sector    EQU     01F3h
IO_HD_CylLSB    EQU     01F4h
IO_HD_CylMSB    EQU     01F5h
IO_HD_Select    EQU     01F6h
IO_HD_Cmd       EQU     01F7h
IO_HD_Status    EQU     01F7h
IO_HD_MiscCtrl  EQU     03F6h

; HPC command ports *************************************

HPC_Cmd_Port    equ 0300h   ; Byte only, write only
HPC_Status_Port equ 0300h   ; Byte only, read only
HPC_Req_Port    equ 0302h   ; Word only, read/write
HPC_DataA_Port  equ 0304h   ; Byte or word read/write
HPC_DataB_Port  equ 0306h   ; Byte or word read/write

HPC_DebugB_Port equ 0301h
HPC_DebugW_Port equ 0300h
HPC_DebugT_Port equ 0307h

HPC_IRQ_line    equ 15

; Commands written to command port

HPC_WRITE_IO	equ 00h		; About to write buffer via I/O
HPC_READ_IO	equ 10h		; About to read buffer via I/O
HPC_WRITE_MEM	equ 20h		; About to write shared-mem buffer
HPC_READ_MEM	equ 30h		; About to write shared-mem buffer
HPC_DO_CALL_NOINT equ 40h	; Do call, no int on completion
HPC_DO_CALL_INT	equ 50h		; Do call, generate int on completion
HPC_RELEASE_BUF	equ 60h		; End of call

HPC_RESET_ACK	equ 80h		; Reset ack
HPC_SUSPEND_ACK	equ 82h		; Acknowledge suspend mode
HPC_MULTI_REQ	equ 84h		; Request to go multitasking
HPC_QUIT_REQ	equ 86h		; Request to quit
HPC_FREEZE_REQ	equ 88h		; Request to freeze !PC
HPC_SINGLE_REQ  equ 8Ah         ; Request to single-task !PC

HPC_BUF_A	equ 0		; Indicates whether buffer A or buffer B
HPC_BUF_B	equ 1		; is in use.

	; Values read from status port

HPCST_SUSPEND	equ 80h		; 'Suspend' active
HPCST_REQUEST	equ 40h		; 'Request' active
HPCST_READY	equ 20h		; Ready to accept command

HPCST_LOCK_B	equ 02h		; Buffer B is busy
HPCST_LOCK_A	equ 01h		; Buffer A is busy


; MOUSE definitions *****************************************

IO_MOU_Ptr_X            EQU     0318h
IO_MOU_Ptr_Y            EQU     0319h
IO_MOU_Ptr_Data         EQU     031Ah
IO_MOU_Ptr_Cmd          EQU     031Bh

IO_MOU_Bus_Cmd          EQU     023Fh
IO_MOU_Bus_Select       EQU     023Eh
IO_MOU_Bus_Data         EQU     023Ch

	; Bit masks for possible mouse events

MOU_Mask_Move           EQU     001h
MOU_Mask_LPress         EQU     002h
MOU_Mask_LRelease       EQU     004h
MOU_Mask_RPress         EQU     008h
MOU_Mask_RRelease       EQU     010h

	; Bit mask for shift keys for alternate mouse handlers

MOU_Mask_Shift          EQU     020h
MOU_Mask_Ctrl           EQU     040h
MOU_Mask_Alt            EQU     080h

; SVGA definitions **********************************************

VESA_MODE_REQUEST equ	032h	; Used to set VESA modes, by writing a combination of
				; BPP_xxx and SIZ_xxx codes
VESA_MEM_SIZE	equ	033h	; Read only, VESA memory size in 64K chunks
VESA_MODE_CAPS	equ	034h	; Read only, MC_xxx capabilities flags
VESA_START_HI	equ	035h	; Bits 16..23 of display start address, in
				; conjunction with CRTC regs. Bits 0..1 will be
				; ignored as it must start on a dword boundary
VESA_WINA_PAGE	equ	036h	; Sets start address of window A in 64K chunks
VESA_DIRECT	equ	037h	; Set to 1 if we need direct screen access
VESA_DACWIDTH	equ	038h	; 6 or 8 output on mode changes
VESA_SCANLINE   equ     039h    ; Written to if application wants to be awkward
VESA_DISPSTART32  equ     03Ah	; Write 4 bytes to set display start addr.

; STRUCTURE DEFINITIONS *****************************************

PUSHAframe      STRUC
	SavedDI DW 0
	SavedSI DW 0
	SavedBP DW 0
	SavedSP DW 0
	SavedBX DW 0
	SavedDX DW 0
	SavedCX DW 0
	SavedAX DW 0

	;SavedGS DW 0	;
	SavedES DW 0    ; !These are not saved by PUSHA, but are in this
	SavedDS DW 0    ; position on the stack frame saved by video functions

	retIP   DW 0    ; Saved INT instruction
	retCS   DW 0
	retFlg  DW 0
	ENDS

CARRY_FLAG equ 1

PUSHABframe     STRUC
	_SvedDI DW 0
	_SvedSI DW 0
	_SvedBP DW 0
	_SvedSP DW 0
	SavedBL DB 0
	SavedBH DB 0
	SavedDL DB 0
	SavedDH DB 0
	SavedCL DB 0
	SavedCH DB 0
	SavedAL DB 0
	SavedAH DB 0
	ENDS

; Drive parameter table entry

DrvParmTbl      STRUC
	NCyls   DW      0
	NHeads  DB      0
	Rsrvd1  DB      0, 0
	PreComp DW      0
	Rsrvd2  DB      0
	CtlByte DB      0
	Rsrvd3  DB      0, 0, 0
	LandZne DW      0
	NSects  DB      0
	Rsrvd4  DB      0
	DrvType DB	0	; Drive type (my invention)
		ENDS

DRVTYPE_NONE equ 0
DRVTYPE_HPC  equ 1
DRVTYPE_IDE  equ 2

; Pointer block for HPC_ExecCall

HPC_CallParms	STRUC
Buff_flag	DW	0	; Buffer number (0=A, 1=B)
Send_Len_1	DW	0	; Data bytes sent (portion 1), length
Send_Ptr_1	DD	0	; Data bytes sent, pointer
Send_Len_2	DW	0
Send_Ptr_2	DD	0
Ret_Len_1	DW	0	; Data bytes to be returned (portion 1) length
Ret_Ptr_1	DD	0	; Data bytes returned, pointer to buffer
Ret_Len_2	DW	0
Ret_Ptr_2	DD	0
		ENDS

MyDword1	STRUC
byte0		DB	0
byte1		DB	0
byte2		DB	0
byte3		DB	0
		ENDS

MyDword2	STRUC
word0		DW	0
word1		DW	0
		ENDS

DwordPointer	STRUC
PtrOFS		DW	0
PtrSEG		DW	0
		ENDS

; MACRO DEFINITIONS *****************************************

IOWAIT  MACRO
	LOCAL   s1, s2
	JMP     short s1
s1:     JMP     short s2
s2:
	ENDM

XOUT    MACRO   Port, Data
	MOV  DX, Port
	MOV  AL, Data
	OUT  DX, AL
	ENDM

XIN     MACRO   Port
	MOV  DX, Port
	IN   AL, DX
	ENDM

XINW    MACRO   Port
	MOV  DX, Port
	IN   AX, DX
	ENDM

XOUTW   MACRO   Port, Data
	MOV  DX, Port
	MOV  AX, Data
	OUT  DX, AL
	ENDM

INBX    MACRO   val
	MOV     DX, BX
	ADD     DX, val
	IN      AL, DX
	ENDM

OUTBX   MACRO   val
	MOV     DX, BX
	ADD     DX, val
	OUT     DX, AL
	ENDM


RDCMOS  MACRO   addr
	MOV     AL, addr
	OUT     IO_CMOS_Index, AL
	IOWAIT
	IN      AL, IO_CMOS_Data
	ENDM

WRCMOS  MACRO   addr, data
	MOV     AL, addr
	OUT     IO_CMOS_Index, AL
	IOWAIT
	MOV     AL, data
	OUT     IO_CMOS_Data, AL
	ENDM


TraceB  MACRO val
	PUSH    AX
	PUSH    DX
	MOV     AL, val
	MOV     DX, HPC_DebugB_Port
	OUT     DX, AL
	POP     DX
	POP     AX
	ENDM

TraceW  MACRO val
	PUSH    AX
	PUSH    DX
	MOV     AX, val
	MOV     DX, HPC_DebugW_Port
	OUT     DX, AX
	POP     DX
	POP     AX
	ENDM

; Macro to define a far jump instruction

LONGJMP MACRO   segment, label
	DB      0EAh
	DW      label
	DW      segment
	ENDM



