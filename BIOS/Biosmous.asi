; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSMOUS.ASI	BIOS Mouse Handler
;
; Versions
; 0.1	13-02-92 INH	Original
;	26-02-92	New version with alternate handlers
;	11-03-92	Another new version using bus mouse ports
;       19-03-92	50-line mode problems 
;	08-07-92	Set limits properly on Init function
;	04-11-92	(NE Fix) Fn 05, 06h return button state in AL
;	24-02-93	(Boardmaker fix) don't touch 40:F0-F3
;	27-04-93	Reset mouse on Ctrl-Alt-Del
;	07-07-93	Separated from ARM side support
;	19-10-93	SVGA support added
;	06-12-93	(Turbo Pascal bug) corrected return values a lot
;	07-12-95	Disables pointer on mode change
; *****************************************************************

; SEGMENT USAGE:
;
; As of 27/1/94, the mouse data is stored in the extended BIOS data
; area at 9FC0h (BIOSXData), not at seg 0040h. The only routines which
; are called from the rest of the BIOS are MOU_Init and MOU_ModeChange.
; These MUST save and restore DS.
; All other routines assume DS is set up for the Xtd data segment.

	ASSUME	DS:BIOSXData

; Mode flags

	MODE_40COL	equ	1
	MODE_TEXT	equ	2

; Mouse Init Routine *************************************************

MOU_Init PROC NEAR
	XOUT	IO_MOU_Bus_Cmd, 011h	; Enable & reset mouse
	XOUT	IO_MOU_Bus_Select, 10h	; Disable interrupts
	RET

MOU_Init ENDP


; Mouse default handler ************************************************

MOU_DefHandler PROC FAR
	RET
MOU_DefHandler ENDP

; Mode Change routine **************************************************

; Called by VidBIOS AH=00 and AH=11, subfunctions 10-13h
; Must preserve all regs

MOU_ModeChange PROC NEAR
	PUSH	DS

	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData
	TEST	MOU_enabled, 1
	JZ	MMC_disabled

	MOV	DS, SYS_XDataSeg
	ASSUME	DS:BIOSXData

	PUSH	ES
	PUSH	AX
	PUSH	BX
	PUSH	CX
	PUSH	DX
	CALL	MOU_SetLimitsForMode
	CALL	MOU_SetDefaultPointer
	MOV	MOU_ShowCount, 0
	CALL	MOU_CheckPtrShowing
	POP	DX
	POP	CX
	POP	BX
	POP	AX
	POP	ES
MMC_disabled:
	POP	DS
	RET
MOU_ModeChange ENDP

; Subroutines for mouse BIOS calls and ISR ******************************

MOU_SetDefaultPointer PROC NEAR ; *********************

	MOV	AH, 6		; Code for 'Text Pointer'
	TEST	MOU_ModeFlags, MODE_TEXT
	JNZ	MSDP_Set
				; Otherwise, use graphics pointer.
	MOV	AH, 7
MSDP_Set:
	MOV	DX, IO_MOU_Ptr_Cmd
	MOV	AL, AH
	OUT	DX, AL
	RET

MOU_SetDefaultPointer ENDP

MOU_ConvertSpeedValue PROC NEAR ; ************************

	; Enter with AL = Mickeys per 8 pixels
	; Exit with  AL = Equivalent shift value
	; AH corrupted
	; 8 mickeys:8 pixels is a shift value of 7
	; 4 mickeys:8 pixels a value of 6, and so on.

	MOV	AH, 4
	JMP	short MOU_CSV2
MOU_CSV1:
	SHR	AL, 1
	INC	AH
MOU_CSV2:
	CMP	AL, 1
	JA	MOU_CSV1
	MOV	AL, AH
	RET

MOU_ConvertSpeedValue ENDP


MOU_SetLimitsForMode PROC NEAR ; **************************

; This sets the allowable X and Y limits for the current
; screen mode.
; Assume DS=BIOSXDataSeg, may corrupt AX-DX, ES

	MOV	ES, CS:DataSeg@
	ASSUME	ES:BIOSData

	; Work out screen mode ********

	MOV	MOU_ModeFlags, 0

	MOV	BL, ES:VID_mode		; Get current mode

	MOV	AX, 200			; If SVGA mode, 
	CMP	BL, 13h			; Y limit seems to be
	JA	M_SLM_Set		; always 200

	MOV	BH, 0			; VGA screen limits are
	SHL	BX, 1			; given in table:
	MOV	AX, CS:MOU_Ylimits[BX]	; 0 means it's a text mode
	CMP	AX, 0
	JNE	M_SLM_Set

	; Text mode *******

	OR	MOU_ModeFlags, MODE_TEXT

	MOV	AL, ES:VID_lastrow	; In text mode, limit is
	CBW				; always (no of rows)*8
	INC	AX
	SHL	AX, 3

	; Set limits & centre mouse ******
M_SLM_Set:
	DEC	AX
	MOV	[MOU_Ymax], AX		; Set Y limits
	INC	AX
	SHR	AX, 1
	MOV	[MOU_Ypos], AX		; Centralise pointer

	MOV	AX, ES:[VID_ncols]	; Get no of cols.
					; In all modes,
	CMP	AX, 40			; X limit is ncols*16
	JA	M_SLM_2			;  if ncols <= 40
	SHL	AX, 1			; otherwise it's
	OR	MOU_ModeFlags, MODE_40COL
M_SLM_2:				; ncols*8
	SHL	AX, 3
	DEC	AX
	MOV	[MOU_Xmax], AX		; Set limits to 'full-screen'
	INC	AX
	SHR	AX, 1
	MOV	[MOU_Xpos], AX		; Centralise pointer
	RET

MOU_SetLimitsForMode ENDP

	ASSUME	ES:NOTHING

MOU_Ylimits	DW	0,     0,   0,   0	; Y limits for modes 0-3
		DW	200, 200, 200,   0	; 4-7
		DW	200, 200, 200, 200	; 8-B (non-existant)
		DW	200, 200, 200, 350	; C-F
		DW	350, 480, 480, 200	; 10-13h

MOU_CheckPtrShowing PROC NEAR ; ***************************

	; Should be called when the status of the mouse pointer
	; (showing or not) has been changed.
	; Enter with DS = Mouse Data Segment
	; AX, DX corrupted

	CMP	[MOU_ShowCount], 1	; Pointer is showing if >= 1
	JGE	MOU_CPS1

	XOUT	IO_MOU_Ptr_Cmd, 2	; If not, send 'hide' command
	RET

MOU_CPS1:
	MOV	[MOU_ShowCount], 1	; Limit this value to 1
	XOUT	IO_MOU_Ptr_Cmd, 1	; Send 'show' command
	RET

MOU_CheckPtrShowing ENDP

MOU_UpdatePtrPos PROC NEAR ; ********************************************

 	; Resets the mouse X and Y positions to the values stored
	; in the BIOS RAM area - may be used after the limits have
	; been changed, for instance

	MOV	CX, [MOU_Xpos]		; Clip and set MOU_Xpos
	CMP	CX, [MOU_Xmin]
	JGE	MOU_UPX1
	MOV	CX, [MOU_Xmin]
MOU_UPX1:	
	CMP	CX, [MOU_Xmax]
	JLE	MOU_UPX2
	MOV	CX, [MOU_Xmax]
MOU_UPX2:	
	MOV	[MOU_Xpos], CX		; CX = X position

	MOV	BX, [MOU_Ypos]		; Clip and set MOU_Ypos
	CMP	BX, [MOU_Ymin]
	JGE	MOU_UPY1
	MOV	BX, [MOU_Ymin]
MOU_UPY1:	
	CMP	BX, [MOU_Ymax]
	JLE	MOU_UPY2
	MOV	BX, [MOU_Ymax]
MOU_UPY2:	
	MOV	[MOU_Ypos], BX		; BX = Y position

	; Convert to pixel position according to mode ************

	MOV	AL, MOU_ModeFlags
	TEST	AL, MODE_40COL
	JZ	MOU_UPP1		; Is it a 40-column mode
	SHR	CX, 1			; If so, X pixel pos = X/2
MOU_UPP1:

	TEST	AL, MODE_TEXT ; Is it a text mode?
	JZ	MOU_UPP3
	SHR	CX, 3			; If so, X = col. number
	SHR	BX, 3			; Y = row number
MOU_UPP3:

	; Send X position to mouse ****************

	MOV	DX, IO_MOU_Ptr_X
	MOV	AX, CX
	SHL	AX, 1			; Set AH = co-ord bits 7..14
	SHR	AL, 1			; AL = co-ord bits 0..6
	OUT	DX, AL			; Send LS bits to port

	MOV	AL, AH			; Send MS bits with bit 7 set
	OR	AL, 80h			; to port
	OUT	DX, AL

	; Send Y position to mouse ****************

	MOV	DX, IO_MOU_Ptr_Y
	MOV	AX, BX
	SHL	AX, 1			; Set AH = co-ord bits 7..14
	SHR	AL, 1			; AL = co-ord bits 0..6
	OUT	DX, AL			; Send LS bits to port

	MOV	AL, AH			; Send MS bits with bit 7 set
	OR	AL, 80h			; to port
	OUT	DX, AL

	MOV	DX, IO_MOU_Ptr_Cmd
	MOV	AL, 3			; Send 'update position' command
	OUT	DX, AL
	RET

MOU_UpdatePtrPos ENDP

MOU_GetXYNow PROC NEAR ; **********************************

	; This gets the current (X,Y) position into CX and DX
	; respectively - this value is adjusted for the current
	; video mode.

	MOV	CX, [MOU_Xpos]
	MOV	DX, [MOU_Ypos]
	MOV	AL, [MOU_ModeFlags]	; Get Mode flags
	TEST	AL, MODE_TEXT		; Text mode?
	JNZ	MOU_GXYN_Txt

	; Graphics mode adjustments --------

	TEST	AL, MODE_40COL		; > 40 col graphics mode?
	JZ	MOU_GXYN_1		; If so, leave unchanged
	AND	CX, 0FFFEh		; Else: X is on 2-pixel boundary
MOU_GXYN_1:
	RET

	; Text mode adjustments ------------
MOU_GXYN_Txt:
	AND	DX, 0FFF8h		; Y on 8-pixel boundary
	TEST	AL, MODE_40COL		; 40-col text mode?
	JNZ	MOU_GXYN_2		; if so, do 16-pixel X boundary
	AND	CX, 0FFF8h
	RET

MOU_GXYN_2:
	AND	CX, 0FFF0h		; if > 40 col, X is on
	RET				; 8-pixel boundary

MOU_GetXYNow ENDP


MOU_Reset PROC NEAR ; ---------------------------------------------
	; General reset-mouse call.
	; Call: assumes DS:XDataSeg
	; Trashes all regs except DS, BP

	PUSH	DS
	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData
	MOV	MOU_enabled, 1
	POP	DS
	ASSUME	DS:BIOSXData

	; (1) Reset mouse variables ************

	MOV	AX, DS
	MOV	ES, AX		; Point ES:DI at mouse variables

	MOV	AL, 0
	CLD
	MOV	DI, offset MOU_DataStart
	MOV	CX, MOU_DataLen
	REP	STOSB		; Clear all mouse variables to zero

	; (2) Set Default values *********************

	MOV	[MOU_XspeedShift], 7	; Set default speed
	MOV	[MOU_YspeedShift], 8
	MOV	[MOU_Xspeed], 8
	MOV	[MOU_Yspeed], 16

	CALL	MOU_SetLimitsForMode
	CALL	MOU_SetDefaultPointer

	; (3) Set interrupt vectors ***********

	MOV	AX, 0			; We use interrupt 3, which is
	MOV	ES, AX			; vector 0Bh

	CLI
	MOV	word ptr ES:[0Bh*4],   offset CS:MOU_Isr
	MOV	word ptr ES:[0Bh*4+2], CS

	IN	AL, IO_PIC1_Mask	; Mouse interrupt is INT 3
	AND	AL, 11110111b		; (same as COM2)
	OUT	IO_PIC1_Mask, AL	; Enable It
	STI
	
	; (4) Initialise hardware *************

	XOUT	IO_MOU_Bus_Cmd, 011h	; Mysterious bus mouse enable
	XOUT	IO_MOU_Bus_Select, 90h	; Clear counters & disable ints
	XOUT	IO_MOU_Bus_Select, 0h	; Re-enable ints & run counters

	; (5) Update position on screen *******

	CALL	MOU_UpdatePtrPos
	CALL	MOU_CheckPtrShowing

	RET

MOU_Reset ENDP


; Mouse BIOS call *****************************************************

MOU_Int PROC FAR
	STI
	PUSH	DS
	PUSH	ES

	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData
	MOV	DS, SYS_XDataSeg
	ASSUME	DS:BIOSXData

	PUSHA
	MOV	BP, SP

	CMP	AX, 024h
	JA	MB_Exit

	MOV	SI, AX
	ADD	SI, SI
	JMP	CS:MOU_BIOS_Dispatch[SI]

MB_Exit:	; May get here with seg regs corrupted!
	POPA
	POP	ES
	POP	DS
	IRET

MOU_Int     ENDP


	; BIOS dispatch routines ***************************

	; Entered with AX, BX, CX, DX, ES = original values
	; on entry to the call.
	; BP points to a saved stack

MB_Reset:		; Function 00h *******************
	CALL	MOU_Reset
	MOV	[BP].SavedAX, 0FFFFh
	MOV	[BP].SavedBX, 2
	JMP	MB_Exit

MB_ShowMouse:		; Function 01h *******************
	INC	[MOU_ShowCount]
	CALL	MOU_CheckPtrShowing
	JMP	MB_Exit

MB_HideMouse:		; Function 02h *******************
	DEC	[MOU_ShowCount]
	CALL	MOU_CheckPtrShowing
	JMP	MB_Exit

MB_GetStatus:		; Function 03h *******************
	MOV	AL, [MOU_Buttons]	
	CBW
	MOV	[BP].SavedBX, AX
	CALL	MOU_GetXYNow
	MOV	[BP].SavedCX, CX
	MOV	[BP].SavedDX, DX
	JMP	MB_Exit

MB_MovePointer:		; Function 04h *******************
	MOV	[MOU_Xpos], CX
	MOV	[MOU_Ypos], DX
	CALL	MOU_UpdatePtrPos
	JMP	MB_Exit

MB_GetPresses:		; Function 05h *******************

	MOV	SI, offset DS:MOU_LPressCount	; If BL=0, get L press
	CMP	BL, 0				; information
	JE	MB_DoPressRelease
	MOV	SI, offset DS:MOU_RPressCount	; If BL=1, get R press
	JMP	MB_DoPressRelease		; information

MB_GetReleases:		; Function 06h *******************

	MOV	SI, offset DS:MOU_LRlseCount	; If BL=0, get L release
	CMP	BL, 0				; information
	JE	MB_DoPressRelease
	MOV	SI, offset DS:MOU_RRlseCount	; If BL=1, get R releases

MB_DoPressRelease:
	MOV	AX, 0				; BX = no. of times
	XCHG	AL, [SI]			; press/release has occurred
	MOV	[BP].SavedBX, AX
	MOV	AX, [SI+1]			; CX = X coord of event
	MOV	[BP].SavedCX, AX
	MOV	AX, [SI+3]			; DX = Y coord of event
	MOV	[BP].SavedDX, AX
	MOV	AL, MOU_Buttons
	MOV	[BP].SavedAL, AL
	JMP	MB_Exit


MB_SetXlimits:		; Function 07h *******************

	CMP	DX, CX				; DX = max X
	JAE	MB_SX1				; CX = min X
	XCHG	CX, DX				; if reversed, swap
MB_SX1: MOV	[MOU_Xmin], CX
	MOV	[MOU_Xmax], DX
	CALL	MOU_UpdatePtrPos		; Clip to new limits
	JMP	MB_Exit

MB_SetYlimits:		; Function 08h *******************
	CMP	DX, CX				; DX = max Y
	JAE	MB_SY1				; CX = min Y
	XCHG	CX, DX				; if reversed, swap
MB_SY1: MOV	[MOU_Ymin], CX
	MOV	[MOU_Ymax], DX
	CALL	MOU_UpdatePtrPos		; Clip to new limits
	JMP	MB_Exit

MB_SetGraphPtr:		; Function 09h *******************

	TEST	MOU_ModeFlags, MODE_TEXT	; Is it a text mode?
	JNZ	MB_SGP_X			; If so, ignore call

	; ES:DX is a pointer to 64 bytes of 'shape' info
	; BX = X hot spot
	; CX = Y hot spot

	MOV	SI, DX

	MOV	DX, IO_MOU_Ptr_Cmd		; Command 04h =
	MOV	AL, 04h				; Start pointer shape data
	OUT	DX, AL

	MOV	DX, IO_MOU_Ptr_Data
	MOV	AL, BL				; Send X and Y hot spots
	OUT	DX, AL				; LSB first
	MOV	AL, BH
	OUT	DX, AL
	MOV	AL, CL
	OUT	DX, AL
	MOV	AL, CH
	OUT 	DX, AL	

	MOV	CX, 64				
	CLD
	MOV	AX, ES
	MOV	DS, AX
						; Send 64 bytes of pointer
	REP     OUTSB				; shape data

	MOV	DX, IO_MOU_Ptr_Cmd		; Command 05h = set new
	MOV	AL, 05h				; pointer data
	OUT	DX, AL

MB_SGP_X:
	JMP	MB_Exit

MB_SetTextPtr:		; Function 0Ah *******************
	TEST	MOU_ModeFlags, MODE_TEXT	; Is it a text mode?
	JZ	MB_STP_2			; If not, ignore

	; We ignore the precise details of the text cursor

	MOV	DX, IO_MOU_Ptr_Cmd
	MOV	AL, 06h				; Command 6 = set text ptr
	OUT	DX, AL
MB_STP_2:
	JMP	MB_Exit

MB_GetMotion:		; Function 0Bh *******************

	MOV	CX, 0				; Get and reset X and Y
	MOV	DX, 0				; motion counters
	XCHG	CX, [MOU_Xmotion]		; CX = X
	XCHG	DX, [MOU_Ymotion]		; DX = Y
	MOV	[BP].SavedCX, CX
	MOV	[BP].SavedDX, DX
	JMP	MB_Exit

MB_SetHandler:		; Function 0Ch *******************

	; CX = Mask, ES = Segment, DX = offset of mouse event handler
	; These values go in the last entry in the table of handlers;
	; this one is called last, if no other 'alternate' handlers
	; have picked it up.

	AND	CX, 01Fh			; No Centre button events
	CLI
	MOV	MOU_HandlerMask[6], CX
	MOV	MOU_HandlerSeg[6],  ES
	MOV	MOU_HandlerOfs[6],  DX
	STI
	JMP	MB_Exit

MB_SetSpeed:		; Function 0Fh *******************

	; CX = Mickeys per 8 pixels in X direction
	; DX=  Mickeys per 8 pixels in Y direction

	MOV	[MOU_Xspeed], CX
	MOV	[MOU_Yspeed], DX

	MOV	AX, CX
	CALL	MOU_ConvertSpeedValue
	MOV	[MOU_XspeedShift], AL

	MOV	AX, DX
	CALL	MOU_ConvertSpeedValue
	MOV	[MOU_YspeedShift], AL

	JMP	MB_Exit
	
MB_SetDblSpeed:		; Function 13h *******************

	MOV	[MOU_DblSpeedVal], DX
	JMP	MB_Exit

MB_XchgHandler:		; Function 14h *******************

	; CX = Mask, ES = Segment, DX = offset of mouse event handler
	; These values go in the last entry in the table of handlers;
	; this one is called last, if no other 'alternate' handlers
	; have picked it up.

	AND	CX, 01Fh			; No Centre button events
	MOV	AX, ES

	CLI
	XCHG	MOU_HandlerMask[6], CX
	XCHG	MOU_HandlerOfs[6],  DX
	XCHG	MOU_HandlerSeg[6],  AX
	STI

	MOV	[BP].SavedCX, CX
	MOV	[BP].SavedDX, DX
	MOV	[BP].SavedES, AX
	JMP	MB_Exit

MB_GetSaveSize:		; Function 15h *******************

	MOV	AX, MOU_DataLen
	OR	AX, 1
	INC	AX			; Round up for safety!
	MOV	[BP].SavedBX, AX
	JMP	MB_Exit

MB_SaveState:		; Function 16h *******************

	; ES:DX point to a buffer in which the current mouse system state
	; has to be saved

	CLD
	MOV	DI, DX

	MOV	SI, offset DS:MOU_DataStart	; Move mouse data
	MOV	CX, MOU_DataLen
	REP	MOVSB

	JMP	MB_Exit


MB_RestoreState:	; Function 17h *******************

	; ES:DX point to a buffer from which the mouse system state has to
	; be restored

	CLD

	MOV	AX, ES				; Exchange DS (BIOSXdata seg)
	MOV	BX, DS				; with ES (Source for data)
	MOV	DS, AX
	MOV	ES, BX

	MOV	SI, DX

	MOV	DI, offset MOU_DataStart
	MOV	CX, MOU_DataLen
	REP	MOVSB				; Copy back the data

	MOV	DS, BX				; Get back our own data seg.

	CALL	MOU_CheckPtrShowing		; Redisplay pointer
	CALL	MOU_UpdatePtrPos		; & reposition it

	JMP	MB_Exit

MB_SetAltHandler:	; Function 18h *******************

	; Enter with CX = Alternate event mask
	;  ES:DX = pointer to event routine
	; There are 3 slots for 'alternate' event handlers. A slot
	;  is free if its event mask is zero. Alternatively, if the
	;  event mask of the new routine in CX already matches that
	;  of one of the slots, that slot can be re-used. The three
	;  slots correspond to offsets 0, 2, and 4 in the MOU_Handler
	;  arrays.

	MOV	SI, 0				; Check 1st slot

MB_SAH1:
	CMP	MOU_HandlerMask[SI], CX		; Can we re-use slot?
	JE	MB_SAH3
	ADD	SI, 2				; Do slots 2 and 4
	CMP	SI, 4
	JBE	MB_SAH1

	MOV	SI, 0
MB_SAH2:
	CMP	MOU_HandlerMask[SI], 0		; Is slot free?
	JE	MB_SAH3
	ADD	SI, 2				; Try slots 2 and 4
	CMP	SI, 4
	JBE	MB_SAH2
						; If not, we have failed
	MOV	[BP].SavedAX, 0FFFFh		; return AX=0FFFFh
	JMP	MB_Exit

MB_SAH3:					; Found slot - install handler
	CLI
	MOV	MOU_HandlerMask[SI], CX
	MOV	MOU_HandlerSeg[SI],  ES
	MOV	MOU_HandlerOfs[SI],  DX
	STI

	JMP	MB_Exit

MB_GetAltHandler:	; Function 19h *******************

	; Attempts to find the address of the event handler whose
	; event mask is specified in CX

	MOV	SI, 0

MB_GAH1:
	CMP	MOU_HandlerMask[SI], CX		; Is it this one?
	JE	MB_GAH2
	ADD	SI, 2
	CMP	SI, 6				; This tries all 3 slots
	JBE	MB_GAH1				; (may not be correct)

	MOV	AX, 0
	MOV	[BP].SavedCX, AX		; If not, we have failed
	MOV	[BP].SavedDX, AX		; return CX = 0 and DX = 0

	JMP	MB_Exit

MB_GAH2:					; If found, put pointer
	MOV	AX, MOU_HandlerOfs[SI]		; into ES:DX
	MOV	[BP].SavedDX, AX
	MOV	AX, MOU_HandlerSeg[SI]
	MOV	[BP].SavedES, AX
	JMP	MB_Exit


MB_SetSpeed2:		; Function 1Ah *******************

	MOV	[MOU_DblSpeedVal], DX
	MOV	[MOU_Xspeed], BX
	MOV	[MOU_Yspeed], CX

	MOV	AX, BX
	CALL	MOU_ConvertSpeedValue
	MOV	[MOU_XspeedShift], AL

	MOV	AX, CX
	CALL	MOU_ConvertSpeedValue
	MOV	[MOU_YspeedShift], AL

	JMP	MB_Exit

MB_GetSpeed2:		; Function 1Bh *******************

	MOV	DX, [MOU_DblSpeedVal]
	MOV	[BP].SavedDX, AX
	MOV	AX, [MOU_Xspeed]
	MOV	[BP].SavedBX, AX
	MOV	AX, [MOU_Yspeed]
	MOV	[BP].SavedCX, AX
	JMP	MB_Exit

MB_SetPtrPage:		; Function 1Dh *******************
	MOV	[MOU_PtrPage], BL
	JMP	MB_Exit

MB_GetPtrPage:		; Function 1Eh *******************
	MOV	AL, [MOU_PtrPage]
	CBW
	MOV	[BP].SavedBX, AX
	JMP	MB_Exit

MB_DeInstall:		; Function 1Fh *******************

	IN	AL, IO_PIC1_Mask	; Mouse interrupt is INT 3
	OR	AL, 00001000b		; (same as COM2)
	OUT	IO_PIC1_Mask, AL	; Disable It

	MOV	[BP].SavedES, CS	; Return pointer to INT 33h
	MOV	[BP].SavedBX, offset CS:MOU_Int	; routine in ES:BX

	PUSH	DS
	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData
	MOV	MOU_enabled, 0
	POP	DS
	ASSUME  DS:BIOSXData
	JMP	MB_Exit

MB_ReInstall:		; Function 20h *******************

	CALL	MOU_Reset	; Not strictly accurate!!
	JMP	MB_Exit		; should not reset s/w configuration


MB_Reset2:		; Function 21h *******************

	CALL	MOU_Reset	; In theory, should not re-init mouse
	MOV	[BP].SavedAX, 0FFFFh
	MOV	[BP].SavedBX, 2
	JMP	MB_Exit

MB_GetType:		; Function 24h *******************

	MOV	[BP].SavedBX, 0102h	; Mouse version 1.02

	MOV	[BP].SavedCX, 0103h	; Bus mouse (01) using IRQ 3

	JMP	MB_Exit

	; BIOS Dispatch table *********************************

MOU_BIOS_Dispatch	DW	MB_Reset	; Fn 00h
			DW	MB_ShowMouse	; Fn 01h
			DW	MB_HideMouse	; Fn 02h
			DW	MB_GetStatus	; Fn 03h
			DW	MB_MovePointer	; Fn 04h
			DW	MB_GetPresses	; Fn 05h
			DW	MB_GetReleases	; Fn 06h
			DW	MB_SetXlimits	; Fn 07h
			DW	MB_SetYlimits	; Fn 08h
			DW	MB_SetGraphPtr	; Fn 09h 
			DW	MB_Exit		; Fn 0Ah !!Set Text Pointer
			DW	MB_GetMotion	; Fn 0Bh
			DW      MB_SetHandler	; Fn 0Ch
			DW	MB_Exit		; Fn 0Dh !!Light Pen on
			DW	MB_Exit		; Fn 0Eh !!Light Pen off
			DW	MB_SetSpeed	; Fn 0Fh
			DW	MB_Exit		; Fn 10h
			DW	MB_Exit		; Fn 11h
			DW	MB_Exit		; Fn 12h
			DW	MB_SetDblSpeed	; Fn 13h
			DW      MB_XchgHandler	; Fn 14h
			DW	MB_GetSaveSize	; Fn 15h
			DW	MB_SaveState	; Fn 16h
			DW	MB_RestoreState	; Fn 17h
			DW	MB_SetAltHandler; Fn 18h
			DW	MB_GetAltHandler; Fn 19h
			DW	MB_SetSpeed2	; Fn 1Ah
			DW	MB_GetSpeed2	; Fn 1Bh
			DW	MB_Exit		; Fn 1Ch
			DW	MB_SetPtrPage	; Fn 1Dh
			DW	MB_GetPtrPage	; Fn 1Eh
			DW	MB_DeInstall	; Fn 1Fh
			DW	MB_ReInstall	; Fn 20h
			DW	MB_Reset2	; Fn 21h
			DW	MB_Exit		; Fn 22h
			DW	MB_Exit		; Fn 23h
			DW	MB_GetType	; Fn 24h




; Subroutines for mouse interrupt service routine *********************


MOU_CheckHandlerSI PROC NEAR  ; ************************************

	; This is called with SI pointing to a mouse event handler, and
	; AH holding the event bits. It checks to see if this handler is
	; suitable for the event.

	; (SI=0, 2, 4, 6 for event handlers 0 to 3 )

	; It returns with carry set if the handler is not suitable
	; otherwise carry is clear.
	; DS must be Mouse Data Segment
	; Corrupts AL, BX. Must preserve CX, DX

	MOV	BX, MOU_HandlerMask[SI]		; Get handler mask
	TEST	BL, AH				; Does it match event (move/
	JZ	MOU_CH_Fail			; button up/down etc)
						; If not, fail

	AND	BL, 11100000b			; Get shift-key bits
	JZ	MOU_CH_CheckAddr		; Zero means 'don't care'

	; Check shift key status against mask

	MOV	ES, CS:DataSeg@
	ASSUME	ES:BIOSData
	MOV	AL, ES:KBD_shifts		; bit 0..3 are 1 if lshift,
						; rshift, ctrl and alt
	ASSUME  ES:Nothing			; (respectively) are pressed

	MOV	BH, AL
	AND	BL, 1
	SHL	BL, 1
	OR	AL, BH
	SHL	AL, 4				; Set AL(5) = 1 if shift
	AND	AL, 11100000b			; AL(6) = 1 if ctrl pressed
						; AL(7) = 1 if alt pressed
	CMP	AL, BL
	JNE	MOU_CH_Fail			; Does it match?

MOU_CH_CheckAddr:
	MOV	BX, MOU_HandlerSeg[SI]		; Finally, is the pointer
	OR	BX, MOU_HandlerOfs[SI]		; null?
	JZ	MOU_CH_Fail			; If so, don't use it

	CLC
	RET

MOU_CH_Fail:
	STC
	RET

MOU_CheckHandlerSI	ENDP


MOU_DoHandlerSI  PROC FAR  ; ****************************************

	; MOU_DoHandlerSI sets up the registers and calls the mouse
	; handler pointed to by SI; SI is 0, 2, 4 or 6 for handlers 
	; 0 to 3. AH contains the current event bits. The handler
	; routine itself wants to be far CALLed; it should preserve all
	; regs although in practice this is not relied on.

	; DoHandlerSI is a FAR routine itself; at the end we
	; do a far jump to the handler by misusing a far RET instruction.
	
	; On entry AH=event bits, CX = X pos, DX = Y pos

	PUSH	MOU_HandlerSeg[SI]	; Push address of event handler
	PUSH	MOU_HandlerOfs[SI]	; routine onto the stack

	MOV	AL, AH				; Put AX = event bits
	MOV	AH, 0

	MOV	BL, [MOU_Buttons]	; Get buttons into BX
	MOV	BH, 0

	MOV	SI, [MOU_Xmotion]
	MOV	DI, [MOU_Ymotion]

	RET	; This is a jump to the mouse event handler

MOU_DoHandlerSI	ENDP



; Mouse Interrupt Service routine **************************************

MOU_Isr	PROC FAR
	STI

	PUSH	DS
	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData
	MOV	DS, SYS_XDataSeg
	ASSUME	DS:BIOSXData

	PUSH	ES

	PUSHA

	; Read X and Y motion counter values **************

	XOUT	IO_MOU_Bus_Select, 090H		; Selects X LS 4 bits
	XIN	IO_MOU_Bus_Data
	AND	AL, 0Fh
	MOV	BH, AL
	XOUT	IO_MOU_Bus_Select, 0B0H		; Selects X MS 4 bits
	XIN	IO_MOU_Bus_Data
	SHL	AL, 4
	OR	BH, AL				; Put X value into BH

	XOUT	IO_MOU_Bus_Select, 0D0H		; Selects Y LS 4 bits
	XIN	IO_MOU_Bus_Data
	AND	AL, 0Fh
	MOV	BL, AL
	XOUT	IO_MOU_Bus_Select, 0F0H		; Selects Y MS 4 bits
	XIN	IO_MOU_Bus_Data
	SHL	AL, 4
	OR	BL, AL				; Put Y value into BL

	MOV	AH, 0
	CMP	BX, 0				; Is both X and Y motion
	JE	MOU_Isr_NoMotion		; zero?

	; Process X and Y motion values **************************

	MOV	AL, BH
	CBW
	ADD	[MOU_Xmotion], AX

	MOV	AL, BL
	CBW
	ADD	[MOU_Ymotion], AX


	; Update X and Y positions *******************************

	MOV	AH, BH
	MOV	AL, 0

	MOV	CL, [MOU_XspeedShift]		; Convert X motion into
	SAR	AX, CL				; motion in pixels
	ADD	[MOU_Xpos],AX			; Get new X position

	MOV	AH, BL
	MOV	AL, 0

	MOV	CL, [MOU_YspeedShift]		; Convert X motion into
	SAR	AX, CL				; motion in pixels
	ADD	[MOU_Ypos], AX			; Get new X position

	CALL	MOU_UpdatePtrPos		; Update pointer position

	; Check for events ***********************************

	; We will be accumulating event bits in AH

	MOV	AH, MOU_Mask_Move		; If moved, set move event bit
MOU_Isr_NoMotion:				; else arrive here with BX = 0

	XIN	IO_MOU_Bus_Data			; AL bit 7 = L button
						;    bit 5 = R button

	PUSH	AX
	CALL	MOU_GetXYNow			; Get CX = X position
	POP	AX				;     DX = Y position

	MOV	BL, [MOU_Buttons]

	; Left button actions ***********************

	; AL holds raw button state
	; BL = stored Mouse Button state
	; CX = current X position
	; DX = current Y position

	TEST	AL, 80h				; If bit is zero,
	JZ	MOU_Isr_LeftDown		; left button is down..

	TEST	BL, 1				; Else, left button is up
	JZ	MOU_Isr_TestL1			; If we knew this already,
						; ignore.
	OR	AH, MOU_Mask_LRelease		; If this is new, flag event
	AND	BL, 0FEh

	INC	MOU_LRlseCount
	MOV	MOU_LRlseX, CX
	MOV	MOU_LRlseY, DX
	JMP	MOU_Isr_TestL1

MOU_Isr_LeftDown:
	TEST	BL, 1				; If we knew already, its
	JNZ	MOU_Isr_TestL1			; not an event

	OR	AH, MOU_Mask_LPress		; If this is new, flag event
	OR	BL, 1
	INC	MOU_LPressCount
	MOV	MOU_LPressX, CX
	MOV	MOU_LPressY, DX
MOU_Isr_TestL1:

	; Right button actions ***********************

	TEST	AL, 20h				; If bit is zero,
	JZ	MOU_Isr_RightDown		; right button is down..

	TEST	BL, 2				; Else, right button is up
	JZ	MOU_Isr_TestR1			; If we knew this already,
						; ignore.

	OR	AH, MOU_Mask_RRelease		; If this is new, flag event
	AND	BL, 0FDh
	INC	MOU_RRlseCount
	MOV	MOU_RRlseX, CX
	MOV	MOU_RRlseY, DX
	JMP	MOU_Isr_TestR1

MOU_Isr_RightDown:
	TEST	BL, 2				; If we knew already, its
	JNZ	MOU_Isr_TestR1			; not an event

	OR	AH, MOU_Mask_RPress		; If this is new, flag event
	OR	BL, 2
	INC	MOU_RPressCount
	MOV	MOU_RPRessX, CX
	MOV	MOU_RPressY, DX

MOU_Isr_TestR1:

	MOV	MOU_Buttons, BL

	; Check if any event handlers want action ***********************

	; At this point, AH holds a mask of events which have
	; occurred, CX = X position, DX = Y position.
        ; We check to see if there are any mouse-event
	; handlers want calling.

	MOV	SI, 0				; Try first handler
MOU_Isr_FH1:
	CALL	MOU_CheckHandlerSI		; Is is usable
	JNC	MOU_Isr_DoIt			; Carry clear if so
	ADD	SI, 2				; Check next handler
	CMP	SI, 6				; SI = 0, 2, 4 or 6
	JBE	MOU_Isr_FH1			; If none found, ignore!
	JMP	MOU_Isr_Exit

MOU_Isr_DoIt:
	CALL	MOU_DoHandlerSI			; SI = handler block
						; AH = event mask
						; CX = X, DX = Y
	
	; Acknowledge and exit ****************************************

MOU_Isr_Exit:

	MOV	AL, 20h			; EOI to 8259
	OUT	IO_PIC1_Ctrl, AL
	XOUT	IO_MOU_Bus_Select, 0	; Acknowledge interrupt to ARM
	POPA
	POP	ES
	POP	DS
	IRET

MOU_Isr ENDP


	; End of mouse code; revert to normal data seg ASSUME

	ASSUME	DS:BIOSData


