; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSHPC.ASI   Code for HPC communications with ARM, replaces
;		BIOSSVC.ASI
;
; Versions
; 2.00	15-Aug-95 INH	Started
;       30-Oct-95 INH	Made into proper BIOS
;
; *****************************************************************

	.386

; Some local definitions ================================

MEMCPY	MACRO	tmpreg			; MOVS using DWORDs if poss, which
	LOCAL	L10, L20		; also copes with CX = 0.

	MOV	tmpreg, CL		; BH [0..1] holds extra bytes, 0-3
	SHR	CX, 2
	JZ	L10
	REP	MOVSD			; Do whole dwords first
L10:
	MOV	CX, 3
	AND	CL, tmpreg		; Get back extra byte count
	JZ	L20
	REP	MOVSB			; Do them
L20:
	ENDM

	; ---------------

CPYOUT	MACRO	tmpreg			; Copies bytes or words out to port
	LOCAL	L10, L20
	MOV	tmpreg, CL		; BH [0] holds extra byte, 0 or 1

	SHR	CX, 1			; Convert to whole words
	JZ	L10
	REP	OUTSW			; Do whole words first
L10:

	AND	tmpreg, 1		; Any odd byte to do?
	JZ	L20
	OUTSB				; Do it
L20:
	ENDM

	; ---------------

CPYIN	MACRO	tmpreg			; Copies bytes or words in from port
	LOCAL	L10, L20
	MOV	tmpreg, CL		; BH [0] holds extra byte, 0 or 1

	SHR	CX, 1			; Convert to whole words
	JZ	L10
	REP	INSW			; Do whole words first
L10:

	AND	tmpreg, 1		; Any odd byte to do?
	JZ	L20
	INSB				; Do it
L20:
	ENDM


; HPC_Init routine ***********************************************

; Initialises the HPC system, installs interrupts, etc
;
; On entry and exit, DS=Data seg, stack must be valid

	.errnz	(HPC_IRQ_line-15)

PIC1MASK	EQU	11111011b	; Assume HPC_IRQ_line is 15
PIC2MASK	EQU	01111111b	; Assume HPC_IRQ_line is 15


HPC_Init        PROC NEAR

	; Install HPC interrupt -----------------------------------------

	; BIOSSYS will have set interrupt service address

	; Enable IRQ 15
	CLI

	IN	AL, IO_PIC1_Mask
	AND	AL, PIC1MASK		; Ensure IRQ 2 is enabled
	OUT	IO_PIC1_Mask, AL

	IOWAIT

	IN	AL, IO_PIC2_Mask
	AND	AL, PIC2MASK
	OUT	IO_PIC2_Mask, AL	; Ensure IRQ 15 enabled

	STI

	; Now get system info (shared-memory addresses, etc) -------------

	CALL	HPC_QuickSetup		; Set up ES:DI->cmd buffer,
					;  ES:BX->CallBlock params
					;  DS = data seg, clears D

	MOV	AX, 0			; Force it to use I/O ports
	MOV	[HPC_MemSegA], AX	; until we know we can use
	MOV	[HPC_MemSegB], AX	; shared memory

	; Set up command block for SYSinfo command

					; ES:DI->cmd block
	MOV	AX, 0			; Command = 0000:0000
	STOSW				; (system info command)
	STOSW

	MOV	ES:[BX].Send_Len_1, 4	; 4 bytes sent
	MOV	ES:[BX].Ret_Len_1, 16	; 16 bytes returned
	MOV	ES:[BX].Buff_flag, HPC_BUF_A	; Buffer A

	CALL	HPC_ExecCall		; Do the call
	JC	HPCI_exit		; If error, exit

	LES	DI, ES:[BX].Ret_Ptr_1	; Get back ES:DI->results

	MOV	EAX, ES:[DI+8]		; Get EAX = buffer A physical address
	CMP	EAX, 100000h		; Is it over 1 meg limit?
	JAE	HPCI_10
	SHR	EAX, 4			; If not, convert to seg address
	MOV	[HPC_MemSegA], AX	; & store it
HPCI_10:
	MOV	EAX, ES:[DI+12]		; Get EAX = buffer B physical address
	CMP	EAX, 100000h		; Is it over 1 meg limit?
	JAE	HPCI_20
	SHR	EAX, 4			; If not, convert to seg address
	MOV	[HPC_MemSegB], AX	; & store it
HPCI_20:

HPCI_exit:
	RET

HPC_Init        ENDP

; HPC_Isr routine ********************************************

; This services the interrupt from the ARM, which may signal
; a variety of conditions.


HPC_Isr	PROC	FAR
	PUSH	AX			; Avoid excessive stack use
	PUSH	DX
	PUSH	DS

	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData
        ASSUME  ES:nothing

	.errnz	(HPC_IRQ_line-15)
	MOV	AL, 20h			; Acknowledge the interrupt
	OUT	IO_PIC2_Ctrl, AL
	IOWAIT
	OUT	IO_PIC1_Ctrl, AL
	IOWAIT

	MOV	DX, HPC_Status_Port
	IN	AL, DX
	MOV	HPC_Status, AL	; Keep RAM copy up to date

	TEST	AL, HPCST_SUSPEND	; Suspend requested?
	JNZ	HPI_Suspend		; If so, do it now

HPI_Exit:
	POP	DS
	POP	DX
	POP	AX
	IRET


HPI_Suspend:
	; An interrupt has happened with the 'suspend' bit set.
	; we should put the machine into a holding state and send
	; acknowledgement to the ARM. We should then wait until
	; another interrupt comes along to end the suspend state.
	PUSH	CX			; Use CX as storage

	IN	AL, IO_PIC1_Mask	; Save old int state in AH
	MOV	CL, AL
	IN	AL, IO_PIC2_Mask
	MOV	CH, AL

	IOWAIT

	MOV	AL, PIC2MASK		; Enable only the HPC
	OUT	IO_PIC2_Mask, AL	; interrupt
	MOV	AL, PIC1MASK
	OUT	IO_PIC1_Mask, AL

	MOV	AL, 013h		; SLPCTL register
	OUT	IO_CFG_Index, AL
	IOWAIT
	IN	AL, IO_CFG_Data
	OR	AL, 10000000b		; Set sleep mode on SCAMP controller
	IOWAIT				; (pre-Gemini cards only)
	OUT	IO_CFG_Data, AL

	STI				; Allow HPC interrupts back

	XOUT	HPC_Cmd_Port, HPC_SUSPEND_ACK ; Do this as absolutely the last thing
					; Cures Windows barfing in Mtask mode.

 	HLT				; Wait for interrupt

HPI_WaitLoop:
	TEST	HPC_Status, HPCST_SUSPEND	; Suspend still needed?
	JNZ	HPI_WaitLoop		; Wait here if so

	MOV	AL, CH
	OUT	IO_PIC2_Mask, AL
	MOV	AL, CL			; Restore interrupt status
	OUT	IO_PIC1_Mask, AL

	POP	CX
	JMP	HPI_Exit

HPC_Isr	ENDP


; Quick setup procedure =================================
;
; Sets up
;  DS = Data seg
;  ES:BX->call block
;  ES:DI->buffer for parameters sent
;  Corrupts AX (CX,DX,SI,BP unchanged)
; The call block is set for all lengths zero, buffer A
; Clears D flag

HPC_QuickSetup proc near
	CLD
	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData
	MOV	ES, [SYS_XDataSeg]
	ASSUME	ES:BIOSXData
	MOV	DI, offset ES:HPC_CmdBuf	; ES:DI->Cmd buffer
	MOV	BX, offset ES:HPC_CallBlock	; Parameters table

	MOV	ES:[BX].Send_Ptr_1.PtrOFS, DI	; Set CallBlock bits
	MOV	ES:[BX].Send_Ptr_1.PtrSEG, ES
	MOV	ES:[BX].Ret_Ptr_1.PtrOFS, offset ES:HPC_ResBuf
	MOV	ES:[BX].Ret_Ptr_1.PtrSEG, ES
	MOV	AX, 0
	MOV	ES:[BX].buff_flag, AX
	MOV	ES:[BX].Send_Len_1, AX
	MOV	ES:[BX].Ret_Len_1, AX
	MOV	ES:[BX].Send_Len_2, AX
	MOV	ES:[BX].Ret_Len_2, AX
	RET
HPC_QuickSetup endp

; HPC_ExecCall & related routines **************************************

; On entry here,
;
; ES:BX -> HPC_CallParms structure
;
; On exit,
; AX is zero and carry clear if it's OK
; AX non-zero and carry set if there's an error:
;
;   0001 = timeout (not currently implemented)
;   0002 = bad 'length' fields
;
; ES, BX, DS, BP preserved
;
; Enables interrupts, of necessity

HPC_ExecCall proc near
	STI

	PUSH	BP
	PUSH	DS
	PUSH	ES
	PUSH	FS			; Whee! Using F segment!

	MOV	DS, CS:DataSeg@
	ASSUME	DS:BIOSData

	MOV	AX, ES
	MOV	FS, AX
	MOV	BP, BX			; FS:BP->parm block

	MOV	BX, FS:[BP].Buff_flag
	.errnz	HPC_BUF_B-1		; Routine depends on this a lot
	.errnz	HPC_BUF_A

	CLD				; Avoid funnies

	MOV	AX, FS:[BP].Send_Len_1	; Check sent lengths
	ADD	AX, FS:[BP].Send_Len_2
	JC	HPCX_TooLong		; > 64K?
	CMP	AX, 16384
	JA	HPCX_TooLong

	MOV	AX, FS:[BP].Ret_Len_1	; Check return lengths
	ADD	AX, FS:[BP].Ret_Len_2
	JC	HPCX_TooLong		; > 64K?
	CMP	AX, 16384
	JBE	HPCX_10			; If OK, carry on
HPCX_TooLong:
	MOV	AX, 0002h		; Bad 'length' field
	STC
	JMP	HPCX_Exit
HPCX_10:



HPCX_Wait:
	XIN	HPC_Status_Port		; Get ARM status
	MOV	[HPC_Status], AL	; Keep RAM copy up to date

	TEST	AL, HPCST_READY		; Wait for ARM to indicate it's
	JZ	HPCX_Wait		; ready for a command

	; Send parameters: is shared memory available?

	MOV	AX, [HPC_MemSegA]
	AND	BL, 1			; Ensure buff_flag 0 or 1
	JZ	HPCX_20
	MOV	AX, [HPC_MemSegB]
HPCX_20:
	CMP	AX, 0
	JE	HPCX_UsePorts		; Seg address will be 0 if no
					; shared memory is available

	; Send via shared memory

	MOV	ES, AX
	MOV	DI, 0			; ES:DI->shared memory buffer

	MOV	DX, HPC_Cmd_Port
	MOV	AL, HPC_WRITE_MEM	; Notify ARM of shared memory use
	OR	AL, BL			; add in buffer A/B bit
	OUT	DX, AL

	MOV	CX, FS:[BP].Send_Len_1	; CX = data length
	LDS	SI, FS:[BP].Send_Ptr_1	; DS:SI = data pointer

	MEMCPY	bh

	MOV	CX, FS:[BP].Send_Len_2
	LDS	SI, FS:[BP].Send_Ptr_2

	MEMCPY	bh

	; Now get ARM to exec command

	CALL	HPC_Do_n_Wait		; Preserves ES = shared mem seg

	; Retrieve results

	MOV	AX, ES
	MOV	DS, AX
	MOV	SI, 0			; DS:SI = shared memory params returned

	MOV	DX, HPC_Cmd_Port
	MOV	AL, HPC_READ_MEM	; About to read shared memory cmd
	OR	AL, BL			; add in buffer A/B bit
	OUT	DX, AL

	MOV	CX, FS:[BP].Ret_Len_1	; Get part 1
	LES	DI, FS:[BP].Ret_Ptr_1

	MEMCPY	bh

	MOV	CX, FS:[BP].Ret_Len_2	; Get part 2
	LES	DI, FS:[BP].Ret_Ptr_2

	MEMCPY	bh

	jmp	HPCX_FinishUp

	; I/O port bit ----------------------------------

HPCX_UsePorts:
	; FS:BP->param block
	; BL = 0 or 1 (buffer A or B)

	MOV	DX, HPC_Cmd_Port
	MOV	AL, HPC_WRITE_IO	; Tell the ARM we're about to write I/O
	OR	AL, BL			; add in buffer A/B bit
	OUT	DX, AL

	MOV	DX, HPC_DataA_Port	; Get appropriate port number
	ADD	DL, BL			;
	ADD	DL, BL
	.errnz	HPC_DataB_Port-HPC_DataA_Port-2

	; Send data to port

	MOV	CX, FS:[BP].Send_Len_1	; CX = data length
	LDS	SI, FS:[BP].Send_Ptr_1	; DS:SI = data pointer

	CPYOUT	bh

	MOV	CX, FS:[BP].Send_Len_2	; CX = data length, part 2
	LDS	SI, FS:[BP].Send_Ptr_2	; DS:SI = data pointer, part 2

	CPYOUT	bh

	; Do command

	CALL	HPC_Do_n_Wait

	; Retrieve results

	MOV	DX, HPC_Cmd_Port
	MOV	AL, HPC_READ_IO		; Tell the ARM we're about to read I/O
	OR	AL, BL			; add in buffer A/B bit
	OUT	DX, AL

	MOV	DX, HPC_DataA_Port	; Get appropriate port number
	ADD	DL, BL
	ADD	DL, BL
	.errnz	HPC_DataB_Port-HPC_DataA_Port-2

	MOV	CX, FS:[BP].Ret_Len_1	; CX = data length
	LES	DI, FS:[BP].Ret_Ptr_1	; DS:SI = data pointer

	CPYIN	bh

	MOV	CX, FS:[BP].Ret_Len_2	; CX = data length, part 2
	LES	DI, FS:[BP].Ret_Ptr_2	; DS:SI = data pointer, part 2

	CPYIN	bh
	; All done (nearly)

HPCX_FinishUp:
	MOV	DX, HPC_Cmd_Port
	MOV	AL, HPC_RELEASE_BUF	; Tell the ARM we've finished with buf
	OR	AL, BL			; add in buffer A/B bit
	OUT	DX, AL

	MOV	AX, 0			; Return value (always success)
	CLC
HPCX_Exit:
	MOV	BX, BP			; Restore BX
	POP	FS
	POP	ES			; Restore ES
	POP	DS
	POP	BP
	RET


HPC_ExecCall endp


; HPC_Do_n_Wait ------------------------

HPC_Do_n_Wait proc near
	; Enter with BL = 0 or 1
	; Starts the ARM executing a command & waits for it to complete
	; BL is preserved on exit
	; DS gets set to Data seg
	; Must preserve ES!

	MOV	DS, CS:DataSeg@
	ASSUME  DS:BIOSData
	ASSUME  ES:nothing

	MOV	DX, HPC_Cmd_Port
	MOV	AL, HPC_DO_CALL_INT	; Do call, generate Int on completion
	OR	AL, BL			; add in buffer A/B bit
	.errnz	HPC_BUF_B-1
	.errnz	HPC_BUF_A
	OUT	DX, AL			; Send ARM off on call

	IOWAIT

	; Use a polled approach. The ARM will suspend us if this is
	; inconvenient.

HPCDW_Wait:
	MOV	DX, HPC_Status_Port
	IN	AL, DX
	MOV	HPC_Status, AL		; Get & save status

	TEST	AL, HPCST_READY		; Wait for ready bit to come back
	JZ	HPCDW_Wait
	RET
HPC_Do_n_Wait endp



; HPC User Services -----------------------------

HPC_UserInt proc far
	STI

	; This is currently at Int 4DH, as documented in the HPC spec.
	; On entry:
	;   AX = 0000h - Identify HPC services
	;	returns AX = 4850h if HPC present
	;
	;   AX = 0001h - Do HPC call
	;
	; ES:BX->HPC_CallParms structure
	; returns AX = 0 if OK, non zero if failed.

	CMP	AX, 0000h
	JE	HPC_UI_Identify
	CMP	AX, 0001h
	JE	HPC_UI_Execute
	MOV	AX, 0FFFFh
	IRET

HPC_UI_Identify:
	MOV	AX, 4850h
	IRET

HPC_UI_Execute:
	PUSH	CX
	PUSH	DX
	PUSH	SI
	PUSH	DI		; ExecCall will preserve DS, ES
	CALL	HPC_ExecCall	; BP, BX
	POP	DI
	POP	SI		; AX contains return value
	POP	DX
	POP	CX
	IRET

HPC_UserInt endp
	.286




