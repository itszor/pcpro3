; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSSVGA.ASI  SuperVGA BIOS support
;
; 1.22  18-10-93 INH    Original
; 2.01  15-05-96        Full VESA 1.2 bits
; 2.15  1997.10.21 W    VESA 2.0 started
;       1998.03.18 MB   VESA 2.0 finished
;
; This now has a reasonably comprehensive set of packed-pixel modes.
; The only things I'm not sure about are:
;  - Whether people expect any of the base VGA registers to still work
;  - Whether we can ignore the "Set Logical Line Length" bit
;  - Whether we can avoid having to write BIOS TTY text output functions
;  - How granular the 'display memory start' pointer needs to be, and
;      whether people will expect it to wrap.
;
;
; This doesn't currently support 4-bpp flat frame buffer modes - neither
; do any of my reference SVGA cards, so I'm ignoring this for now.
; *****************************************************************
;
; MB: I've implemented the Set Logical Line Length call by cheating; it
; resizes the mode to fit the requested scan line length.  Other things
; changed by VESA 2.0 are a few more modes added for particular favourite
; games and the PMI function 0xA implemented.  I don't think we do need
; to bother with text output in VESA modes; we've got away with it so far.
;
 .386 ; Bollocks to everything-- I wanna use another segment register

LocalMode       STRUC           ; Local mode-information structure
lmBIOSMode      db      0       ; equivalent BIOS mode
lmVESAMode      dw      0       ; VESA mode number
lmSizeCode      db      0       ; Display resolution code, SIZ_xxx
lmWidth         dw      0       ; Pixels across
lmHeight        dw      0       ; Pixels high
lmBPPCode       db      0       ; Bits-per-pixel code, BPP_xxx
lmByteShift     db      0       ; 0=8bpp, 1=16bpp, 2=32bpp
lmBytesPerLine  dw      0       ; Bytes per scan line in memory
LocalMode       ENDS

BPP_VGA         equ     0       ; Means it's a VGA-compatibility mode
BPP_4           equ     10h     ; 4bpp packed-pixel mode (not used!)
BPP_8           equ     20h     ; 8bpp packed-pixel mode
BPP_16          equ     30h     ; 16bpp 5:5:5 high colour mode
BPP_24          equ     40h     ; 24bpp 8:8:8 true colour mode

SIZ_320x200     equ     0
SIZ_640x400     equ     1
SIZ_640x480     equ     2
SIZ_800x600     equ     3
SIZ_1024x768    equ     4
SIZ_1280x1024   equ     5
SIZ_320x240     equ     6
SIZ_320x400     equ     7

; Mode capabilities flags
MC_REAL_PAL     equ     1       ; ARM is capable of real 8bpp palette
MC_8BPP         equ     2       ; ARM is capable of 8bpp modes
MC_16BPP        equ     4       ; ARM is capable of 16bpp modes
MC_24BPP        equ     8       ; ARM is capable of 24bpp modes

; VESA Data Structures ---------------------------

VbeInfoBlock    struc
VbeSignature    dd 0
VbeVersion      dw 0
OemStringPtrOfs dd 0
Capabilities    dd 0
ModeListPtrOfs  dw 0
ModeListPtrSeg  dw 0
TotalMemory     dw 0            ; Amount of installed memory in 64K blks
;VBE 2.0 added fields
OemSoftwareRev  dw 0
OemVendorNamePtr dd 0
OemProductNamePtr dd 0
OemProductRevPtr dd 0
Reserved        db 222 dup (0)     ; area for modelist+scratch
Oemdata         db 256 dup (0)     ; area for OEM strings
VbeInfoBlock    ends

ModeInfoBlock   struc
ModeAttributes  dw      0
WinAAttributes  db      0
WinBAttributes  db      0
WinGranularity  dw      0
WinSize         dw      0
WinASegment     dw      0
WinBSegment     dw      0
WinFuncPtr      dd      0
BytesPerScanLine dw     0
; VBE 1.2 added fields
XResolution     dw      0
YResolution     dw      0
XCharSize       db      0
YCharSize       db      0
NumberOfPlanes  db      0
BitsPerPixel    db      0
NumberOfBanks   db      0
MemoryModel     db      0
BankSize        db      0
NumberOfImagePages db   0
Reserved000     db      0
; Fields for Direct Colour modes
RedMaskSize     db      0
RedFieldPosition db     0
GreenMaskSize   db      0
GreenFieldPosition db   0
BlueMaskSize    db      0
BlueFieldPosition db    0
RsvdMaskSize    db      0
RsvdFieldPosition db    0
DirectColorModeInfo db  0
; VBE 2.0 added fields
PhysBasePtr     dd      0
OffScreenMemOffset dd   0
OffScreenMemSize dw     0
Reserved001     db      206 dup (0)
ModeInfoBlock   ends

; Our mode tables ----------------------------------------------
;
; When updating this, don't forget to change the list of mode numbers
; at SVGA_ModeList

SVGA_LocalModeTbl:
        LocalMode <40h, 100h, SIZ_640x400,  640, 400,  BPP_8, 0, 640>
        LocalMode <41h, 101h, SIZ_640x480,  640, 480,  BPP_8, 0, 640>
        LocalMode <42h, 103h, SIZ_800x600,  800, 600,  BPP_8, 0, 800>
        LocalMode <43h, 105h, SIZ_1024x768, 1024,768,  BPP_8, 0, 1024>
        LocalMode <44h, 107h, SIZ_1280x1024,1280,1024, BPP_8, 0, 1280>

        LocalMode <45h, 10Dh, SIZ_320x200,  320, 200,  BPP_16,1, 640>
        LocalMode <46h, 110h, SIZ_640x480,  640, 480,  BPP_16,1, 1280>
        LocalMode <47h, 113h, SIZ_800x600,  800, 600,  BPP_16,1, 1600>
        LocalMode <48h, 116h, SIZ_1024x768, 1024,768,  BPP_16,1, 2048>
        LocalMode <49h, 119h, SIZ_1280x1024,1280,1024, BPP_16,1, 2560>

        LocalMode <4Ah, 10Fh, SIZ_320x200,  320, 200,  BPP_24,2, 1280>
        LocalMode <4Bh, 112h, SIZ_640x480,  640, 480,  BPP_24,2, 2560>
        LocalMode <4Ch, 115h, SIZ_800x600,  800, 600,  BPP_24,2, 3200>
        LocalMode <4Dh, 118h, SIZ_1024x768, 1024,768,  BPP_24,2, 4096>
        LocalMode <4Eh, 11Bh, SIZ_1280x1024,1280,1024, BPP_24,2, 5120>

        ; Homebrew modes go here
        LocalMode <4Fh, 11Ch, SIZ_320x240, 320, 240, BPP_8,0, 320>
        LocalMode <50h, 11Dh, SIZ_320x400, 320, 400, BPP_8,0, 320>
	LocalMode <51h, 11Eh, SIZ_320x200, 320, 200, BPP_8,0, 320>

        ; This is used for 800x600 16-colour VGA mode
        LocalMode <6Ah, 102h, SIZ_800x600,  800, 600,  BPP_VGA,2, 100>

        ; Special VBE2 mode to give access to whole video memory
        LocalMode <9Fh, 81FFh, SIZ_800x600,  800, 600,  BPP_24, 2, 100>

        DB      0FFh            ; End of table

; SVGA_GetPtrForMode ----------------------------------------------

; Given a mode number in AX, returns a pointer in CS:SI to a
; LocalMode structure defining it. Returns carry set if error.

SVGA_GetPtrForMode proc near
        AND     AX, 01FFh               ; Reduce to mode number
        MOV     SI, offset CS:SVGA_LocalModeTbl
SVGA_GPM_10:
        CMP     AX, CS:[SI].lmVESAMode
        JE      SVGA_GPM_20
        ADD     SI, size LocalMode
        CMP     CS:[SI].lmBIOSMode, 0FFh
        JNE     SVGA_GPM_10
        STC
        RET
SVGA_GPM_20:
        CLC
        RET
SVGA_GetPtrForMode endp

; SVGA_GetBIOSmodePtr -------------------------------------
;
; Enter with AL = BIOS mode number
; exit with carry clear, CS:SI = mode structure, if successful
; Preserves AL

SVGA_GetBIOSmodePtr proc near
        MOV     SI, offset CS:SVGA_LocalModeTbl
SVGA_GBM_10:
        CMP     AL, CS:[SI].lmBIOSMode  ; Have we got it?
        JE      SVGA_GBM_20
        ADD     SI, size LocalMode
        CMP     CS:[SI].lmBIOSMode, 0FFh ; Are there more modes?
        JNE     SVGA_GBM_10             ; Loop if so
        STC
        RET
SVGA_GBM_20:
        CLC
        RET
SVGA_GetBIOSmodePtr endp

; INT 10h entry point -----------------------------------------

        ; SVGA_Int is jumped to by the INT 10h servicing routine
        ; when AH=4Fh. All registers & stack are as they were
        ; upon entering the INT routine
SVGA_Int:
        STI
        PUSH    DS
        PUSH    ES
;	PUSH	GS
        PUSHA

        MOV     DS, CS:DataSeg@
        MOV     BP, SP
        PUSH    AX
        MOV     AX, BIOSXDataSeg
        MOV     GS, AX
        POP     AX
        ASSUME  GS:BIOSXData

;        TRACEB  55h
;        TRACEW  AX
;        TRACEW  BX
;        TRACEW  CX
;        TRACEW  DX
;        TRACEW  ES
;        TRACEW  DI

        CMP     AL, 0Ah         ; Only support functions 00-0Ah
        JA      SVGA_NotSupExit ; otherwise exit with 'not supported'
        MOV     AH, 0
        MOV     SI, AX
        ADD     SI, SI
        JMP     CS:SVGA_Dispatch[SI]

SVGA_ErrExit:
        MOV     [BP].SavedAX, 014Fh
        JMP     short SVGA_Exit
SVGA_NotSupExit:
        MOV     [BP].SavedAX, 0201h
        JMP     short SVGA_Exit
SVGA_OKExit:
;	CMP	[BP].SavedAX, 4F01h
;	JNE	no_mode_dump
;	MOV	ES, [BP].SavedES
;	MOV	DI, [BP].SavedDI
;	MOV	CX, size ModeInfoBlock
;mode_dump_loop:
;	TRACEW	ES:[DI]
;	ADD	DI, 2
;	LOOP	mode_dump_loop
;no_mode_dump:
        MOV     [BP].SavedAX, 004Fh
SVGA_Exit:
        POPA
        POP     ES
        POP     DS
;        TRACEB  0AAh
;        TRACEW  AX
;        TRACEW  BX
;        TRACEW  CX
;        TRACEW  DX
;        TRACEW  ES
;        TRACEW  DI
        IRET

SVGA_Dispatch   DW      SVGA_Inquire            ; 00
                DW      SVGA_GetModeInfo        ; 01
                DW      SVGA_SetMode            ; 02
                DW      SVGA_GetMode            ; 03
                DW      SVGA_SaveState          ; 04
                DW      SVGA_SetGetPage         ; 05
                DW      SVGA_SetGetScanLength   ; 06
                DW      SVGA_SetGetDisplayStart ; 07
                DW      SVGA_SetGetDACFormat    ; 08
                DW      SVGA_SetGetPalette      ; 09
                DW      SVGA_ReturnPMI          ; 0A (VBE2)

; Dispatch routines --------------------------------

; On entry to these, DS = BIOS data seg, CS = BIOS Code seg
; AX, BX, CX, DX, ES, DI are as on entry
; BP points to saved register structure on the stack.
; BP must be preserved. All others don't.

; SVGA_Inquire -------------------------------------
;
; Function 4F00h: Return SVGA information
;
; ES:DI points to buffer for return info

SVGA_Inquire:
        PUSH    DS
        MOV     AX, CS
        MOV     DS, AX

        MOV     SI, offset SVGA_StatInfo12 ; First assume 1.2 info requested
        MOV     CX, SVGA_StatInfo12_end - SVGA_StatInfo12
        MOV     DX, 256

        CMP     word ptr ES:[DI], 4256h ; 'VB'
        JNE     SVGA_Inquire_VBE12
	;CMP	word ptr ES:[DI]+2, 3245 ; 'E2'
	;JNE	SVGA_Inquire_VBE12	; This oughtn't happen...
        MOV     CX, SVGA_StatInfo20_end - SVGA_StatInfo20
        MOV     SI, offset SVGA_StatInfo20
        MOV     DX, 512
SVGA_Inquire_VBE12:

        ; Copy static data
        CLD
        REP     MOVSW
        POP     DS

        ; Fill in the rest with blanks
        ;MOV    CX, DX
        ;MOV    AX, 0
        ;REP    STOSW

        CALL    SVGA_GetMemSize         ; Gets video RAM size into DX:AX
        MOV     DI, [BP].SavedDI
        MOV     ES:[DI].TotalMemory, DX ; DX = number of 64K chunks

        JMP     SVGA_OKExit
SVGA_StatInfo12 DB      "VESA"
                DW      0102h           ; SVGA ver 1.2
                DW      SVGA_OEMString  ; Pointer to Vendor Info
                DW      BIOSROMSeg
                DD      1            ; Capabilities (VGA-based, 6/8bit DAC)
                DW      SVGA_ModeList
                DW      BIOSROMSeg
                DW      0               ; Memory size / 64K
SVGA_StatInfo12_end:

SVGA_StatInfo20 DB      "VESA"
                DW      0200h           ; SVGA ver 2.0
                DW      SVGA_VendorInfo ; Pointer to Vendor Info
                DW      BIOSROMSeg
                DD      1            ; Capabilities (VGA-based, 6/8bit DAC)
                DW      SVGA_ModeList
                DW      BIOSROMSeg
                DW      0               ; Memory size / 64K
                DW      0223h           ; OEMSoftware revision
                DW      SVGA_VendorInfo ; Pointer to Vendor Info
                DW      BIOSROMSeg
                DW      SVGA_Product    ; Product string
                DW      BIOSROMSeg
                DW      SVGA_ProdRev    ; product revision string
                DW      BIOSROMSeg
SVGA_StatInfo20_end:
                ; needs 222+256 bytes blank on the end...

SVGA_ModeList:
                DW      100h, 101h, 102h, 103h, 105h, 107h
                DW      10Dh, 10Fh, 110h, 112h, 113h, 115h
                DW      116h, 118h, 119h, 11Bh, 11Ch, 11Dh
		DW	11Eh

                DW      81FFh ; Special mode

                DW      0FFFFh  ; End of list

SVGA_VendorInfo DB      "Aleph One Ltd.", 0

SVGA_Product    DB      "PC Card VESA BIOS", 0

SVGA_ProdRev    DB      "v2.15",0

SVGA_OEMString  DB      "VESA BIOS (C)1993-1998 Aleph One Ltd.", 0

; SVGA_GetModeInfo -------------------------------------


; On entry, CX is an SVGA mode number and ES:DI point to
; a buffer. Information on the SVGA mode is put into this
; buffer.
;SVGA_ModeAttributes	DW 00011010b ; page 15 of VBE spec. doc

SVGA_GetModeInfo:
        MOV     AX, CX
        CALL    SVGA_GetPtrForMode
        JNC     SVGA_GMI_05
        JMP     SVGA_ErrExit

        ; Default attributes are: mode-not-supported, no-BIOS-TTY, colour,
        ;  graphics, VGA-compatible, windowed-memory-mode available,
        ;  linear frame buffer available. We amend the 'not supported' bit
        ;  later.
SVGA_GMI_05:
	MOV	AX, 10011010b
	MOV     ES:[DI].ModeAttributes, AX
        CALL    SVGA_CheckModeLegal
        JC      SVGA_GMI_10
        OR      ES:[DI].ModeAttributes, 1       ; Mode can be displayed
SVGA_GMI_10:

        MOV     ES:[DI].WinAAttributes, 111b    ; Relocatable read/write window
        MOV     ES:[DI].WinBAttributes, 0       ; No Window B for now
        MOV     ES:[DI].WinGranularity, 64      ; Amount by which window can be moved
        MOV     ES:[DI].WinSize, 64             ; Window size in K
        MOV     ES:[DI].WinASegment, 0A000h     ; Window A at A000h
        MOV     ES:[DI].WinBSegment, 0          ; No Window B for now
        MOV     ES:[DI].WinBSegment, 0          ; No Window B for now
        MOV     ES:[DI].WinFuncPtr.PtrOFS, offset CS:SVGA_PageFunction
        MOV     ES:[DI].WinFuncPtr.PtrSEG, CS

        MOV     AX, CS:[SI].lmWidth             ; Width in pixels
        MOV     ES:[DI].XResolution, AX
        MOV     AX, CS:[SI].lmBytesPerLine      ; Width in pixels
        MOV     ES:[DI].BytesPerScanLine, AX

        MOV     AX, CS:[SI].lmHeight            ; Height in pixels
        MOV     ES:[DI].YResolution, AX

        MOV     AL, 8                           ; Chars are always 8x8
        MOV     ES:[DI].XCharSize, AL           ; (not that we draw any!)
        MOV     ES:[DI].YCharSize, AL

        MOV     ES:[DI].NumberOfBanks, 1

        MOV     AX, 0
        MOV     ES:[DI].BankSize, AL
        MOV     ES:[DI].NumberOfImagePages, AL
        MOV     ES:[DI].Reserved000, 1

        ;extra bits for VBE v2.0

        MOV     EAX, 0
        MOV     AL, 41h		; Get VRAM size
        OUT     IO_CFG_Index, AL
        IN      AL, IO_CFG_Data
        SHL     EAX, 20
	MOV	EBX, EAX	; EBX = size of VRAM
	CMP	EBX, 0
	JNE	SVGA_GMI_VRAM_present

	MOV	ES:[DI].OffScreenMemOffset, 0
	MOV	ES:[DI].OffScreenMemSize, 0
	MOV	ES:[DI].PhysBasePtr, 0
	MOV	AX, ES:[DI].ModeAttributes
	AND	AX, 7Fh	; clear linear framebuffer supported bit
	MOV	ES:[DI].ModeAttributes, AX
	JMP	SVGA_GMI_VRAM_done
SVGA_GMI_VRAM_present:

	MOV	EAX, 0
	MOV	AX, ES:[DI].BytesPerScanLine
	MUL	ES:[DI].YResolution	; EAX = size of screen mode (bytes)
	MOV	ES:[DI].OffScreenMemOffset, EAX
	MOV	ECX, EAX
	;TRACEW	CX
	;SHR	ECX, 16
	;TRACEW	CX

	SUB	EBX, EAX
	SHR	EBX, 10
	MOV	ES:[DI].OffScreenMemSize, BX
	;TRACEW	BX

        MOV     EAX, 0
        MOV     AL, 40h
        OUT     IO_CFG_Index, AL
        IN      AL, IO_CFG_Data
        SHL     EAX, 20         ; Convert Mb to bytes
        MOV     ES:[DI].PhysBasePtr, EAX

SVGA_GMI_VRAM_done:
        ; Fill in fields based on colour type

        MOV     AL, CS:[SI].lmBPPCode
        CMP     AL, BPP_VGA
        JE      SVGA_GMI_VGA

        MOV     ES:[DI].NumberOfPlanes, 1

        MOV     CL, CS:[SI].lmByteShift         ; Log2 of bytes per pixel, 0-2
        MOV     AX, 8
        SHL     AX, CL
        MOV     ES:[DI].BitsPerPixel, AL        ; Range 8..32

        CMP     AL, 16
        JE      SVGA_GMI_Direct16
        CMP     AL, 32
        JE      SVGA_GMI_Direct24

        ; Normal 4bpp or 8bpp packed-pixel modes

        MOV     ES:[DI].MemoryModel, 4          ; Packed pixel mode
        JMP     SVGA_OKExit

SVGA_GMI_VGA:
        MOV     ES:[DI].BitsPerPixel, 4
        MOV     ES:[DI].NumberOfPlanes, 4
        MOV     ES:[DI].MemoryModel, 3          ; Planar VGA
        OR      ES:[DI].ModeAttributes, 100b    ; Set 'TTY available' bit
        JMP     SVGA_OKExit

SVGA_GMI_Direct16:
        ; Our 16-bit colour format is 0bbbbbgggggrrrrr binary

        MOV     ES:[DI].MemoryModel, 6          ; Direct Colour

        MOV     ES:[DI].RedMaskSize, 5
        MOV     ES:[DI].RedFieldPosition, 0
        MOV     ES:[DI].GreenMaskSize, 5
        MOV     ES:[DI].GreenFieldPosition, 5
        MOV     ES:[DI].BlueMaskSize, 5
        MOV     ES:[DI].BlueFieldPosition, 10
        MOV     ES:[DI].RsvdMaskSize, 1
        MOV     ES:[DI].RsvdFieldPosition, 15
        MOV     ES:[DI].DirectColorModeInfo, 0  ; Fixed colour ramp
        JMP     SVGA_OKExit

SVGA_GMI_Direct24:
        ; Our 24-bit colour format is 00 BB GG RR hex

        MOV     ES:[DI].MemoryModel, 6          ; Direct Colour

        MOV     ES:[DI].RedMaskSize, 8
        MOV     ES:[DI].RedFieldPosition, 0
        MOV     ES:[DI].GreenMaskSize, 8
        MOV     ES:[DI].GreenFieldPosition, 8
        MOV     ES:[DI].BlueMaskSize, 8
        MOV     ES:[DI].BlueFieldPosition, 16
        MOV     ES:[DI].RsvdMaskSize, 8
        MOV     ES:[DI].RsvdFieldPosition, 24
        MOV     ES:[DI].DirectColorModeInfo, 0  ; Fixed colour ramp
        JMP     SVGA_OKExit

; SVGA_SetMode -----------------------------------------

; On entry, BX is an SVGA mode number.
;
; This needs to be translated to an internal (BIOS) mode
; number, and the mode-set function is then called.
;
; VESA 2.0 bit 14 sets whether we use a flat frame buffer, so if it's set
; we need to disable the VGA emulation

SVGA_SetMode:
        MOV     AX, BX                  ; Get AX = mode number

        CALL    SVGA_GetPtrForMode      ; Is it one of ours?
        JC      SVGA_SM_Err             ; If not, stop now

        ;CMP    CS:[SI].lmVESAMode, 81FFh ; Is it the 'special' mode?
        ;JE     SVGA_OKExit             ; Ignore call if so

                                        ; CS:SI = mode definition

        CMP     CS:[SI].lmBPPcode, BPP_VGA ; Is it VGA-compatible?
        MOV     ES:VID_DACWidth, 6
        JE      SVGA_SM_VGA             ; If so, normal video BIOS will do it

        MOV     AX, BX                  ; Get AX bit 15 = don't-clear bit
                                        ;        bit 14 = linear FB

        MOV     GS:VID_VESAMode, AX     ; Matt's appendage
        CALL    SVGA_LoadMode
        JC      SVGA_SM_Err             ; Will fail if insufficient memory
SVGA_SetMode_notflat:                   ; wants a linear framebuffer
        CALL    MOU_ModeChange
        JMP     SVGA_OKExit

SVGA_SM_VGA:
        MOV     AL, CS:[SI].lmBIOSmode  ; AL = BIOS equivalent mode
        AND     BH, 80h                 ; BH = don't clear bit
        OR      AL, BH                  ; Composite BIOS mode
        CALL    VID_ModeChange
        CALL    MOU_ModeChange
        JMP     SVGA_OKExit

SVGA_SM_Err:
        JMP     SVGA_ErrExit

; SVGA_GetMode -----------------------------------------

; Returns an SVGA mode number in BX

SVGA_GetMode:
        MOV     AL, VID_Mode
        MOV     AH, 0

        CALL    SVGA_GetBIOSmodePtr     ; Get pointer to translate mode
        JC      SVGA_GM_10              ; if possible
        MOV     AX, CS:[SI].lmVESAMode  ; If so, get VESA mode number
SVGA_GM_10:                             ; If not, settle for BIOS number
        MOV     BX, GS:VID_VESAMode
        TEST    BX, 4000h
        JZ      SVGA_GM_20
        OR      AX, 4000h
SVGA_GM_20:
        MOV     [BP].SavedBX, BX
        JMP     SVGA_OKExit


; SVGA_SaveState ---------------------------------------

; This saves/restores the SVGA state, similar to INT 10h AH=1Ch
;
; For DL = 0, gets the size of the save buffer
;     DL = 1, saves the SVGA state
;     DL = 2, restores the SVGA state
;
; These are as INT 10h/AH=1Ch except that they also allow bit 3
; of CX to be set to save/restore the VESA register state. The
; dispatching mechanism for this is handled within the VGA code,
; which will call back SVGA_SaveRegs and SVGA_RestoreRegs if
; needed.

SVGA_SaveState:
        CMP     DL, 0
        JE      SVGA_SS_GetSize
        DEC     DL
        JZ      SVGA_SS_Save
        DEC     DL
        JZ      SVGA_SS_Restore
        JMP     SVGA_ErrExit

SVGA_SS_GetSize:
        CALL    VGAI_Fn1C00h
        JMP     SVGA_OKExit

SVGA_SS_Save:
        CALL    VGAI_Fn1C01h
        JMP     SVGA_OKExit

SVGA_SS_Restore:
        CALL    VGAI_Fn1C02h
        JMP     SVGA_OKExit

; SVGA_SetGetPage -----------------------------------------

; Function 05h
; BH = set/get flag, BL = window number,
; DX = window offset
;
; Must fail for flat frame-buffer modes (VBE2)

SVGA_SetGetPage:
        CMP     BX, 0                   ; Set Window A?
        JE      SVGA_SP_10              ;
        CMP     BX, 0100h               ; Get Window A?
        JE      SVGA_GP_10
        JMP     SVGA_ErrExit            ; >1 is error

SVGA_SP_10:
        ; DX = window start in 64K chunks
        MOV     AH, DL
        MOV     AL, VESA_WINA_PAGE
        MOV     DX, VID_CRTCport
        OUT     DX, AX
        JMP     SVGA_OKExit

SVGA_GP_10:
        MOV     DX, VID_CRTCport
        MOV     AL, VESA_WINA_PAGE
        OUT     DX, AL

        INC     DX
        IN      AL, DX                  ; Read page register
        MOV     AH, 0
        MOV     [BP].SavedDX, AX        ; Return DX = page number
        JMP     SVGA_OKExit

; SVGA_SetGetScanLength -----------------------------------

; Function 06h
;
; Sets/gets the number of bytes per line for this mode.
; We are not going to allow anyone to change the logical scan
; line lengths, it sounds like total pain & anguish. Also,
; this function is not supported in non-SVGA modes (as is
; S3 SVGA BIOS).
;
; VESA 2.0 note: When using linear framebuffer modes, we DO need to support
; the set scan line length, but we do this by changing to a screen mode with
; the requested scan line length as the X resolution.  Blame Stargunner.
;
; On entry BL=0 to set (CX=pixels per line)
;          BL=1 to get
;
; On exit:
;       BX = bytes per line
;       CX = pixels per line
;       DX = 'virtual vertical resolution' (Adapter memory size / (4*BX))

SVGA_SetGetScanLength:
        CMP     BL, 2                   ; Only support functions 0 & 1
        JAE     SVGA_SSL_Fail

        MOV     AL, VID_mode            ; Try to find mode information
        CALL    SVGA_GetBIOSmodePtr
        JC      SVGA_SSL_Fail

        ; We ignore BX value on entry, just return dimensions for mode

        MOV     AX, GS:VID_VESAMode
;       TRACEW  AX
;       TRACEB  BL
;       TEST    AX, 4000h               ; Are we in a lin. framebuffer mode?
;       JNE     SVGA_SSL_05
        CMP     BL, 0                   ; Set scan line length?
        JNE     SVGA_SSL_05
        MOV     DX, VID_CRTCport
        MOV     AL, VESA_SCANLINE
        MOV     AH, CL
        OUT     DX, AX
        MOV     AH, CH
        OUT     DX, AX
SVGA_SSL_05:

        MOV     AX, CS:[SI].lmWidth             ; Width in pixels
        MOV     [BP].SavedCX, AX                ; Pixels per scan line
        MOV     BX, CS:[SI].lmBytesPerLine      ; log 2 bits-per-pixel, range 2..5
        MOV     [BP].SavedBX, BX                ; Bytes per scan line

        MOV     DX, 1                           ; In VGA-compat modes we only
        MOV     AX, 0                           ; have 64K addressable range
        CMP     CS:[SI].lmBPPcode, BPP_VGA
        JE      SVGA_SSL_10                     ; Otherwise,
        CALL    SVGA_GetMemSize                 ; get memory size into DX:AX
SVGA_SSL_10:
        DIV     BX                              ; get AX = number of Y-lines
        MOV     [BP].SavedDX, AX
        JMP     SVGA_OKExit

SVGA_SSL_Fail:
        JMP     SVGA_ErrExit


; SVGA_SetGetDisplayStart ---------------------------------

; On entry, BX=0 to set, BX=1 to get display starting position
; within the video buffer. CX and DX contain horizontal and
; vertical *pixel* offsets, respectively. We only support this call
; in SVGA modes.

        ; On entry, CX = horiz. pixel offset
        ; DX = vert. pixel offset

SVGA_SetGetDisplayStart:
        MOV     AL, VID_mode            ; Try to find mode information
        CALL    SVGA_GetBIOSmodePtr     ; If not in SVGA mode, fail it
        JC      SVGA_SSL_Fail

        AND     BL, 07Fh                ; (80h = set during vertical retrace)
        CMP     BL, 1
        JB      SVGA_SetDS              ; 00 = set display start
        JE      SVGA_GetDS              ; 01 = get display start
        JMP     SVGA_ErrExit

        ; Get display start ----------
SVGA_GetDS:
        MOV     DX, VID_CRTCport        ; Get CRTC address
        MOV     AL, 13                  ; CRTC Reg 13 = Disp start LSB
        OUT     DX, AL

        INC     DX
        IN      AL, DX                  ; Read CR13
        MOV     CL, AL

        DEC     DX
        MOV     AL, 12                  ; CRTC Reg 12 = Disp start MSB
        OUT     DX, AL

        INC     DX
        IN      AL, DX
        MOV     CH, AL                  ; CX = CRTC display start LSW

        DEC     DX
        MOV     AL, VESA_START_HI
        OUT     DX, AL

        INC     DX
        IN      AL, DX
        MOV     DL, AL
        MOV     DH, 0                   ; DX = display start MSW
        MOV     AX, CX

        ; DX:AX = display start

        CMP     CS:[SI].lmBPPcode, BPP_VGA      ; Is it VGA-compatible 4bpp mode?
        JNE     SVGA_GDS_10
        MOV     DX, 0                   ; If so, only 64K addressable range allowed
        DIV     CS:[SI].lmBytesPerLine  ; Get AX = line number, DX = offset in line
        MOV     [BP].SavedDX, AX
        SHL     DX, 3                   ; Byte offset*8 = pixel number
        MOV     [BP].SavedCX, DX
        JMP     SVGA_OKexit

SVGA_GDS_10:
        DIV     CS:[SI].lmBytesPerLine  ; Get AX = line number, DX = offset in line
        MOV     [BP].SavedDX, AX
        MOV     CL, CS:[SI].lmByteShift ; CL = bytes per pixel shift, 0..2
        SHR     DX, CL
        MOV     [BP].SavedCX, DX        ; Return CX = pixel number
        JMP     SVGA_OKexit

        ; Set display start -----------

        ; CX = pixel within scan line
        ; DX = scan line number
        ; CS:[SI] = information for mode.
        ; We should fail if the given display start isn't available

SVGA_SetDS:
        CMP     CS:[SI].lmBPPcode, BPP_VGA ; Is it VGA-compatible 4bpp mode?
        JNE     SVGA_SDS_10

        TEST    CX, 7                   ; Can't set if it's not on a
        JNZ     SVGA_SDS_Fail           ; 8-pixel boundary
        SHR     CX, 3                   ; CX = byte offset within line
        MOV     BX, 0

        MOV     AX, DX
        MUL     CS:[SI].lmBytesPerLine  ; Get DX:AX = byte start address
        ADD     CX, AX                  ; BX:CX = complete byte start address
        ADC     BX, DX

        MOV     AX, CS:[SI].lmHeight
        MUL     CS:[SI].lmBytesPerLine  ; Get DX:AX = size of screen in bytes
        ADD     AX, CX                  ; Will whole screen fit in 64K?
        ADC     DX, BX                  ; If not, we can't do it
        JZ      SVGA_SDS_DoIt           ; BX:CX = display start
SVGA_SDS_Fail:
        JMP     SVGA_ErrExit

SVGA_SDS_10:
        MOV     BX, CX                  ; BX = start X
        MOV     CL, CS:[SI].lmByteShift ; AL = bpp shift, 2..5
        SHL     BX, CL                  ; BX = byte start within line
        MOV     CX, BX
        MOV     BX, 0                   ; BX:CX = byte start
        TEST    CX, 3                   ; Can only start on word boundary
        JNZ     SVGA_SDS_Fail

        MOV     AX, DX                  ; AX = start Y
        MUL     CS:[SI].lmBytesPerLine  ; DX:AX = line start address
        ADD     CX, AX
        ADC     BX, DX                  ; BX:CX = byte start

        PUSH    BX
        PUSH    CX                      ; Save it for now
        CALL    SVGA_CheckModeSize      ; Check that offset in BX:CX is
        POP     CX                      ; allowed
        POP     BX
        JC      SVGA_SDS_Fail
SVGA_SDS_DoIt:
        MOV     DX, VID_CRTCport        ; Get CRTC address

        MOV     AL, 13                  ; CRTC Reg 13 = Disp start LSB
        MOV     AH, CL                  ; Send CL value to reg 13
        OUT     DX, AX

        MOV     AL, 12                  ; CRTC Reg 12 = Disp start MSB
        MOV     AH, CH
        OUT     DX, AX

        MOV     AL, VESA_START_HI       ; Extension reg - display start
        MOV     AH, BL
        OUT     DX, AX

        JMP     SVGA_OKExit

; SVGA_SetGetDACFormat ------------------------------------

; Wasn't supported in 1.2 BIOS-- we need to cope with 8bit DACs
; because lots of games don't like crazy 6bit colour values.

SVGA_SetGetDACFormat:
        ; On entry, BL=0 to set, BL=1 to get DAC format,
        ; BH gives number of bits per colour on DAC
        CMP     BL, 01h
        JE      SVGA_GDF_10             ; Get DAC format?
        JB      SVGA_SDF_10             ; Set DAC format
        JMP     SVGA_ErrExit

SVGA_SDF_10:
        CMP     BH, 7
        MOV     BH, 8                   ; Only allow 6 / 8bit width DAC
        JG      SVGA_SDF_SetIt
        MOV     BH, 6
SVGA_SDF_SetIt:
;       MOV     VID_DACWidth, BH; Store in BIOS extended data segment

        MOV     DX, VID_CRTCport
        MOV     AL, VESA_DACWIDTH
        MOV     AH, BH
        OUT     DX, AX          ; Tell !PC what we're up to
SVGA_GDF_10:
;       MOV     BH, VID_DACWidth
        MOV     [BP].SavedBH, BH
        JMP     SVGA_OKExit

; SVGA_SetGetPalette ------------------------------------

; On entry, BL=0 to set and 1 to get palette data
; bit 7 of BL is set to do it during a retrace (we ignore this)
; DX = first colour, CX = number of colours to update.
; ES:DI points to a table with 4 bytes per colour, in the
; sequence <ignored>, <red>, <green>, <blue>
;

SVGA_SetGetPalette:
        ; Check values are in range, etc
        CMP     DX, 255         ; First colour
        JA      SVGA_SGP_Fail
        CMP     CX, 256         ; Number of colours
        JA      SVGA_SGP_Fail   ; Too many?
        JCXZ    SVGA_SGP_OK     ; Nothing to do?

        MOV     AX, DX          ; Last colour + 1
        ADD     AX, CX
        CMP     AX, 256
        JA      SVGA_SGP_Fail

        ; On entry, BL=0 to set, BL=1 to get palette
        AND     BL, 07Fh
        CMP     BL, 01h
        JE      SVGA_GetPal_10
        JB      SVGA_SetPal_10
SVGA_SGP_Fail:
        JMP     SVGA_ErrExit

        ; Set palette

SVGA_SetPal_10:
        MOV     AL, DL          ; First colour to be written
        MOV     DX, 03C8h       ; DAC-Write-Address register
        OUT     DX, AL

        MOV     DX, 03C9h       ; DAC data register
        MOV     SI, DI          ; ES:SI points to table
        CLD

SVGA_SP_loop:
;       INC     SI
;       LODS    byte ptr ES:[SI]        ; Send Red
;       OUT     DX, AL
;       LODS    byte ptr ES:[SI]        ; Send Green
;       OUT     DX, AL
;       LODS    byte ptr ES:[SI]        ; Send Blue
;       OUT     DX, AL
;       LOOP    SVGA_SP_loop
        MOV     EBX, ES:[ESI]
        MOV     EAX, EBX
        SHR     EAX, 16
        OUT     DX, AL  ; Send red
        MOV     EAX, EBX
        SHR     EAX, 8
        OUT     DX, AL ; Send green
        MOV     EAX, EBX
        OUT     DX, AL ; Send blue
        ADD     ESI, 4
        LOOP    SVGA_SP_loop

        JMP     SVGA_OKExit

        ; Get palette

SVGA_GetPal_10:
        MOV     AL, DL          ; First colour to be read
        MOV     DX, 03C7h       ; DAC-Read-Address register
        OUT     DX, AL

        MOV     DX, 03C9h       ; DAC Data register
        MOV     AL, 0           ; "Ignore" value
        CLD

SVGA_GP_loop:
        STOSB                   ; Ignored byte
        INSB                    ; Get Red
        INSB                    ; Get Green
        INSB                    ; Get Blue
        LOOP    SVGA_GP_loop

SVGA_SGP_OK:
        JMP     SVGA_OKExit

; SVGA_ReturnPMI---------------------------------------
;
; Returns a table containing veneers to three routines so they can be
; called in protected mode.
;
; ES:DI = table address
; CX    = table length

SVGA_ReturnPMI:
        MOV     [BP].SavedES, CS
        ASSUME  ES:BIOSRomSeg
        MOV     DI, offset ES:SVGA_PMI_table
        MOV     [BP].SavedDI, DI
        MOV     [BP].SavedCX, SVGA_PMI_table_end - SVGA_PMI_table
        ASSUME  ES:BIOSXDataSeg
        JMP     SVGA_OKExit

SVGA_PMI_table:
        ; Let's mix segments ;-)
        INCLUDE BIOS32.INC
SVGA_PMI_table_end:

; Subroutines =========================================================

; SVGA_SaveRegs ----------------------------------------
;
; This is called from the VGA BIOS when a 'save video state' has happened.
; On entry,
;
; ES:DI->4-byte block for save.
; Must leave ES:DI pointing to the next byte after the buffer.
;
; Currently, our block format is
;
; +0 : Mode Request register
; +1 : Display start high register
; +2 : Window A start register
; +3 : must be zero
;

SVGA_SaveRegs proc near
        CLD
        CALL    SVGA_GetCRTCBase

        MOV     AL, VESA_MODE_REQUEST
        OUT     DX, AL
        INC     DX
        IN      AL, DX                  ; Get AL = Mode request register
        STOSB                           ; Store in block

        DEC     DX
        MOV     AL, VESA_START_HI
        OUT     DX, AL
        INC     DX
        IN      AL, DX                  ; Get AL = display start high register
        STOSB                           ; Store in block

        DEC     DX
        MOV     AL, VESA_WINA_PAGE
        OUT     DX, AL
        INC     DX
        IN      AL, DX                  ; Get AL = window A page register
        STOSB                           ; Store in block

        MOV     AL, 0
        STOSB                           ; Reserved byte
        RET
SVGA_SaveRegs endp

; SVGA_RestoreRegs ----------------------------------------
;
; This is called from the VGA BIOS when a restore video state has happened.
; On entry,
;
; ES:DI->4-byte block to restore
;
; Must leave ES:DI pointing to the next byte after the buffer.
;
; Currently, our block format is
;
; +0 : Mode Request register
; +1 : Display start high register
; +2 : Window A start register
; +3 : must be zero
;

SVGA_RestoreRegs proc near
        CLD
        CALL    SVGA_GetCRTCBase

        MOV     AL, VESA_MODE_REQUEST
        MOV     AH, ES:[DI]
        OUT     DX, AX

        MOV     AL, VESA_START_HI
        MOV     AH, ES:[DI+1]
        OUT     DX, AX

        MOV     AL, VESA_WINA_PAGE
        MOV     AH, ES:[DI+2]
        OUT     DX, AX

        RET
SVGA_RestoreRegs endp

; Oh, don't you just hate and despise everything to do with VGAs!

SVGA_GetCRTCBase proc near
        MOV     DX, 03CCh
        IN      AL, DX                  ; Get AL = Misc output register
        MOV     DX, 03B4h
        TEST    AL, 1                   ; 1 if base is 3D4h (colour)
        JZ      SVGA_GCB_10
        MOV     DX, 03D4h
SVGA_GCB_10:
        RET
SVGA_GetCRTCBase endp

; SVGA Page function: ----------------------------------
;
; This is a FAR routine to bank-switch video address windows
; if the adapter provides this facility. We currently
; don't, as we only have 256K of VRAM. It behaves in a similar
; manner to Int 10h Function 4F05h, except that AX doesn't
; give a return code.
;
; On entry: BH=0 to set window base, BH=1 to get window base
;           BL=window number (0=Window A, 1=Window B)
;           DX=window offset (in granularity units) if BH=0
;
; On exit: AX corrupted, DX=window offset if BH was 1, else
; corrupted.
;
; Here, we always simply return a window offset of zero in DX.

SVGA_PageFunction PROC FAR
        CMP     BX, 0                   ; Set Window A?
        JNE     SVGA_PF_10

        MOV     AH, DL
        MOV     AL, VESA_WINA_PAGE
        MOV     DX, 03D4h               ; Assert it's always colour
        OUT     DX, AX
        RET

SVGA_PF_10:
        MOV     DX, 0
        CMP     BX, 0100h               ; Get Window A?
        JNE     SVGA_PF_20

        MOV     AL, VESA_WINA_PAGE
        MOV     DX, 03D4h               ; Assert it's always colour
        OUT     DX, AL

        INC     DX
        IN      AL, DX                  ; Read page register
        MOV     AH, 0
        MOV     DX, AX                  ; Return DX = page number
SVGA_PF_20:
        RET
SVGA_PageFunction ENDP

; SVGA_CheckModeLegal ---------------------------------
;
; Checks to see if the ARM can do a given mode, based on available
; memory size and the capabilities flags. On entry, CS:[SI] is the
; LocalMode structure. Returns carry set if mode is illegal, else
; carry clear. Assumes DS=Data. Corrupts AX-DX

SVGA_CheckModeLegal proc near
        ; Check capabilities
        MOV     AL, CS:[SI].lmBPPCode

        CMP     AL, BPP_VGA     ; VGA is always available
        JE      SVGA_CML_20

        MOV     AH, MC_8BPP     ; Is it 8..24 bpp?
        CMP     AL, BPP_8
        JE      SVGA_CML_10

        MOV     AH, MC_16BPP
        CMP     AL, BPP_16
        JE      SVGA_CML_10

        MOV     AH, MC_24BPP
        CMP     AL, BPP_24
        JE      SVGA_CML_10
SVGA_CML_Fail:
        STC
        RET

SVGA_CML_10:
        ; AH contains bit mask of capabilities bits

        MOV     DX, VID_CRTCport
        MOV     AL, VESA_MODE_CAPS      ; Read Mode Capabilities register
        OUT     DX, AL
        INC     DX
        IN      AL, DX                  ; Get it
        AND     AL, AH
        CMP     AL, AH                  ; Are all necessary bits set
        JNE     SVGA_CML_Fail           ; If not, we can't do it

        ; Now check memory size
SVGA_CML_20:
        MOV     BX, 0
        MOV     CX, 0
        JMP     short SVGA_CheckModeSize
SVGA_CheckModeLegal endp

; SVGA_CheckModeSize ----------------------------------

; On entry, CS:SI points to a local video mode definition.
; BX:CX is a display start address. The routine checks that BX:CX,
; plus the size of the mode, will fit into available display RAM.
; This is used (with BX:CX=0) to see if a given mode is legal, or
; (with BX:CX = starting address) if a given starting address is
; legal.
;
; Returns carry clear if OK, carry set if it won't work
;
; Corrupts BX, CX

SVGA_CheckModeSize proc near
        MOV     AX, CS:[SI].lmHeight
        MUL     CS:[SI].lmBytesPerLine  ; DX:AX = total display length
        ADD     CX, AX
        ADC     BX, DX                  ; BX:CX = last displayed byte+1
        CALL    SVGA_GetMemSize         ; get memory size into DX:AX
                                        ; If BX:CX > DX:AX, it's a fail
        CMP     BX, DX
        JA      SVGA_CMS_Fail           ; Fail if above
        JB      SVGA_CMS_OK             ; Pass if below
        CMP     CX, AX                  ; Equal - check low word
        JA      SVGA_CMS_Fail           ; Fail if above
SVGA_CMS_OK:
        CLC
        RET
SVGA_CMS_Fail:
        STC
        RET
SVGA_CheckModeSize endp

; SVGA_GetMemSize -----------------------------------------
;
; Returns the size of display memory in DX:AX
; Assumes DS=Data on entry

SVGA_GetMemSize proc near
        MOV     DX, VID_CRTCport
        MOV     AL, VESA_MEM_SIZE       ; Mem-size register holds
        OUT     DX, AL                  ; size of VRAM in 64K chunks

        INC     DX
        IN      AL, DX                  ; Get it
        MOV     DL, AL                  ; Put into place in DX:AX
        MOV     DH, 0
        MOV     AX, 0
        RET
SVGA_GetMemSize endp

; SVGA Mode-set functions ==============================
;
;
; SVGA_SetBIOSmode is called from the normal INT 10h/AH=0 routine,
; when the mode requested is a funny number.
; Entered with DS = Data, AL = mode number, AL[7] is 'don't clear' bit
;

SVGA_SetBIOSmode proc near
        MOV     AH, AL
        AND     AX, 0807Fh              ; AH = don't clear bit, AL = mode no
        CALL    SVGA_GetBIOSmodePtr     ; Get CS:SI = matching structure for mode
        JC      SVGA_SBM_fail

        CMP     CS:[SI].lmBPPcode, BPP_VGA      ; This routine can't set
        JNE     SVGA_LoadMode                   ; VGA-based modes.
SVGA_SBM_fail:
        RET
SVGA_SetBIOSmode endp

; SVGA_LoadMode --------------

; Enter with CS:SI->LocalMode structure for this mode, DS=Data
; AH[7] set if we shouldn't clear video memory
; AH[6] set if a linear framebuffer is required (i.e. no multi-tasking)
; Carry set on return if mode wouldn't fit!

SVGA_LoadMode proc near
        MOV     AL, VID_ctrlbits
        AND     AX, 0807Fh
        OR      AL, AH
        MOV     VID_ctrlbits, AL        ; Copy into VID_ctrlbits

        ; Check mode is legal

        CALL    SVGA_CheckModeLegal
        JNC     SVGA_LoadIt
        RET

SVGA_LoadIt:
        ; Set up BIOS variables for mode

        MOV     AL, CS:[SI].lmBIOSMode
        MOV     VID_mode, AL

        MOV     AX, 0                   ; Set all paging stuff to zero
        MOV     VID_pgsize, AX
        MOV     VID_pgaddr, AX
        MOV     VID_actpage, AL

        MOV     AX, CS:[SI].lmWidth
        SHR     AX, 3
        MOV     VID_ncols, AX           ; No. of columns = width/8

        MOV     AX, CS:[SI].lmHeight
        SHR     AX, 3
        DEC     AX
        MOV     VID_lastrow, AL         ; No. of rows = width/8

        MOV     VID_charheight, 8       ; Character height always 8

        ; Set graphics character pointer

        LES     DI, CS:VGAI_43address
        MOV     ES:[DI], offset CS:VID_CGAFontLo
        MOV     ES:[DI+2], CS

        ; Now implement mode

        CALL    VGA_VideoOff            ; Disable display update

        MOV     DX, 03C2h               ; Misc output reg
        MOV     AL, 0E3h                ; Put CRTC at 'colour' address
        OUT     DX, AL                  ; other bits at sensible defaults

        MOV     DX, 03D4h
        MOV     VID_CRTCport, DX

        ; Set display start to zero

        MOV     AH, 0

        MOV     AL, 13                  ; CRTC Reg 13 = Disp start LSB
        OUT     DX, AX

        MOV     AL, 12                  ; CRTC Reg 12 = Disp start MSB
        OUT     DX, AX

        MOV     AL, VESA_START_HI       ; Extension reg - display start
        OUT     DX, AX

        MOV     AL, VESA_WINA_PAGE
        OUT     DX, AX                  ; Display memory page = 0

        MOV     AH, CS:[SI].lmBPPcode   ; Get composite mode-select value
        OR      AH, CS:[SI].lmSizeCode

        MOV     AL, VESA_MODE_REQUEST
        OUT     DX, AX                  ; Request mode

        MOV     DX, 03C6h               ; Set pixel mask = 0FFh
        MOV     AL, 0FFh
        OUT     DX, AL

        MOV     DX, 03CEh
        MOV     AX, 0506h               ; Set GR6 = 5 (mem mapped @ A000h)
        OUT     DX, AX

        CALL    VGA_VideoOn

        ; Now set DAC if necessary

        CMP     CS:[SI].lmBPPcode, BPP_8        ; Only in 8bpp mode or lower
        JA      SVGA_LM_NoDAC

        PUSH    SI
        MOV     SI, offset CS:TBL_DAC_Mode13

        MOV     AX, CS
        MOV     ES, AX                  ; ES:SI-> DAC table
        MOV     BX, 0h                  ; BX = first colour = 0
        MOV     CX, ES:[SI]             ; CX=first entry=length
        ADD     SI, 2
        CALL    VGA_SetDACblock         ; Set DAC block
        POP     SI
SVGA_LM_NoDAC:

        ; Clear screen, if necessary

        TEST    VID_ctrlbits, 80h       ; Should we clear the screen?
        JNZ     SVGA_LM_NoClear

        CALL    VID_CheckARMassist      ; Can we get the ARM to do it?
        JNZ     SVGA_LM_HardClear       ; if not, do-it-ourselves

        MOV     DX, VID_CRTCport
        MOV     AX, 03E28h              ; Write CR28 = ARM-assist command reg
        OUT     DX, AX                  ; Send 3Eh = Clear Screen Command
        JMP     SVGA_LM_NoClear

SVGA_LM_HardClear:                      ; Clear it ourselves
        MOV     AX, CS:[SI].lmBytesPerLine
        MUL     CS:[SI].lmHeight        ; DX:AX = Image height
        MOV     BX, DX

        ; Clear BX:AX bytes of video RAM, with paging

        MOV     AX, 0A000h              ; ES addresses video segment
        MOV     ES, AX
        CLD

        MOV     CX, AX                  ; Do bytes in last segment
        SHR     CX, 1                   ; Convert to words
        JZ      SVGA_LMC_10

        MOV     AH, BL                  ; BL = page number
        MOV     DX, VID_CRTCport
        MOV     AL, VESA_WINA_PAGE
        OUT     DX, AX                  ; Set page number

        MOV     DI, 0
        MOV     AX, 0
        REP     STOSW                   ; Clear bytes

SVGA_LMC_10:                            ; Clear BX pages of VRAM
        SUB     BL, 1
        JB      SVGA_LM_NoClear         ; While (--bl >= 0 )
        MOV     AH, BL
        MOV     AL, VESA_WINA_PAGE
        OUT     DX, AX                  ; page number = bl

        MOV     DI, 0
        MOV     AX, 0
        MOV     CX, 8000h
        REP     STOSW                   ; Clear 64K bytes
        JMP     SVGA_LMC_10

SVGA_LM_NoClear:
        TEST    GS:VID_VESAMode, 4000h  ; Direct screen access wanted?
        JZ      SVGA_LM_NotFlat
        MOV     DX, VID_CRTCport
        MOV     AL, VESA_DIRECT
        MOV     AH, 1
        OUT     DX, AX
        IN      AX, DX                  ; Wait for confirmation...
SVGA_LM_NotFlat:

        MOV     DX, VID_CRTCport        ; Largely for safety, set
        MOV     AX, VESA_WINA_PAGE      ; page = 0
        OUT     DX, AX

        ; The End
        CLC
        RET

SVGA_LoadMode endp

 .286
