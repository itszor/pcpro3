; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSTIC.ASI   BIOS Timer services
;
; Versions
; 0.1   16-08-91 INH    Original
;	 9-11-91	Test version, does not use FDD motor port
;	11-11-91	FDD reinstated, simple 1A int handler written
;			TIC_daytime bug fixed
;			TIC_daytime correctly initialised
;			RTC services done using CMOS not SVC
;	19-02-93	Read time clears OVflow flag (v1.12)
;	15-06-94	FDD Motor control added
; *****************************************************************

; Initialise Routine ***************************************

TIC_Init PROC NEAR
	CLI

	IN      AL, IO_PIC1_Mask                ;Enable timer interrupt
	AND     AL, 0FEh                        ;on INT 0
	IOWAIT
	OUT     IO_PIC1_Mask, AL

	; Set up Timers *************************************

	MOV     BX, offset CS:TIC_InitTbl
	CALL    MSC_MultiOut

	STI

	; Initialise TIC_daytime ****************************

	MOV	AH, 02h		;Read RTC time
	INT	1Ah

	MOV	AL, DH		;Get number of seconds
	CALL	BCDtoBin
	MOV	BX, 18		;Convert to ticks in DX:AX
	MUL	BX
	MOV	SI, AX		;Accumulate into DI:SI
	MOV	DI, DX

	MOV	AL, CL		;Get number of minutes
	CALL	BCDtoBin
	MOV	BX, 1092	;Convert to ticks in DX:AX
	MUL	BX
	ADD	SI, AX		;Accumulate into DI:SI
	ADC	DI, DX

	MOV	AL, CH		;1 hour is 64K+7 ticks
	CALL	BCDtoBin
	ADD	DI, AX		;Add 64K * hours
	MOV	BX, 7
	MUL	BX
	ADD	SI, AX
	ADC	DI, DX

	CLI
	MOV	TIC_daytime,  SI
	MOV	TIC_daytimeH, DI
	STI

	RET

TIC_Init ENDP

	; BCDtoBin routine converts AL in BCD to binary in AX

BCDtoBin PROC NEAR
	MOV	AH, AL
	AND	AL, 0Fh		;AL = value of LSD
	AND 	AH, 0F0h	;AH = value of MSD * 16
	SHR	AH, 1		; convert to MSD*8
	ADD	AL, AH		; add to AL
	SHR	AH, 2		; convert to MSD*2
	ADD	AL, AH		; add to AL
	MOV	AH, 0
	RET
BCDtoBin ENDP


; Timer tick services ********************************************

; This services INT 1Ah functions 0 and 1
; others are passed to ARM

TIC_Int PROC FAR
	STI
	PUSH	DS
	MOV	DS, CS:DataSeg@

	CMP	AH, 00h			; Select routine and branch
	JE	TIC_I_Rdtimer
	CMP	AH, 01h
	JE	TIC_I_Wrtimer
	CMP	AH, 02h
	JE	TIC_I_RdRTCtime		; Write time and date are
	CMP	AH, 04h			; not supported, they are
	JE	TIC_I_RdRTCdate		; fixed by ARM

TIC_I_BadExit:
	STC
	POP	DS
	RET	2

TIC_I_GoodExit:
	CLC
	POP	DS
	RET	2

; AH = 0 Read system timer ******************

TIC_I_Rdtimer:

	CLI
	MOV	AL, 0
	XCHG	AL, TIC_rollover
	MOV	CX, TIC_daytimeH
	MOV	DX, TIC_daytime
	STI
	JMP	TIC_I_GoodExit

TIC_I_Wrtimer:

	CLI
	MOV	TIC_rollover, 0
	MOV	TIC_daytimeH, CX
	MOV	TIC_daytime, DX
	STI

	JMP	TIC_I_GoodExit

TIC_I_RdRTCtime:

	RDCMOS	CMOS_updateRTC		;Hint to ARM to refresh time
	RDCMOS	CMOS_hour
	MOV	CH, AL
	RDCMOS	CMOS_min
	MOV	CL, AL
	RDCMOS	CMOS_sec
	MOV	DH, AL
	MOV	DL, 0

	JMP	TIC_I_GoodExit

TIC_I_RdRTCdate:

	RDCMOS	CMOS_updateRTC
	RDCMOS  CMOS_century
	MOV	CH, AL
	RDCMOS	CMOS_year
	MOV	CL, AL
	RDCMOS	CMOS_month
	MOV	DH, AL
	RDCMOS	CMOS_date
	MOV	DL, AL

	JMP	TIC_I_GoodExit

TIC_Int ENDP

; Timer tick interrupt service routine ***************************

TIC_Isr PROC FAR

	PUSH    AX
	PUSH    DX
	PUSH    DS

IFDEF PC_DEMO
 .386
	PUSH	EAX
	PUSH	GS
	MOV	AX, BIOSXDataSeg
	MOV	GS, AX
        ASSUME  GS:BIOSXData
	MOV	EAX, GS:TIC_demotics
	ADD	EAX, 1
	MOV	GS:TIC_demotics, EAX
	CMP	EAX, 9000
	JB	no_timer_halt
timer_halt:
	JMP	timer_halt
no_timer_halt:
	;TRACEW	AX
	POP	GS
	POP	EAX
 .286
ENDIF

	MOV     DS, CS:DataSeg@

	; First, increment time of day count

	MOV     AX, TIC_daytimeH

        ADD     TIC_daytime, 1
        ADC     AX,0

        CMP     AX, 24                  ;24*65536 + 176 tick = 24hrs approx
        JB      TIC_no_roll
	CMP	TIC_daytime, 176
	JB	TIC_no_roll

	MOV	TIC_daytime, 0
        MOV     AX, 0
        INC     TIC_rollover
TIC_no_roll:
        MOV     TIC_daytimeH, AX

        DEC     FDD_timer
        JNZ     TIC_no_motor

	TEST	FDD_present, 3		; 'Real' drives 0 or 1 present?
	JZ	TIC_no_motor		; If not, don't do next bit 'cos it
	XOUT    IO_FDD_MtrCtrl, 0CH	; kills pre-FD-bodge Elvises!
        AND     FDD_motorstat, 0F0H

TIC_no_motor:
	STI

	MOV     AL, 20H
	OUT     IO_PIC1_Ctrl, AL

	INT     01CH            ;Tick User Interrupt

	POP     DS
	POP     DX
	POP     AX
	IRET

TIC_Isr ENDP


	; Initialisation data ************************************


TIC_InitTbl:
			; Set Counter 0 to generate timer tick

	DW      IO_PIT_Cmd
	DB      036H                    ;Counter 0: Mode 3
	DW      IO_PIT_Tmr0
	DB      0                       ;Max count = 55ms tick
	DW      IO_PIT_Tmr0
	DB      0
			; Set Counter 2 to generate beep frequency

	DW      IO_PIT_Cmd
	DB      0B6H                    ;Counter 2: Mode 3
	DW      IO_PIT_Tmr2
	DB      0
	DW      IO_PIT_Tmr2
	DB      1                       ;Set pitch value

	DW      0FFFFH			;End of table
