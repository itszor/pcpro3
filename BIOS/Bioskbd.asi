; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSKBD.ASI   BIOS Keyboard code
;
; Versions
; 0.1   13-08-91 INH    Original
; 0.2    5- 9-91        Install changed
;       11-11-91        Ack mechanism changed
;        2-12-91        Changed to US/Archie keyboard layout
;       16-01-92        Partial extended keyboard support
;       20-01-92        Ctrl-Alt-Del on both delete keys
;       06-02-92        Changed to new AT-style ports
;	26-02-92	Shift-key definitions moved
;	07-05-92	Ignores ACK and NAK codes
;	08-05-92	INT 16H function 01h sets LED state
;	01-07-92	Pause (Ctrl-NumLock) function added
;	30-10-92	(0.97) Write Mode Reg bug fixed
; 1.11	01-04-93	(For 8-bit card) sends ARM_Reset on Ctrl-Alt-Del
; 1.14	11-05-93	Shift-Tab fix; extended bits
; 1.55	10-06-94	Function 05h - Store Key data
; 1.63	01-11-94	Revised interrupt & self-test bit
; 2.04  97-04-11 W      Added missing extended ctrl & alt codes e.g. ctrl-up
; *****************************************************************

KBD_Init        PROC    NEAR

	CLI

	; Initialise buffer pointers

	MOV     BX, offset DS:KBD_buffer
	MOV     [KBD_bufstart], BX
	MOV     [KBD_outptr], BX

	MOV     [KBD_inptr], BX
	ADD     BX, 32
	MOV     [KBD_bufend], BX

	MOV     [KBD_shifts], 0         ;Initialise to num/caps lock OFF
	MOV	[KBD_xshifts], 0
	MOV     [KBD_miscstat], 010h	; Set 'extended keyboard present' bit

	; Do keyboard self-test

	MOV	AL, 0AAh		; Do self-test and clear buffers
	OUT	IO_Kbd_Cmd, AL		; (will also disable IRQs)

	MOV	CX, 0
KI_Check_Loop:
	IN	AL, IO_Kbd_Cmd		; Read status
	AND	AL, 01h			; Bit 0 set if data available
	JNZ	KI_Check_OK
	LOOP	KI_Check_Loop		; Long timeout

KI_Check_OK:
	IN	AL, IO_Kbd_Data		; Read back self-test result
	
	; Now set up keyboard properly

	MOV     AL, 060h                ;Write Mode Reg command
	OUT     IO_Kbd_Cmd, AL
	MOV     AL, 045h                ;Enable Keyboard and Interrupt
	OUT     IO_Kbd_Data, AL

	; Enable keyboard interrupt

	IN      AL, IO_PIC1_Mask
	AND     AL, 0FDH                ;Enable IRQ 1
	IOWAIT
	OUT     IO_PIC1_Mask, AL

	STI

	RET

KBD_Init        ENDP


; INT 16H Keyboard services routine *******************************

KBD_Int PROC FAR

	STI
	PUSH    BX
	PUSH    DS

	MOV     DS, CS:DataSeg@

	CMP     AH, 0                   ;AH=0 Get char from buffer
	JE      kbd_read
	CMP     AH, 10H
	JE      kbd_read
	CMP     AH, 1                   ;AH=1 Examine buffer
	JE      kbd_ndread
	CMP     AH, 11H
	JE      kbd_ndread
	CMP     AH, 2                   ;AH=2 Get shift status
	JE      kbd_getshift
	CMP     AH, 12H
	JE      kbd_getshift
	CMP	AH, 5
	JE	kbd_storekey
kbd_exit:
	POP     DS
	POP     BX
	RET     2

kbd_getshift:
	MOV     AL, [KBD_shifts]
	MOV     AH, [KBD_xshifts]
	JMP     kbd_exit

kbd_ndread:
	;This must first update the keyboard LED status if it has changed

	MOV	AL, [KBD_Shifts]	;Shift status is in bits 4..6
					; 4=ScrLock, 5=Num, 6=Caps 
	SHR	AL, 4			;Convert to bits 0..2
	XOR	AL, [KBD_LEDstat]	;LED status is in bits 0..2
	AND	AL, 7			;has it changed?
	JZ	kbd_ndread1		;if not, don't set keys
	CALL	key_set_LEDs
kbd_ndread1:
	MOV     BX, [KBD_outptr]        ;Get address of next char
	MOV     AX, [BX]                ;Get value of next char
	CMP     BX, [KBD_inptr]         ;Set Z flag if no character really
	JMP     kbd_exit

kbd_read:
	MOV     BX, [KBD_outptr]        ;Check no of chars in buffer
	CMP     BX, [KBD_inptr]
;	MOV     AX, 9002H               ;Tell system keyboard device is busy
;	INT     15H
	JE      kbd_read                ;Waste time until one appears
	

	MOV     AX, [BX]                ;Get char from buffer
	ADD     BX,2                    ;Advance pointer
	CMP     BX, [KBD_bufend]        ;If is is past end of buffer
	JB      kbd_r1
	MOV     BX, [KBD_bufstart]      ;restart it from beginning
kbd_r1: MOV     [KBD_outptr], BX
	JMP     kbd_exit

kbd_storekey:	; CX = scan code/character to be stored
	CLI
	MOV     BX, KBD_inptr		;Get current free buffer location
	ADD     BX, 2			;& work out next free one
	CMP     BX, KBD_bufend
	JB      kbd_stk1
	MOV     BX, KBD_bufstart
kbd_stk1:
	MOV	AL, 01h			; 'Buffer full' code
	CMP     BX, KBD_outptr		; Would we overwrite codes?
	JE      kbd_stk2		; if so, don't do it
	XCHG    BX, [KBD_inptr]         ; Else update pointer and
	MOV     [BX], CX                ; put CX into buffer
	MOV	AL, 00h
kbd_stk2:
	STI
	JMP	kbd_exit
KBD_Int ENDP


; Keyboard Interrupt service routine **********************************

KBD_ISR PROC FAR

	STI
	PUSH    DS
	PUSH    AX
	PUSH    BX

;	MOV     AX, 9102h               ;tell system wait now over
;	INT     15H  
	                   
MOV     DS, CS:DataSeg@

	MOV	AL, 0ADh		;Disable further keyboard interrupts
	OUT	IO_Kbd_Cmd, AL		;from changing the value at port 60h

	IOWAIT

	IN      AL, IO_KBD_Data         ;Get scan code from port
					;Generate INT 15h AH = 04Fh event
	MOV     AH, 04Fh                ;(keyboard intercept)
	STC
	INT     15H
	JNC     kbd_isr_exit		; If carry cleared, exit
	
	; Are we in pause state? **************************

	TEST	[KBD_xshifts], 08h	; 40:18h bit 3=1 in pause state
	JZ	kbd_isr_lookup

	TEST	AL, 80h			; Only codes in range 0-7F
	JNZ	kbd_isr_lookup		; will release pause state
	CMP	AL, 01Dh		; Also exclude ctrl and shift keys
	JE	kbd_isr_lookup
	CMP	AL, 02Ah
	JE	kbd_isr_lookup
	CMP	AL, 036h
	JE	kbd_isr_lookup

	AND	[KBD_xshifts], 0F7h	; clear pause bit
	JMP	kbd_isr_exit		; and exit

	; Scan code lookup ********************************
	; BX points to a table containing a list of entries
	; minimum scan-code, maximum scan-code, address of routine
	;
	; routine is entered with AH = scan code, AL = shift state
kbd_isr_lookup:
	MOV     AH, AL
	MOV     AL, [KBD_shifts]
	MOV     BX, offset CS:kbd_scantable
	JMP     kbd_lu2
kbd_lu1:
	ADD     BX, 4
kbd_lu2:
	CMP     AH, CS:[BX+1]           ;Check top limit
	JA      kbd_lu1
	CMP     AH, CS:[BX]             ;Check bottom limit
	JB      kbd_lu1
	JMP     CS:word ptr [BX+2]      ;Jump to routine

	; kbd_xlate routines ******************************
	;
	; Arrive here with AH = scan-code, BX = lookup table
	; to look up code and place in buffer
	; kbd_xlatecode generates an ASCII code
	; kbd_xlatescan generates a scan code

kbd_xlatecode:
	MOV     AL, AH                  ;Restore scan code
	XLAT    CS:[BX]
	CMP     AL, 0FFh                ;If 0FFh, do not insert
	JNE     kbd_isr_insert
	JMP     kbd_isr_exit            ;a scan code, in which case

kbd_xlatescan:
	MOV     AL, AH
	XLAT    CS:[BX]                 ;Translate scan code
	SHL     AX, 8                   ;put code in MSB, 0 in LSB
	CMP     AH, 0FFh
	JNE     kbd_isr_insert          ;If 0FFh, do not insert
	JMP     kbd_isr_exit

	; kbd_isr_insert **********************************
	; Arrive here with AX = value to be placed in buffer

kbd_isr_insert:
	MOV     [KBD_altvalue], 0       ;Clear Alt-numkey code

	MOV     BX, [KBD_inptr]         ;Get current free buffer location
	ADD     BX, 2                   ;& work out next free one
	CMP     BX, [KBD_bufend]
	JB      kbd_isr_i1
	MOV     BX, [KBD_bufstart]
kbd_isr_i1:
	CMP     BX, [KBD_outptr]        ;If next free one would overwrite
	JE      kbd_isr_beep            ;give a beep
	XCHG    BX, [KBD_inptr]         ;Else update pointer and
	MOV     [BX], AX                ;put AX into buffer

	; kbd_isr_exit *************************************

kbd_isr_exit:
	AND     KBD_miscstat, 0FDh      ;Reset 'extended key' status bit

kbd_isr_exitxtd:
	CALL	kbd_ack_interrupt

kbd_isr_return:                         ;Exit here if we've already
					;done the EOI
	POP     BX
	POP     AX
	POP     DS
	IRET

	; Beep routine **************************************

kbd_isr_beep:
	CALL	kbd_beep
	JMP     kbd_isr_exit

; keyboard translate routines *******************************

kbd_normcode:
	MOV     BX, offset CS:kbd_xlnormal
	JMP     kbd_xlatecode
kbd_shiftcode:
	MOV     BX, offset CS:kbd_xlshift
	JMP     kbd_xlatecode
kbd_ctrlcode:
	MOV     BX, offset CS:kbd_xlctrl
	JMP     kbd_xlatecode
kbd_normscan:
	MOV     BX, offset CS:kbd_xlnormal
	JMP     kbd_xlatescan
kbd_shiftscan:
	MOV     BX, offset CS:kbd_xlshift
	JMP     kbd_xlatescan
kbd_ctrlscan:
	MOV     BX, offset CS:kbd_xlctrl
	JMP     kbd_xlatescan
kbd_altscan:
	MOV     BX, offset CS:kbd_xlalt
	JMP     kbd_xlatescan

; Dispatch table entry points ****************************************

	; on entry AL contains shift status, AH is scan code

	; Alphabetic keys (affected by Caps Lock and Shift)

kbd_tr_alpha:
	TEST    AL, k_alt
	JNZ     kbd_altscan
	TEST    AL, k_ctrl
	JNZ     kbd_ctrlcode
	TEST    AL, k_lsh + k_rsh + k_capslock
	JPO     kbd_shiftcode
	JMP     kbd_normcode

	; Punctuation ( affected only by shift )

kbd_tr_punct:
	TEST    AL, k_alt
	JNZ     kbd_altscan
	TEST    AL, k_ctrl
	JNZ     kbd_ctrlcode
	TEST    AL, k_lsh + k_rsh
	JPO     kbd_shiftcode
	JMP     kbd_normcode

	; Function keys ( always generate scan code + 00 )

kbd_tr_funct:
	TEST    AL, k_alt
	JNZ     kbd_altscan
	TEST    AL, k_ctrl
	JNZ     kbd_ctrlscan
	TEST    AL, k_lsh + k_rsh
	JPO     kbd_shiftscan
	JMP     kbd_normscan

	; Numeric keypad (affected by NumLock, E0 bytes and Shift)
	; This also includes the extended keys on an extended kbd.

kbd_tr_numkey:
	TEST    KBD_miscstat, 2         ; If extended 'E0' key, it is
	JZ	kbd_numkey_1            ; only sensitive to Ctrl
	TEST    AL, k_ctrl
	JNZ     kbd_ctrlscan		; Ctrl-E0 (cursor) keys
	JMP	kbd_numkey_2

kbd_numkey_1:				; Non-E0 (numeric keypad) keys
	TEST    AL, k_alt
	JNZ     kbd_tr_alt_num		; Alt-numeric keypad
	TEST    AL, k_ctrl
	JNZ     kbd_ctrlscan		; Ctrl-numeric keypad
	TEST    AL, k_lsh + k_rsh + k_numlock
	JPO     kbd_shiftcode		; Shift or numlocked keys

kbd_numkey_2:
	CMP     AH, 052h                ;Check for insert key
	JNE     kbd_normscan
	XOR     [KBD_shifts], k_insert  ;If so, toggle insert status
	JMP     kbd_normscan

kbd_tr_alt_num:
	MOV     BX, offset CS:kbd_xlalt
	MOV     AL, AH                  ;Translation table holds decimal
	XLAT    CS:[BX]                 ;value
	MOV     BH, AL
	MOV     AL, 10
	MUL     [KBD_altvalue]
	ADD     AL, BH
	MOV     [KBD_altvalue], AL
	JMP     kbd_isr_exit

kbd_tr_delkey:
	TEST    AL, k_alt               ;If alt not down, treat as numkey
	JZ      kbd_tr_numkey
	TEST    AL, k_ctrl              ;If ctrl not down, ignore
	JNZ     kbd_ctrl_alt_del
	JMP     kbd_isr_exit

kbd_ctrl_alt_del:
	CLI
	CALL	kbd_ack_interrupt

	MOV     [SYS_warmboot], 01234h
	XOUT    HPC_Cmd_Port, HPC_RESET_ACK ; Stop ARM trying to suspend us
;       IN      AL, IO_SYS_Reset        ;Hard reset if SCAMP obliges
	DB      0EAH, 0F0H, 0FFH, 00H, 0F0H     ;Jump to reset code

; Shift, ctrl and alt keys *******************************************

kbd_shiftkey_down:
	MOV     AL, AH
	MOV     BX, offset CS:kbd_xlalt ;Translation table holds
	XLAT    CS:[BX]                 ;shift bit value
	OR      [KBD_shifts], AL
	JMP     kbd_isr_exit

kbd_shiftkey_up:
	MOV     AL, AH
	AND     AL, 07FH
	MOV     BX, offset CS:kbd_xlalt
	XLAT    CS:[BX]
	NOT     AL
	AND     [KBD_shifts], AL
	JMP     kbd_isr_exit

kbd_altkey_up:
	AND     [KBD_shifts], NOT k_alt
	MOV     AL, [KBD_altvalue]
	MOV     AH, 0
	CMP     AL, 0
	JE      kbd_chkLED_exit		; Normal alt-key up.
	JMP     kbd_isr_insert		; Check LEDs for debug purposes

	; Caps lock, scroll lock and num lock *********************

kbd_shiftkey_toggle:
	TEST    AL, k_ctrl              ;Not active when ctrl down
	JNZ     kbd_chkLED_exit

	MOV     AL, AH
	MOV     BX, offset CS:kbd_xlalt ;Table entry holds bit
	XLAT    CS:[BX]                 ;position of shift flag
	XOR     [KBD_shifts], AL
kbd_chkLED_exit:
	call	iack_set_LEDs		; Ack int & set LEDs
	JMP	kbd_isr_return

	; Print screen, pause & break **********************************

kbd_printscr_key:			; Also known as '*' on keypad
	TEST    AL, k_lsh + k_rsh	; If not shifted, treat as normal
	JNZ     kbd_do_printscr		; numeric-keypad key
	JMP     kbd_tr_punct

kbd_numlock_key:			; Ctrl-Numlock enters pause state
	TEST	AL, k_ctrl
	JNZ	kbd_do_pause		; If ctrl not down, treat as normal
	JMP	kbd_shiftkey_toggle	; 'toggle'-type shift key.

kbd_scrlock_key:			; Control-scroll lock is the
	TEST    AL, k_ctrl		; same as control-break.
	JNZ     kbd_do_ctrlbreak
	JMP     kbd_shiftkey_toggle

	; ************************

kbd_do_printscr:
	CALL	iack_set_LEDs		; Update LED state, ack interrupts

	INT     05h                     ;Print screen
	JMP     kbd_isr_return          ;exit with no EOI

	; ************************

kbd_do_pause:
	OR	KBD_xshifts, 08h	;Set 'pause state' flag
	CALL	iack_set_LEDs		; Re-enable ints, etc

kbd_pausewait:
	TEST	KBD_xshifts, 08h
	JNZ	kbd_pausewait	

	AND	KBD_shifts, NOT k_ctrl	; Reset Ctrl state (Ctrl-up code
	JMP	kbd_isr_return		; will be gobbled while we wait!)

	; ************************

kbd_do_ctrlbreak:
	CALL	iack_set_LEDs

	MOV     BX, KBD_bufstart        ;Clear keyboard buffer
	MOV     KBD_inptr, BX
	MOV     KBD_outptr, BX
	OR      KBD_break, 080H         ;Set break flag
	INT     1Bh                     ;Ctrl-Break vector
	JMP     kbd_isr_return

	; ************************

kbd_extendE0:                           ;Called for a key code of E0h
					;Simply set 'miscstat' & return
	OR      KBD_miscstat, 2
	JMP     kbd_isr_exitxtd

	; ************************

kbd_ACKrcvd:				; Called when ACK returned from
					; keyboard unit.
	OR	KBD_LEDstat, 10h	; Set 'ACK received' bit
	JMP	kbd_isr_exitxtd

; Data tables for keyboard *********************************************

	; Scan code dispatch table

kbd_scantable:
	DB      10H,19H
	DW      kbd_tr_alpha    
	DB      1EH,26H
	DW      kbd_tr_alpha    
	DB      2CH,32H
	DW      kbd_tr_alpha    

	DB      47H,49H                 ; Home, Up, PageUp
	DW      kbd_tr_numkey
	DB      4BH,4DH                 ; Left, '5', Right
	DW      kbd_tr_numkey
	DB      4FH,52H                 ; End, Down, PageDown, Insert
	DW      kbd_tr_numkey
	DB      53H,53H                 ; Del key (special Ctrl-Alt-Del)
	DW      kbd_tr_delkey

	DB      3BH,44H
	DW      kbd_tr_funct

	DB      1DH,1DH
	DW      kbd_shiftkey_down
	DB      2AH,2AH
	DW      kbd_shiftkey_down
	DB      36H,36H
	DW      kbd_shiftkey_down
	DB      38H,38H
	DW      kbd_shiftkey_down

	DB      3AH,3AH
	DW      kbd_shiftkey_toggle

	DB      45H,45H		;45h may be Num Lock or pause
	DW      kbd_numlock_key

	DB      46H,46H         ;46h may be Scroll Lock or break
	DW      kbd_scrlock_key

	DB      37H, 37H        ;37h may be 'Print Screen' or *
	DW      kbd_printscr_key

	DB      01H,056H
	DW      kbd_tr_punct

	DB	057H, 058H	;Function keys 11 and 12
	DW	kbd_tr_funct

				;Release codes for shift keys
	DB      9DH,9DH
	DW      kbd_shiftkey_up
	DB      0AAH,0AAH
	DW      kbd_shiftkey_up
	DB      0B6H,0B6H
	DW      kbd_shiftkey_up
	DB      0B8H,0B8H
	DW      kbd_altkey_up

	DB      0E0H,0E1H
	DW      kbd_extendE0

	DB	0FAH,0FAH
	DW	kbd_ACKrcvd

	DB	0FEH,0FEH	;Ignore NAK codes from keyboard
	DW	kbd_isr_exitxtd
				;Last entry - ignore anything not caught
				;so far
	DB      0H, 0FFH
	DW      kbd_isr_exit

	; Scan code translation tables

kbd_xlnormal:

	DB 0FFh, 01Bh, "1234567890-=", 08h, 09h                 ;0-F
	DB "qwertyuiop[]", 0Dh, 0FFh, "as"                      ;10-1F
	DB "dfghjkl;'`", 0FFh, "\zxcv"                          ;20-2F
	DB "bnm,./", 0FFh,"*",0FFh," ", 0FFh                    ;30-3A
	DB 3Bh,3Ch,3Dh,3Eh,3Fh,40h,41h,42h,43h,44h              ;3B-44
	DB 0FFh,0FFh,47h,48h,49h,"-",4Bh,4Ch,4Dh,"+",4Fh        ;45-4F
	DB 50h,51h,52h,53h,0FFh,0FFh,"\",085h,086h              ;50-58

kbd_xlshift:

	DB 0FFh, 1Bh, "!@#$%^&*()_+", 08h, 00h  ;0-F
	DB "QWERTYUIOP{}", 0Dh, 0FFh, "AS"                      ;10-1F
	DB "DFGHJKL:", 22h, "~", 0FFh, "|ZXCV"                  ;20-2F
	DB "BNM<>?", 0FFh,"*", 0FFh, " ", 0FFh                  ;30-3A
	DB 54h,55h,56h,57h,58h,59h,5Ah,5Bh,5Ch,5Dh              ;3B-44
	DB 0FFh,0FFh, "789-456+1"                               ;45-4F
	DB "230.", 0FFh, 0FFh, "|", 087h,088h                   ;50-58

kbd_xlctrl:

	DB 0FFh,01Bh,0FFh,000h,0FFh,0FFh,0FFh,01Eh              ;0-7
	DB 0FFh,0FFh,0FFh,0FFh,01Fh,0FFh,07Fh,094h              ;8-F
	DB 011h,017h,005h,012h,014h,019h,015h,009h              ;10-17
	DB 00Fh,010h,01Bh,01Dh,00Ah,0FFh,001h,013h              ;18-1F
	DB 004h,006h,007h,008h,00Ah,00Bh,00Ch,0FFh              ;20-27
	DB 000h,0FFh,0FFh,023h,01Ah,018h,003h,016h              ;28-2F
	DB 002h,00Eh,00Dh,0FFh,0FFh,0FFh,0FFh,0FFh              ;30-37
	DB 0FFh,020h,0FFh,05Eh,05Fh,060h,061h,062h              ;38-3F
	DB 063h,064h,065h,066h,067h,0FFh,0FFh,077h              ;40-47
	DB 08Dh,084h,08Eh,073h,08Fh,074h,090h,075h              ;48-4F
	DB 091h,076h,092h,093h,0FFh,0FFh,0FFh,089h,08Ah         ;50-58

kbd_xlalt:
	DB 0FFh,001h,078h,079h,07Ah,07Bh,07Ch,07Dh              ;0-7
	DB 07Eh,07Fh,080h,081h,082h,083h,0FFh,0A5h              ;8-F
	DB 010h,011h,012h,013h,014h,015h,016h,017h              ;10-17
	DB 018h,019h,01Ah,01Bh,01Ch,k_ctrl,01Eh,01Fh            ;18-1F
	DB 020h,021h,022h,023h,024h,025h,026h,027h              ;20-27
	DB 028h,0FFh,k_lsh,02Bh,02Ch,02Dh,02Eh,02Fh             ;28-2F
	DB 030h,031h,032h,033h,034h,035h,k_rsh,0FFh             ;30-37
	DB k_alt,039h,k_capslock,068h,069h,06Ah,06Bh,06Ch       ;38-3F
	DB 06Dh,06Eh,06Fh,070h,071h,k_numlock,k_scrlock,007h    ;40-47
	DB 008h,009h,04Ah,004h,005h,006h,04Eh,001h              ;48-4F
	DB 002h,003h,000h,0FFh,0FFh,0FFh,0FFh,08Bh,08Ch         ;50-58

; Ack_interrupt routine ***********************************************

	; This will re-enable the keyboard and send an acknowledge to
	; the 8259 PIC

kbd_ack_interrupt PROC NEAR
	MOV     AL, 20H                 ;Tell 8259 we've finished
	OUT     IO_PIC1_Ctrl, AL        ;with EOI command

	MOV	AL, 0AEh		;Re-enable keyboard command
	OUT	IO_Kbd_Cmd, AL
	RET
kbd_ack_interrupt ENDP

; Set_LEDs routine *************************************************

	; This will set the Scroll Lock, Caps lock, and Num lock LEDs
	; to the state given in KBD_Shifts. Trashes AX! This also
	; resets the 'E0 extended-key' bit, which just happens to be
	; common to all the places that call it.

	; In theory, we should wait for an ACK from the keyboard, but
	; we can skip this for the ARM.
	; This routine should not be reentered; to ensure this, the
	; keyboard controller is disabled.

iack_set_LEDs PROC NEAR
	MOV	AL, 20h			; Ack interrupts
	OUT	IO_PIC1_Ctrl, AL

	AND	KBD_miscstat, 0FDh	;Reset xtd-key status

key_set_LEDs:
	MOV	AL, 0ADh		; Disable keyboard irqs
	OUT	IO_Kbd_Cmd, AL

	MOV	AL, 0EDh		; 0EDh is Keyboard command
					; (not 8042!) to change LEDs
	OUT	IO_Kbd_Data, AL

	MOV	AL, [KBD_Shifts]	;LED status is in bits 4..6
					; 4=ScrLock, 5=Num, 6=Caps 
	SHR	AL, 4			;Convert to bits 0..2
	AND	AL, 7
	OUT	IO_Kbd_Data, AL

	AND	[KBD_LEDstat], 0F8h
	OR	[KBD_LEDstat], AL

	MOV	AL, 0AEh		; Re-enable keyboard ints
	OUT	IO_Kbd_Cmd, AL

	RET
iack_set_LEDs ENDP

; Beep routine **********************************************************

	; This uses a non-standard write of value 0DFh to port 64h
	; This is also used by the video BIOS

kbd_beep PROC NEAR
	PUSH	AX
	MOV	AL, 0DFh
	OUT	IO_Kbd_Cmd, AL
	POP	AX
	RET
kbd_beep ENDP

KBD_ISR ENDP

