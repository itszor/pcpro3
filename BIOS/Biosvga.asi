; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSVGA.ASI		New VGA BIOS routines
;
; Versions
; 0.1	19-02-91 INH	Original
; 1.15 	19-05-93 	Most functions done by 386
; 1.20a	23-08-93	RestoreBIOSstate bug fix
; *****************************************************************


; VGAI dispatch routines *********************************************
;
; This is an extension to BIOSVID.ASI, & contains VGA BIOS dispatch
; routines. Entry conditions are as follows
;
; AX, BX, CX, DX, SI, ES are as on entry to INT 10h
; [BP] points to a PUSHAframe structure which contains saved
;  register info. Changes made to this structure will be returned
;  to the INT 10h caller. When finished, jump to VIDI_Exit.
;

; General dispatcher **********************************************

VGAI_SearchDispatch PROC NEAR
	CMP	CS:[DI], AX
	JE	VGAI_SD_Got
	ADD	DI, 4
	CMP	word ptr CS:[DI], 0
	JNZ	VGAI_SearchDispatch
	RET

VGAI_SD_Got:
	JMP	CS:word ptr[DI+02h]

VGAI_SearchDispatch ENDP


VGAI_Fn10h PROC NEAR	; Function 10h Palette Functions *********************

	CMP	AL, 1Bh		; AL = subfunction in range 00-1Bh
	JA	VGAI_Fn10_X
	MOV	AH, 0
	MOV	DI, AX
	ADD	DI, AX		; Set DI=dispatch table index

	CALL	CS:VGAI_Fn10_tbl[DI]
VGAI_Fn10_X:
	JMP	VIDI_Exit

VGAI_Fn10_tbl	DW	VGAI_Fn1000h
		DW	VGAI_Fn1001h
		DW	VGAI_Fn1002h
		DW	VGAI_Fn1003h
		DW	VGAI_Fn10xx	; 04
		DW	VGAI_Fn10xx	; 05
		DW	VGAI_Fn10xx	; 06
		DW	VGAI_Fn1007h
		DW	VGAI_Fn1008h
		DW	VGAI_Fn1009h
		DW	VGAI_Fn10xx	; 0A
		DW	VGAI_Fn10xx	; 0B
		DW	VGAI_Fn10xx	; 0C
		DW	VGAI_Fn10xx	; 0D
		DW	VGAI_Fn10xx	; 0E
		DW	VGAI_Fn10xx	; 0F
		DW	VGAI_Fn1010h
		DW	VGAI_Fn10xx	; 11h
		DW	VGAI_Fn1012h
		DW	VGAI_Fn1013h
		DW	VGAI_Fn10xx	; 14h
		DW	VGAI_Fn1015h
		DW	VGAI_Fn10xx	; 16h
		DW	VGAI_Fn1017h
		DW	VGAI_Fn10xx	; 18h
		DW	VGAI_Fn10xx	; 19h
		DW	VGAI_Fn101Ah
		DW	VGAI_Fn101Bh

	; ------------------
VGAI_Fn10xx:	; Unused functions
	RET

	; ------------------

VGAI_Fn1000h:	; Set palette reg
	; BL = 'palette reg'; BH = colour
	MOV	AH, BL
	AND	AH, 0Fh		; AH = attrib reg (0-F)
	MOV	AL, BH
	CALL	VGAI_WriteAR
	RET

	; ------------------

VGAI_Fn1001h:	; Set border colour
	MOV	AH, 11h
	MOV	AL, BH
	CALL	VGAI_WriteAR
	RET

	; ------------------

VGAI_Fn1002h:	; Set whole palette/border
	; ES:DX points to a 17-byte buffer
	MOV	SI, DX		; ES:SI->table

	MOV	AH, 0h		; Initial address: AR0
	MOV	CX, 16		; Do 16 register
	CALL	VGAI_MultiWriteAR

	MOV	AH, 11h		; AR border colour reg.
	MOV	AL, ES:[SI]	; Send data
	CALL	VGAI_WriteAR
	RET

	; ------------------

VGAI_Fn1003h:	; Set intensity/blinking bit
	AND	BL, 1		; Corrected 21/6/94
	SHL	BL, 3		; Save BL = 1000 (blinking)/0000(intensity)

	MOV	AH, 10h		; Read AR10
	CALL	VGAI_ReadAR
	AND	AL, 11110111b	; Mask off old state
	OR	AL, BL		; Insert new state: 1 = blinking
	MOV	AH, 10h
	CALL	VGAI_WriteAR	; Rewrite AR10
	RET

	; ------------------

VGAI_Fn1007h:	; Read palette reg BL=reg to read
	MOV	AH, BL
	AND	AH, 0Fh		; AH = AR0..F
	CALL	VGAI_ReadAR	; Read register
	MOV	[BP].SavedBH, AL
	RET

	; ------------------

VGAI_Fn1008h:	; Read border colour
	MOV	AH, 011h
	CALL	VGAI_ReadAR
	MOV	[BP].SavedBH, AL
	RET

	; ------------------

VGAI_Fn1009h:	; Read whole palette/border
	MOV	DI, DX		; ES:DX -> 17-byte buffer for result

	MOV	AH, 0h		; Initial address = AR0
	MOV	CX, 16
	CALL	VGAI_MultiReadAR

	MOV	AH, 11h		; Select border colour register
	CALL	VGAI_ReadAR
	STOSB			; store in buffer
	RET

	; ------------------

VGAI_Fn1010h:	; Set DAC register
	; BX = colour register
	; DH, CH, CL = red, green, blue values

	MOV	BH, DH		; Save 'red' in BH

	MOV	DX, 03C8h	; Address DAC register 'BL'
	MOV	AL, BL
	OUT	DX, AL

	TEST	VID_VGActrl, 2	; Grey scaling?
	JZ	VGAI_1010_NoGrey
	CALL	VGA_SumToGrey	; If so, set BH, CH, CL to grey values
VGAI_1010_NoGrey:

	MOV	DX, 03C9h
	MOV	AL, BH		; Send 'red'
	OUT	DX, AL
	MOV	AL, CH		; Send 'green'
	OUT	DX, AL
	MOV	AL, CL		; Send 'blue'
	OUT	DX, AL
	RET

	; ------------------

VGAI_Fn1012h:	; Set DAC register block
	; BX = first DAC register
	; CX = number of registers
	; ES:DX = pointer to (R, G, B) values in table

	JCXZ	VGAI_1012_X	; If nothing to do, exit

	MOV	SI, DX		; ES:SI-> pointer to table

	CALL	VGA_SetDACblock	; ES:SI = pointer to block
				; BX = first colour
				; CX = no. of colours
VGAI_1012_X:
	RET

	; ------------------

VGAI_Fn1013h:	; Set colour page/paging mode
	CMP	BL, 01h		; BL = 01 to set page number
	JE	VGAI_1013_Page	; BL = 00 to set paging mode
	JA	VGAI_1013_X

	; Set paging mode: BH = 0 - set 4x64 block mode
	;		   BH = 1 - set 16x16 block mode

	MOV	BL, 0
	SHR	BX, 1		; BL = 10000000 for 16x16, 00000000 for 4x64
	MOV	AH, 10h		; Read AR10 (bit 7 is page status)
	CALL	VGAI_ReadAR
	AND	AL, 01111111b	; Mask off old state
	OR	AL, BL		; Insert new state: 1 = 16x16; 0 = 4x64
	MOV	AH, 10h
	CALL	VGAI_WriteAR
VGAI_1013_X:
	RET

	; Set palette page: BH = page number

VGAI_1013_Page:
	MOV	AH, 10h		; Read AR10
	CALL	VGAI_ReadAR
	TEST	AL, 80h		; Are we in 4x64 mode?
	JNZ	VGAI_1013_P16	; If so, page number must be shifted
	SHL	BH, 2		; up by 2
VGAI_1013_P16:
	
	MOV	AH, 14h		; Address AR14 = colour select reg
	MOV	AL, BH
	CALL	VGAI_WriteAR
	RET

	; ------------------

VGAI_Fn1015h:	; Read DAC register
	; On entry BX = register to read
	; On exit, DH = Red, CH=Green, CL=Blue

	MOV	DX, 03C7h	; Set DAC read colour address
	MOV	AL, BL
	OUT	DX, AX

	MOV	DX, 03C9h
	IN	AL, DX		; Read Red
	MOV	[BP].SavedDH, AL
	IN	AL, DX		; Read Green
	MOV	[BP].SavedCH, AL
	IN	AL, DX		; Read Blue
	MOV	[BP].SavedCL, AL
	RET

	; ------------------

VGAI_Fn1017h:	; Read DAC register block
	; BX = first one to read
	; CX = no. of regs to read
	; ES:DX = pointer to table

	JCXZ	VGAI_1017_X
	CLD
	MOV	DI, DX		; ES:DI->table

	MOV	DX, 03C7h	; Select table entry to read
	MOV	AL, BL
	OUT	DX, AL

	MOV	DX, 03C9h

VGAI_1017_Loop:
	INSB
	INSB
	INSB
	LOOP	VGAI_1017_Loop

VGAI_1017_X:
	RET

	; ------------------

VGAI_Fn101Ah:	; Read colour paging mode
	; Return BH = current colour page
	; Return BL = 00 for 4x64 mode, 01 for 16x16 mode

	MOV	AH, 14h
	CALL	VGAI_ReadAR	; Read AR14
	AND	AL, 0FH		; Get colour page number
	MOV	BH, AL		; Save in BH

	MOV	AH, 10h		; Read AR10
	CALL	VGAI_ReadAR	; AR10 bit 7 is '16x16' mode when set
	MOV	BL, 01

	TEST	AL, 80h		; Are we in 16x16 mode?
	JNZ	VGAI_101A_P16	; If so, skip
				; Else: 4x64 mode: page number must be shifted
	SHR	BH, 2		; down by 2
	MOV	BL, 00		; reflect 4x64 status
VGAI_101A_P16:
	
	MOV	[BP].SavedBX, BX	; Return value in BX
	RET

	; ------------------

VGAI_Fn101Bh:	; Sum DAC registers to grey.
	; BX = first reg
	; CX = no. of registers to sum
	JCXZ	VGAI_101B_X

VGAI_101B_Loop:

	MOV	DX, 03C7h	; Read DAC register 'BL'
	MOV	AL, BL
	OUT	DX, AL
	PUSH	CX
	PUSH	AX		; Save register number

	MOV	DX, 03C9h
	IN	AL, DX
	MOV	BH, AL		; Save 'Red' in BH
	IN	AL, DX
	MOV	CH, AL		; Save 'Blue' in CH
	IN	AL, DX
	MOV	CL, AL		; Save 'Green' in CL

	CALL	VGA_SumToGrey	; Sum to grey in BH/CH/CL
				; Trashes BL
	POP	AX

	MOV	DX, 03C8h	; Prepare to rewrite register
	OUT	DX, AL
	INC	AL
	MOV	BL, AL

	MOV	DX, 03C9h
	MOV	AL, BH		; Send 'red'
	OUT	DX, AL
	MOV	AL, CH		; Send 'green'
	OUT	DX, AL
	MOV	AL, CL		; Send 'blue'
	OUT	DX, AL
	POP	CX
	LOOP	VGAI_101B_Loop

VGAI_101B_X:
	RET



VGAI_Fn10h ENDP



VGAI_Fn11h PROC NEAR	; Function 11h Character generator *******************

	MOV	DI, offset CS:VGAI_11tbl
	CALL	VGAI_SearchDispatch
	JMP	VIDI_Exit

	; ---------------------

VGAI_11tbl 	DW	1130h, VGAI_Fn1130h
	DW	1100h, VGAI_Fn1100h
	DW	1101h, VGAI_Fn1101h
	DW	1102h, VGAI_Fn1102h
	DW	1103h, VGAI_Fn1103h
	DW	1104h, VGAI_Fn1104h

	DW	1110h, VGAI_Fn1110h
	DW	1111h, VGAI_Fn1111h
	DW	1112h, VGAI_Fn1112h
	DW	1114h, VGAI_Fn1114h

	DW	1120h, VGAI_Fn1120h
	DW	1121h, VGAI_Fn1121h
	DW	1122h, VGAI_Fn1122h
	DW	1123h, VGAI_Fn1123h
	DW	1124h, VGAI_Fn1124h
	DW	0

	; Load-font, no reprogram functions -----------------------------

	; Set user font:
	; BH = char height, BL = block number
	; DX = first char to load CX = no. of chars to load
	; ES:SavedBP = pointer to table.
VGAI_Fn1100h:
	MOV	SI, [BP].SavedBP
	CMP	BH, 0
	JE	VGAI_Fn1100e
	JCXZ	VGAI_Fn1100e
	CALL	VGAI_LoadFont
VGAI_Fn1100e:
	RET

VGAI_Fn1101h:  ; Load EGA 14-line font BL = block no.
	MOV	SI, offset CS:VID_8x14Font
	MOV	BH, 14
	JMP	VGAI_Fn110Xh

VGAI_Fn1102h:  ; Load CGA 8-line font BL = block no.
	MOV	SI, offset CS:VID_CGAFontLo
	MOV	BH, 8
	JMP	VGAI_Fn110Xh

VGAI_Fn1104h:  ; Load VGA 16-line font BL = block no.
	MOV	SI, offset CS:VID_8x16Font
	MOV	BH, 16
VGAI_Fn110Xh:
	MOV	AX, CS
	MOV	ES, AX
	MOV	DX, 0
	MOV	CX, 256
	CALL	VGAI_LoadFont
	RET	

	; Load font & reprogram functions ------------------------

	; Set user font:
	; BH = char height, BL = block number
	; DX = first char to load CX = no. of chars to load
	; ES:SavedBP = pointer to table.
VGAI_Fn1110h:
	MOV	SI, [BP].SavedBP
	CMP	BH, 0
	JE	VGAI_Fn1110_X
	CALL	VGAI_SetTextHeight

	MOV	BX, [BP].SavedBX
	MOV	CX, [BP].SavedCX
	MOV	DX, [BP].SavedDX
	MOV	SI, [BP].SavedBP
	MOV	ES, [BP].SavedES
	CALL	VGAI_LoadFont
	CALL	MOU_ModeChange
VGAI_Fn1110_X:
	RET

VGAI_Fn1111h:  ; Load EGA 14-line font BL = block no.
	MOV	SI, offset CS:VID_8x14Font
	MOV	BH, 14
	JMP	VGAI_Fn111Xh

VGAI_Fn1112h:  ; Load CGA 8-line font BL = block no.
	MOV	SI, offset CS:VID_CGAFontLo
	MOV	BH, 8
	JMP	VGAI_Fn111Xh

VGAI_Fn1114h:  ; Load VGA 16-line font BL = block no.
	MOV	SI, offset CS:VID_8x16Font
	MOV	BH, 16
VGAI_Fn111Xh:
	PUSH	SI
	PUSH	BX
	CALL	VGAI_SetTextHeight
	POP	BX
	POP	SI

	MOV	AX, CS
	MOV	ES, AX
	MOV	DX, 0
	MOV	CX, 256
	CALL	VGAI_LoadFont
	CALL	MOU_ModeChange
	RET	

	; Graphics font functions -------------------------

VGAI_Fn1120h:	; Set Int 1Fh to ES:BP
	LES	DI, CS:VGAI_1Faddress
	MOV	AX, [BP].SavedBP
	MOV	ES:[DI], AX
	MOV	AX, [BP].SavedES
	MOV	ES:[DI+2], AX
	RET

VGAI_Fn1121h:
	MOV	SI, [BP].SavedBP
	MOV	AX, ES
	JMP	VGAI_Fn112X

VGAI_Fn1122h:
	MOV	SI, offset CS:VID_8x14Font
	MOV	AX, CS
	MOV	CX, 14
	JMP	VGAI_Fn112X

VGAI_Fn1123h:
	MOV	SI, offset CS:VID_CGAFontLo
	MOV	AX, CS
	MOV	CX, 8
	JMP	VGAI_Fn112X

VGAI_Fn1124h:
	MOV	SI, offset CS:VID_8x16Font
	MOV	AX, CS
	MOV	CX, 16

VGAI_Fn112X:	; Set graphics font - BL/DL = rows specifier
		; AX:SI = font pointer, CX = char height

	LES	DI, CS:VGAI_43address	; Store font pointer at Int 43h
	MOV	ES:[DI], SI		; address
	MOV	ES:[DI+2], AX
	MOV	VID_charheight, CL
	
	CMP	BL, 0			; BL = # of rows specifier - 
	JE	VGAI_112X_Height	; 00->DL, 01->14, 02->25, 03->43
	CMP	BL, 2
	MOV	DL, 25
	JE	VGAI_112X_Height
	MOV	DL, 14
	JB	VGAI_112X_Height
	MOV	DL, 43
VGAI_112X_Height:
	DEC	DL
	MOV	VID_lastrow, DL
	RET		
	
	; Misc functions  ---------------------------------

VGAI_Fn1103h:	; Set text block select to BL
	MOV	DX, IO_VGA_SeqRegs		; Set SR3 = char map select reg
	MOV	AL, SR_CharMap
	MOV	AH, BL
	AND	AH, 03Fh
	OUT	DX, AX
	RET

VGAI_Fn1130h:	; Get char. generator pointer
	CMP	BH, 07h
	JA	VGAI_1130_X

	MOV	AL, VID_charheight
	CBW
	MOV	[BP].SavedCX, AX
	MOV	AL, VID_lastrow
	MOV	[BP].SavedDL, AL

	; BH=00..01 - get fonts from Int vectors

	CMP	BH, 01h
	JB	VGAI_1130_Get1F
	JE	VGAI_1130_Get43

	; BH=02..07 - get fonts from table

	MOV	BL, BH
	AND	BX, 7
	ADD	BX, BX
	MOV	AX, CS:VGAI_FontPtrTbl[BX]
	MOV	[BP].SavedBP, AX
	MOV	[BP].SavedES, CS
VGAI_1130_X:
	RET	

VGAI_1130_Get1F:
	LES	DI, CS:VGAI_1Faddress
	MOV	AX, ES:[DI]
	MOV	[BP].SavedBP, AX
	MOV	AX, ES:[DI+2]
	MOV	[BP].SavedES, AX
	RET

VGAI_1130_Get43:
	LES	DI, CS:VGAI_43address
	MOV	AX, ES:[DI]
	MOV	[BP].SavedBP, AX
	MOV	AX, ES:[DI+2]
	MOV	[BP].SavedES, AX
	RET

VGAI_Fn11h ENDP

VGAI_1Faddress	DD 0000007Ch		; Int 1Fh address
VGAI_43address	DD 0000010Ch		; Int 43h address

VGAI_FontPtrTbl	DW 0, 0, VID_8x14Font, VID_CGAFontLo
		DW VID_CGAFontHi, VID_8x14Font, VID_8x16Font, VID_8x16Font
	

VGAI_Fn12h PROC NEAR	; Function 12h Alternate Select **********************

	XCHG	AL, BL		; BL contains subfunction; AL = value
	MOV	[BP].SavedAL, 00h	; Indicate 'not supported' by default

	MOV	DI, offset CS:VGAI_12tbl
	CALL	VGAI_SearchDispatch
	JMP	VIDI_Exit

	; ---------------------

VGAI_12tbl DW	1210h, VGAI_Fn1210h
	DW	1220h, VGAI_Fn1220h
	DW	1230h, VGAI_Fn1230h
	DW	1231h, VGAI_Fn1231h
	DW	1232h, VGAI_Fn1232h
	DW	1233h, VGAI_Fn1233h
	DW	1234h, VGAI_Fn1234h
	DW	1235h, VGAI_Fn1235h
	DW	1236h, VGAI_Fn1236h
	DW	0

	; ---------------------

VGAI_Fn1210h:	; Get current video configuration

	MOV	BH, 0			; BH = 0 if colour mode
	CMP	VID_CRTCport, 03D0h	; BH = 1 if mono mode
	JAE	VGAI_1210_1
	MOV	BH, 1
VGAI_1210_1:
	MOV	BL, VID_ctrlbits	; BL = memory size
	SHR	BL, 5			; (0=64K, 1=128K, 2=192K, 3=256K)
	AND	BL, 3

	MOV	CH, 0h			; Feature Control Reg (??)
	MOV	CL, VID_switches

	MOV	[BP].SavedAL, 03h	; Return AX = 1203 (why??)
	MOV	[BP].SavedBX, BX
	MOV	[BP].SavedCX, CX
	RET

	; ---------------------

VGAI_Fn1220h:	; Alternate print-screen handler : NOT SUPPORTED
	RET

	; ---------------------

VGAI_Fn1230h:	; Set scan-lines for next mode set
		; BL = old AL value = 00 for 200 lines, 01 for 350 lines
		; or 02 for 400 lines

	MOV	AH, 01101111b
	MOV	AL, 10000000b		; BL = 0 ?
	OR	BL, BL			; set 200 lines
	JZ	VGAI_123X_ctrlbits

	MOV	AL, 00000000b		; BL = 1 ?
	DEC	BL			; Set 350 lines
	JZ	VGAI_123X_ctrlbits

	MOV	AL, 00010000b		; BL = 2 ?
	DEC	BL			; Set 400 lines
	JZ	VGAI_123X_ctrlbits
	RET				; Else: return unchanged

VGAI_123X_ctrlbits:
	AND	AH, VID_VGActrl		; VID_VGActrl = (VID_VGActrl AND AH)
	OR	AL, AH			;	OR AL
	MOV	VID_VGActrl, AL
	MOV	[BP].SavedAL, 012h	; Show function is supported
	RET

	; ---------------------

VGAI_Fn1231h:	; Enable/disable palette load during mode set
	MOV	AH, 11110111b		; Mask for VID_VGActrl
	MOV	AL, 0
	OR	BL, BL			; BL = 0 : enable pal. load
	JZ	VGAI_123X_ctrlbits

	MOV	AL, 00001000b
	DEC	BL			; BL = 1 : disable pal. load
	JZ	VGAI_123X_ctrlbits

	RET

	; ---------------------

VGAI_Fn1232h:	; Enable / disable video : NOT SUPPORTED
	RET

	; ---------------------

VGAI_Fn1233h:	; Enable / disable grey scale summing
	MOV	AH, 11111101b
	MOV	AL, 00000010b
	OR	BL, BL			; BL = 0 : enable grey scale
	JZ	VGAI_123X_ctrlbits

	MOV	AL, 0
	DEC	BL			; BL = 1 : disable video
	JZ	VGAI_123X_ctrlbits
	RET

	; ---------------------

VGAI_Fn1234h:	; Enable / disable cursor emulation
	CMP	BL, 01h			; If BL > 1, exit unchanged
	JA	VGAI_1234_X		; BL = 0: enable emulation
	AND	VID_ctrlbits, 11111110b	; BL = 1: disable emulation
	OR	VID_ctrlbits, BL
	MOV	[BP].SavedAL, 012h
VGAI_1234_X:
	RET

	; ---------------------

VGAI_Fn1235h:	; Switch video display : !Incomplete! NOT SUPPORTED
	RET

	; ---------------------

VGAI_Fn1236h:	; Enable /disable video
	MOV	AH, 020h
	OR	BL, BL			; BL = 0 : enable video
	JZ	VGAI_1236_X

	MOV	AH, 0
	DEC	BL			; BL = 1 : disable video
	JZ	VGAI_1236_X
	RET

VGAI_1236_X:
	MOV	DX, VID_CRTCport	; Read from port 3DA/3BA
	ADD	DX, 6
	IN	AL, DX			; Ensure 3C0h = attrib address
	MOV	AL, AH
	MOV	DX, 03C0h		; Set attrib controller address
	OUT	DX, AL			; bit 5 = enable video
	MOV	[BP].SavedAL, 012h
	RET

VGAI_Fn12h ENDP



VGAI_Fn1Ah PROC NEAR	; Function 1Ah Get/Set DCC ***************************

	MOV	DI, offset CS:VGAI_1Atbl
	CALL	VGAI_SearchDispatch
	JMP	VIDI_Exit

VGAI_1Atbl DW	1A00h, VGAI_Fn1A00h
	DW 	1A01h, VGAI_Fn1A01h
	DW 	0

VGAI_Fn1A00h:
	MOV	[BP].SavedAL, 1Ah	; Show it's supported
	MOV	[BP].SavedBX, 0008h	; Primary = colour VGA, Second=none
	RET

VGAI_Fn1A01h:		; AH = 1A, AL=01: Set DCC: IGNORE IT!!
	MOV	[BP].SavedAL, 1Ah
	RET

VGAI_Fn1Ah	ENDP



VGAI_Fn1Bh:	; Function 1Bh ***************************************

	; Return functionality/state information

	; On entry, BX must be 0000, else return with AX=1B00h
	; ES:DI points to a 40-byte buffer of info to be filled in
	; It seems this is not expected to work in SVGA mode; we
	; just return sensible default values.

	CMP	BX, 0
	JE	VGAI_FI_1
	MOV	[BP].SavedAL, 00h
	JMP	VIDI_Exit

VGAI_FI_1:
	CLD
	MOV	DI, [BP].SavedDI		; ES:DI = pointer to table
	MOV	AX, offset CS:StaticFuncTbl     ; First entry is a
	STOSW
	MOV	AX, CS			  	; pointer to static
	STOSW					; functionality table

						; Next 30 bytes are
						; copied from BIOS data
	MOV	SI, offset DS:VID_mode		; area 49h-66h
	MOV	CX, 15
	REP	MOVSW

	MOV	AL, VID_lastrow
	INC	AL
	STOSB					; ES:[DI+22h]

	MOV	AL, VID_charheight
	MOV	AH, 0
	STOSW					; ES:[DI+23h]

	MOV	AX, 8				; Active Display = VGA
	STOSB					; ES:[DI+25h]

	MOV	AX, 0				; Inactive display = nothing
	STOSB					; ES:[DI+26h]

	MOV	BL, VID_mode			; If mode > 13h
	MOV	BH, 0				; use 14h'th entry
	CMP	BL, 13h				; in lookup tables
	JBE	VGAI_1Bh_1
	MOV	BL, 14h
VGAI_1Bh_1:
						; Calculate no. of colours
	MOV	AL, CS:ColoursInMode[BX]	; in current mode
	MOV	AH, 0
	INC	AX
	STOSW					; ES:[DI+27h]

	MOV	AL, CS:PagesInMode[BX]		; in current mode
	STOSB					; ES:[DI+29h]

	MOV	AL, CS:LinesInMode[BX]		; scan lines in current mode
	CMP	AL, 3				; If its 0..3, use it
	JBE	VGAI_1Bh_2			; direct

	MOV	AL, 2				; '400 lines' code
	TEST	VID_VGActrl, 10h
	JNZ	VGAI_1Bh_2

	MOV	AL, 0				; '200 lines' code
	TEST	VID_VGActrl, 80h
	JNZ	VGAI_1Bh_2

	MOV	AL, 1				; '350 lines' code
VGAI_1Bh_2:
	STOSB					; ES:[DI+2Ah]

	MOV	AL, 0				; Primary character block
	STOSB					; ES:[DI+2Bh]

	MOV	AL, 0				; Second character block
	STOSB					; ES:[DI+2Ch]

	MOV	AL, 00010001b			; Misc state info
	STOSB					; ES:[DI+2Dh]

	ADD	DI, 3				; Reserved

	MOV	AL, 00000011b			; Video memory = 256K
	STOSB					; ES:[DI+31h]

	MOV	AL, 00000000b			; Save Pointer State info
	STOSB					; ES:[DI+32h]

	MOV	[BP].SavedAL, 01Bh
	JMP	VIDI_Exit



VGAI_Fn1Ch: ; Function 1Ch **************************************

	; Save/Restore video state

	; This has been expanded to include saving/restoring the
	; VESA extension state (CX bit 3). This particular entry
	; point will prevent this from happening, but the SVGA BIOS
	; bits will call the routines to do it.

	MOV	[BP].SavedAL, 0h
	MOV	DI, offset CS:VGAI_1Ctbl
	AND	CX, 7
	CALL	VGAI_SearchDispatch
	JMP	VIDI_Exit

VGAI_1Ctbl DW	1C00h, VGAI_Fn1C00h
	DW 	1C01h, VGAI_Fn1C01h
	DW 	1C02h, VGAI_Fn1C02h
	DW 	0

	; Table of save buffer sizes (in 64-byte blocks) for the
	; various save/restore options

HDR_SIZE	equ 20h
REGS_SIZE	equ 46h
BIOS_SIZE	equ 26h
DAC_SIZE	equ 304h
VESA_SIZE	equ 4h

SaveSize DW 0
	DW HDR_SIZE + REGS_SIZE
	DW HDR_SIZE +             BIOS_SIZE
	DW HDR_SIZE + REGS_SIZE + BIOS_SIZE
	DW HDR_SIZE +                       + DAC_SIZE
	DW HDR_SIZE + REGS_SIZE             + DAC_SIZE
	DW HDR_SIZE +             BIOS_SIZE + DAC_SIZE
	DW HDR_SIZE + REGS_SIZE + BIOS_SIZE + DAC_SIZE
	DW HDR_SIZE +                                  + VESA_SIZE
	DW HDR_SIZE + REGS_SIZE                        + VESA_SIZE
	DW HDR_SIZE +             BIOS_SIZE            + VESA_SIZE
	DW HDR_SIZE + REGS_SIZE + BIOS_SIZE            + VESA_SIZE
	DW HDR_SIZE +                       + DAC_SIZE + VESA_SIZE
	DW HDR_SIZE + REGS_SIZE             + DAC_SIZE + VESA_SIZE
	DW HDR_SIZE +             BIOS_SIZE + DAC_SIZE + VESA_SIZE
	DW HDR_SIZE + REGS_SIZE + BIOS_SIZE + DAC_SIZE + VESA_SIZE

VGAI_Fn1C00h PROC NEAR	; Get buffer size for save op ------------
	; On entry - CX = bit set of things to save/restore
	; On exit AX=[BP].SavedBX=size of buffer
	MOV	DI, CX
	ADD	DI, DI
	MOV	AX, CS:SaveSize[DI]
	ADD	AX, 63			; Round up
	SHR	AX, 6			; Convert to 64-byte chunks
	MOV	[BP].SavedBX, AX
	MOV	[BP].SavedAL, 1Ch
	RET
VGAI_Fn1C00h ENDP


VGAI_Fn1C01h PROC NEAR	; Save video state ------------------------

	; ES:BX points to a save buffer
	; CX bit 0 is set to save hardware state
	;	 1 is set to save BIOS state
	;	 2 is set to save DAC state
	; BP points to a saved reg. state, 
	; 

	CLI
	MOV	DI, BX
	ADD	DI, 020h

	TEST	CL, 1			; Save hardware state?
	JZ	VGA_1C01_1

	MOV	ES:[BX+0], DI
	PUSH	CX
	CALL	SaveHardState
	POP	CX
VGA_1C01_1:

	TEST	CL, 2			; Save BIOS state?
	JZ	VGA_1C01_2

	MOV	BX, [BP].SavedBX
	MOV	ES:[BX+2], DI
	PUSH	CX
	CALL	SaveBIOSState
	POP	CX
VGA_1C01_2:

	TEST	CL, 4			; Save DAC state?
	JZ	VGA_1C01_3

	MOV	BX, [BP].SavedBX
	MOV	ES:[BX+4], DI
	PUSH	CX
	CALL	SaveDACState
	POP	CX
VGA_1C01_3:

	TEST	CL, 8			; Save VESA state?
	JZ	VGA_1C01_4

	MOV	BX, [BP].SavedBX
	MOV	ES:[BX+6], DI		; Field invented by us
	PUSH	CX
	CALL	SVGA_SaveRegs
	POP	CX
VGA_1C01_4:

	MOV	[BP].SavedAL, 1Ch
	RET

VGAI_Fn1C01h ENDP


VGAI_Fn1C02h PROC NEAR	; Restore video state ---------------------

	; ES:BX points to a save buffer
	; CX bit 0 is set to restore hardware state
	;	 1 is set to restore BIOS state
	;	 2 is set to restore DAC state
	; BP must be a saved register struct on the stack as above

	CLI

	TEST	CL, 2			; Restore BIOS state?
	JZ	VGA_1C02_2

	MOV	DI, ES:[BX+2]
	PUSH	CX
	CALL	RestoreBIOSState
	POP	CX
VGA_1C02_2:

	TEST	CL, 4			; Restore DAC state?
	JZ	VGA_1C02_3

	MOV	BX, [BP].SavedBX
	MOV	DI, ES:[BX+4]
	PUSH	CX
	CALL	RestoreDACState
	POP	CX
VGA_1C02_3:

	TEST	CL, 1			; Restore hardware state?
	JZ	VGA_1C02_1

	MOV	BX, [BP].SavedBX
	MOV	DI, ES:[BX+0]
	PUSH	CX
	CALL	RestoreHardState
	POP	CX
VGA_1C02_1:

	TEST	CL, 8			; Restore VESA hardware state?
	JZ	VGA_1C02_4

	MOV	BX, [BP].SavedBX
	MOV	DI, ES:[BX+6]		; Field invented by us
	PUSH	CX
	CALL	SVGA_RestoreRegs
	POP	CX
VGA_1C02_4:

	MOV	[BP].SavedAL, 1Ch
	RET

VGAI_Fn1C02h ENDP	

; Save/Restore subroutines **********************************************

CMiscRegsTbl	DW	03C4h, 03D4h, 03CEh, 03C0h, 03CAh, 0
MMiscRegsTbl	DW	03C4h, 03B4h, 03CEh, 03C0h, 03CAh, 0

SaveHardState PROC NEAR
	; Enter with ES:DI = buffer to save
	; Must leave  ES:DI pointing to next byte
	; after saved block

	MOV	DX, 03CCh			; Read Misc Out reg
	IN	AL, DX				; bit 0 set if CRTC=3Dx
	MOV	ES:[DI+09h], AL			; blk[9] = Misc Out Reg

	MOV	SI, offset CS:MMiscRegsTbl	; Set 'Mono or Colour'
	MOV	DX, 03B4h			; according to MiscOut reg
	TEST	AL, 1				; (bit0 = 0 for mono)
	JZ	SHS_1

	MOV	SI, offset CS:CMiscRegsTbl	; Save 'colour' regs
	MOV	DX, 03D4h
SHS_1:						
	MOV	ES:[DI+40h], DX			; CRTC base address

	ADD	DX, 6				; Read 3BAh or 3DAh to
	IN	AL, DX				; ensure 3C0 is AR index
	
						; Save SR index, CR index
	CALL	VGAI_MultiRead			; GR index, AR index,
						; FeatureCtrl at
						; blk[0..4]

	MOV	DX, 03C4h			; Sequencer Regs:
	MOV	AH, 1h				; Save SR1..SR4
	MOV	CX, 4h
	CALL	VGAI_MultiReadGR		; at blk[5..8]
	
	INC	DI
	MOV	DX, ES:[DI+36h]			; retrieve CRTC base addr

	MOV	AH, 0h				; CRTC regs
	MOV	CX, 19h				; Save CR0-CR18
	CALL	VGAI_MultiReadGR		; at blk[0A..22]

	MOV	AH, 0h				; Attribute regs
	MOV	CX, 14h				; AR0-13
	CALL	VGAI_MultiReadAR		; at blk[23..36]

	MOV	DX, 03CEh			; Graphics controller regs
	MOV	AH, 0h				; Save GR0-GR8
	MOV	CX, 9h
	CALL	VGAI_MultiReadGR		; at blk [37..40]

	ADD	DI, 2				; CRTC port

	MOV	AX, 0				; VGA system latches
	STOSW					; !Incomplete!
	STOSW

	RET

SaveHardState ENDP

	; --------------------------

SaveBIOSState PROC NEAR
	; Enter with ES:DI = buffer to save
	; Must ES & leave DI pointing to next byte
	; after saved block
	CLD				; BIOS video state is:

	MOV	AL, 20h			; Don't know why!
	STOSB

	MOV	SI, offset DS:VID_mode	; 30 bytes from 40:49h-40:66h
	MOV	CX, 15
	REP	MOVSW

	MOV	SI, offset DS:VID_lastrow ; 7 bytes from 40:84h-40:8Ah
	MOV	CX, 7
	REP	MOVSB

	MOV	SI, offset VGA_Pt1Ptr	; 4 bytes from 40:A8h-40:ABh
	MOVSW
	MOVSW

	MOV	AX, 0			; Also save video int. vectors
	MOV	DS, AX

	MOV	SI, 05h*4		; Int 05h print screen vector
	MOVSW
	MOVSW

	MOV	SI, 1Dh*4		; Int 1Dh video parameters
	MOVSW
	MOVSW

	MOV	SI, 1Fh*4		; Int 1Fh CGA font high
	MOVSW
	MOVSW

	MOV	SI, 43h*4
	MOVSW
	MOVSW

	MOV	DS, CS:DataSeg@		; Restore DS

	RET

SaveBIOSState ENDP

	; --------------------------

SaveDACtbl	DW	03C7h, 03C8h, 03C6h, 0

SaveDACState PROC NEAR
	; Enter with ES:DI = buffer to save
	; Must preserve ES & leave DI pointing to bit
	; after saved block
	CLD				; DAC saved state is:

	MOV	SI, offset CS:SaveDACtbl ; Values of ports 3C7, 3C8, 3C6
	CALL	VGAI_MultiRead

	MOV	DX, 03C7h		; Set DAC in read mode, starting
	MOV	AL, 0			; at colour 0
	OUT	DX, AL

	MOV	DX, 03C9h		; Blat data in from DAC read
	MOV	CX, 300h		; port
	REP	INSB	

	MOV	AH, 14h			; Read AR14 = colour select reg
	CALL	VGAI_ReadAR
	STOSB
	RET

SaveDACState ENDP

	; --------------------------

RestoreHardState PROC NEAR
	; Enter with ES:DI = buffer to restore
	; Must preserve ES

	CALL	VGA_VideoOff		; Prepare for mode change

	CALL	VGA_SetModeDI

	CALL	VGA_VideoOn		; Put video on

	TEST	byte ptr ES:[DI+09h], 1	; Is it a mono or colour mode?
	JZ	RHS_2			; RHS_2 if mono

	MOV	DX, 03DAh		; Ensure port 3C0 is AR index
	IN	AL, DX			; (colour mode)
	MOV	SI, DI			; Restore values to SR/CR/GR/AR
	MOV	DI, offset CS:CMiscRegsTbl	; index registers and
	CALL	VGAI_MultiWrite		; Feature Control reg
	RET

RHS_2:	MOV	DX, 03BAh		; Restore (mono)
	IN	AL, DX
	MOV	SI, DI			; Restore values to SR/CR/GR/AR
	MOV	DI, offset CS:MMiscRegsTbl	; index registers and
	CALL	VGAI_MultiWrite		; Feature Control reg
	RET
	
RestoreHardState ENDP

	; --------------------------

RestoreBIOSState PROC NEAR
	; Enter with ES:DI = buffer to restore
	; Must preserve ES

	ASSUME  ES:BIOSData, DS:Nothing

	PUSH	ES

	MOV	AX, ES			; Put DS=ES
	MOV	DS, AX
	MOV	SI, DI			; and SI=DI
					; Now DS:SI = source block
	MOV	ES, CS:DataSeg@		;     ES = BIOS data seg

	CLD				; BIOS video state is:

	INC	SI			; 1 byte of Don't Know!!
	MOV	DI, offset ES:VID_mode	; 30 bytes from 40:49h-40:66h
	MOV	CX, 15
	REP	MOVSW

	MOV	DI, offset ES:VID_lastrow ; 7 bytes from 40:84h-40:8Ah
	MOV	CX, 7
	REP	MOVSB

	MOV	DI, offset ES:VGA_Pt1Ptr	; 4 bytes from 40:A8h-40:ABh
	MOVSW
	MOVSW

	MOV	AX, 0			; Also get video int. vectors
	MOV	ES, AX

	MOV	DI, 05h*4		; Int 05h print screen vector
	MOVSW
	MOVSW

	MOV	DI, 1Dh*4		; Int 1Dh video parameters
	MOVSW
	MOVSW

	MOV	DI, 1Fh*4		; Int 1Fh CGA font high
	MOVSW
	MOVSW

	MOV	DI, 43h*4
	MOVSW
	MOVSW

	MOV	DS, CS:DataSeg@
	POP	ES
	RET

	ASSUME	DS:BIOSData, ES:Nothing

RestoreBIOSState ENDP

	; --------------------------

RestoreDACState PROC NEAR
	; Enter with ES:DI = buffer to restore
	; Must preserve BX, ES
	CLD				; DAC saved state is:

	MOV	DX, 03C6h		; Restore port 3C6h value
	MOV	AL, ES:[DI+2]
	OUT	DX, AL

	MOV	AL, ES:[DI+303h]	; Restore AR14 value
	MOV	AH, 14h
	CALL	VGAI_WriteAR

	MOV	DX, 03C8h		; Set DAC in write mode, starting
	MOV	AL, 0			; at colour 0
	OUT	DX, AL

	PUSH	DS

	MOV	AX, ES
	MOV	DS, AX			; Put DS:SI = ES:DI+3
	LEA	SI, [DI+03h]		; = start of DAC data
	MOV	DX, 03C9h		; Blat data out to DAC write
	MOV	CX, 300h		; port
	REP	OUTSB	

	POP	DS

	; Sort out read/write mode regs & pixel address latch:

	MOV	AL, ES:[DI+01h]		; Get saved pixel address
	MOV	DX, 03C7h
	TEST	byte ptr ES:[DI], 1	; Was it in read mode?
	JNZ	RDS_ReadMode		; If so, use port 3C7
					; If write mode, use port 3C8
	INC	DX
RDS_ReadMode:
	OUT	DX, AL

	RET

RestoreDACState ENDP

; Subroutines ***********************************************************

VGAI_LoadFont PROC NEAR
	; Load a text-mode font into the character generator
	; On entry, 
	;  ES:SI = font table
	;  DX = 1st character to load
	;  CX = number of characters to load
	;  BL = block number to load
	;  BH = character height
	; DS must be BIOS data segment
	; AX-DX, SI, DI, ES corrupted

	; Get address of destination of font into DI

	MOV	DI, BX				; Look up font base address
	AND	DI, 7				; according to block no.
	ADD	DI, DI				; (this is non-obvious!)
	MOV	DI, CS:VGAI_FontPos[DI]

	MOV	DH, 0				; Start at 1st char*32
	SHL	DX, 5
	ADD	DI, DX

	; Set up VGA registers for font access

	MOV	DX, IO_VGA_GraphRegs
	MOV	AL, GR_Misc			; Get GR6 (misc reg)
	OUT	DX, AL
	INC	DX
	IN	AL, DX
	DEC	DX
	MOV	AH, AL				; Save it in AH
	PUSH	AX

	MOV	DX, IO_VGA_SeqRegs
	MOV	AX, 0402h			; Set SR2=4 (write plane 2)
	OUT	DX, AX

	MOV	AX, 0604h			; SR4=6: Clear odd/even mode
	OUT	DX, AX

	MOV	DX, IO_VGA_GraphRegs
	MOV	AX, 0005h			; GR5=0: Clear odd/even mode
	OUT	DX, AX

	MOV	AX, 0406h			; GR6=4: Map at A000h for 64K
	OUT	DX, AX

	; Set up CPU registers & move data

	MOV	DX, ES
	MOV	DS, DX

	MOV	DX, 0A000h
	MOV	ES, DX
	MOV	BL, BH		; Get BX = char height
	MOV	BH, 0
	CLD

	; At this point DS:SI = source data, ES:DI=dest. address
	; CX = number of chars to load, BX = height of each char
	; Pushed AH = saved GR6 value

VGAI_LF_Loop:
	PUSH	CX

	MOV	CX, BX				; Block-move data
	REP	MOVSB

	SUB	DI, BX
	ADD	DI, 32
	POP	CX
	LOOP	VGAI_LF_Loop

	MOV	DS, CS:DataSeg@

	; Restore graphics regs

	MOV	DX, IO_VGA_SeqRegs		; Set SR2=3 (normal write)
	MOV	AX, 0302h
	OUT	DX, AX
	MOV	AX, 0204h			; Set SR4=3
	OUT	DX, AX				; (put back odd/even mode)

	MOV	DX, IO_VGA_GraphRegs
	MOV	AX, 1005h			; Set GR5 = 10h
	OUT	DX, AX				; (put back odd/even mode)

	POP	AX
	MOV	AL, 06h				; Restore GR6 (misc reg)
	OUT	DX, AX				; to value in AH
	RET
VGAI_LoadFont	ENDP

VGAI_FontPos	DW	0,     4000h,  8000h, 0C000h
		DW	2000h, 6000h, 0A000h, 0E000h  

	; -------------------------------------
	; VGAI_SetTextHeight programs the CRTC & BIOS variables
	; for a given text height. Enter with BH=new char height

VGAI_SetTextHeight PROC NEAR

	MOV	VID_charheight, BH	; Work out scanlines for this mode
	CALL	VGA_GetTextLines	; Get AX = height in scanlines
	DIV	BH			; Set BL = number of text rows
	MOV	BL, AL
	SUB	AL,1
	MOV	VID_lastrow, AL		; lastrow = #rows -1

	; Set page size ------------

	MOV	VID_pgsize, 1000h
	MOV	AX, VID_ncols
	MUL	BL			; If #chars on screen is more than
	CMP	AX, 800h		; 2048, we should use large page
	JB	VGAI_STH_smallpg	; size of 8192.
	MOV	VID_pgsize, 2000h
VGAI_STH_smallpg:

	; Set CRTC regs for text parameters ---------------
	; At this point BH = charheight, BL=no of rows

	CALL	VGA_VideoOff		; Stop spurious mode changes

	MOV	AL, BH
	MUL	BL			; CX= total scanlines needed
	MOV	CX, AX
	
	MOV	AH, BH			; AH = charheight-1
	DEC	AH
	AND	AH, 01Fh

	MOV	AL, 14h			; Set CRTC Underline pos
	OUT	DX, AX			; to charheight - 1

	CMP	CX, 256			; If < 256 scanlines needed
	JAE	VGAI_STH_NoDouble	; then set scan doubling bit.
	SHL	CX, 1
	OR	AH, 80h
VGAI_STH_NoDouble:

	MOV	DX, VID_CRTCport	; Set CR9 value
	MOV	AL, 09h			; = charheight-1 | double bit
	OUT	DX, AX

	MOV	AL, 12h			; Set CR12 = LSB(scanlines)
	DEC	CX
	MOV	AH, CL			; = Y total - 1
	OUT	DX, AX

	MOV	CL, BH			; Set cursor type
	MOV	CH, BH
	SUB	CX, 0201h
	AND	CX, 1F1Fh
	MOV	VID_curstype, CX

	MOV	AL, 10			; CRTC Reg 10 = Cursor start
	MOV	AH, CH			; Send CH value to reg 10
	OUT	DX, AX
	MOV	AL, 11			; CRTC Reg 11 = Cursor stop
	MOV	AH, CL			; Send CL value to reg 11
	OUT	DX, AX

	CALL	VGA_VideoOn		; Restore video
VGAI_STH_X:
	RET
VGAI_SetTextHeight ENDP

	; -------------------------------------

VGA_SumToGrey PROC NEAR
	; This takes a colour value (BH = Red, CH = Green, CL = Blue)
	; and converts it to a grey value (BH*.3 + CH*.59 + CL*.11)
	; this value is placed in BH, CH, CL
	; The actual calculation is (BH*76+CH*151+CL*29) / 256
	; Trashes AX, BL

	MOV	AL, 76
	MUL	BH
	MOV	BX, AX		; BX = BH*76
	MOV	AL, 151
	MUL	CH
	ADD	BX, AX		; BX = BH*76 + CH*151
	MOV	AL, 29
	MUL	CL
	ADD	BX, AX		; BX = BH*76 + CH*151 + CL*29
	MOV	CH, BH		; => BH = (Grey value)
	MOV	CL, BH
	RET
VGA_SumToGrey ENDP

; VGA_SetDACblock loads the DAC as follows:
; ES:SI = pointer to table of (R,G,B) bytes
; BX = first colour to set
; CX = # of colours to set
; DS = BIOS data seg;
; AX-DX, SI are trashed

VGA_SetDACblock PROC NEAR
	MOV	DX, 03C8h	; Address first DAC register
	MOV	AL, BL
	OUT	DX, AL

	TEST	VID_VGActrl, 2		; Grey scaling?
	JZ	VGA_SDB_NoGrey		; If not, do normal out

VGA_SDB_GreyLoop:
	PUSH	CX
	MOV	BH, ES:[SI]	; Get 'red'
	INC	SI
	MOV	CH, ES:[SI]	; Get 'green'
	INC	SI
	MOV	CL, ES:[SI]	; Get 'blue'
	INC	SI
	CALL	VGA_SumToGrey
	MOV	DX, 03C9h
	MOV	AL, BH		; Send 'red'
	OUT	DX, AL
	MOV	AL, CH		; Send 'green'
	OUT	DX, AL
	MOV	AL, CL		; Send 'blue'
	OUT	DX, AL
	POP	CX
	LOOP	VGA_SDB_GreyLoop
	RET

VGA_SDB_NoGrey:
	PUSH	DS		; If not, do block out to port
	MOV	AX, ES		; DS:SI-> table data
	MOV	DS, AX

	MOV	AX, CX
	SHL	AX, 1
	ADD	CX, AX		; CX<-CX*3 (number of bytes to send)

	MOV	DX, 03C9h
	CLD
	REP	OUTSB		; Send bytes

	POP	DS
	RET
VGA_SetDACblock ENDP

; VGA_SetModeDI is used by the Restore Hardware State (1C02h) function
; and the set mode function. It takes a pointer in ES:DI to a mode
; definition table and sets...

; SR1-SR4 from ES:DI+05h to +08h
; Misc Output reg from ES:DI+09h
; CR0-CR18 from ES:DI+0Ah to +22h
; AR0-AR13 from ES:DI+23h to +36h
; GR0-GR8 from  ES:DI+37h to +3Fh

; AX-DX, SI are trashed. DS is not critical. BP, ES, DI are preserved. 

VGA_SetModeDI PROC NEAR
	MOV	DX, 03C2h		; Restore Misc Output register
	MOV	AL, ES:[DI+09h]
	OUT	DX, AL

	MOV	DX, 03B4h
	TEST	AL, 1			; Are we restoring colour mode?
	JZ	RHS_1			; Nope? use 3B4 as CRTC base
	MOV	DX, 03D4h
RHS_1:	LEA	SI, [DI+0Ah]		; Restore CR0-CR18 values
	MOV	AH, 0
	MOV	CX, 19h
	CALL	VGAI_MultiWriteGR

	LEA	SI, [DI+05h]		; Restore SR1-SR4 values
	MOV	DX, 03C4h
	MOV	AH, 1
	MOV	CX, 4
	CALL	VGAI_MultiWriteGR

	LEA	SI, [DI+37h]		; Restore GR0-GR8 values
	MOV	DX, 03CEh
	MOV	AH, 0h
	MOV	CX, 9h
	CALL	VGAI_MultiWriteGR

	LEA	SI, [DI+23h]		; Restore AR0-AR13 values
	MOV	AH, 0
	MOV	CX, 14h
	CALL	VGAI_MultiWriteAR

	RET
VGA_SetModeDI ENDP

	; ---------------------------------------

VGA_GetTextLines PROC NEAR
	MOV	AX, 200			; bit 7 of [40:89] set for 200
	TEST	VID_VGActrl, 080h
	JNZ	VGA_GTL_Exit
	MOV	AX, 400
	TEST	VID_VGActrl, 010h	; bit 4 of [40:89] set for 400
	JNZ	VGA_GTL_Exit
	MOV	AX, 350			; else it's 350
VGA_GTL_Exit:
	RET
VGA_GetTextLines ENDP

	; ------------------------------

VGA_VideoOff PROC NEAR		; Prepare VGA logic for mode change
	MOV	DX, 03C4h	; by resetting sequencer regs
	MOV	AL, 0
	OUT	DX, AL
	INC	DX
	OUT	DX, AL
	RET
VGA_VideoOff ENDP

	; -----------------------

VGA_VideoOn PROC NEAR		; After mode change, re-enable
	MOV	DX, 03C4h	; sequencer
	MOV	AL, 0
	OUT	DX, AL
	INC	DX
	MOV	AL, 3
	OUT	DX, AL
	RET
VGA_VideoOn ENDP

	; -----------------------

VGAI_MultiRead PROC NEAR
	; Reads an arbitrary set of ports to a memory block
	; On entry:
	;  CS:SI -> table of Word port addresses to read, terminated by 0
	;  ES:DI -> block of bytes where the results are to be stored
	; DX, AL trashed
	; On exit, DI = next byte after last one written

	CLD
VGAI_MR_Loop:
	MOV	DX, CS:[SI]
	ADD	SI, 2
	CMP	DX, 0
	JZ	VGAI_MR_X
	IN	AL, DX
	STOSB
	JMP	VGAI_MR_Loop

VGAI_MR_X:
	RET

VGAI_MultiRead ENDP

	; ---------------------------------

VGAI_MultiWrite PROC NEAR
	; Writes an arbitrary set of ports from a memory table
	; On entry:
	;  CS:DI -> table of Word port addresses to be written, terminated by 0
	;  ES:SI -> block of bytes to be written to ports
	; DX, AL trashed
	; On exit, DI = next byte after last one written
	CLD
VGAI_MW_Loop:
	MOV	DX, CS:[DI]
	ADD	DI, 2
	CMP	DX, 0
	JZ	VGAI_MW_X
	LODS	byte ptr ES:[SI]
	OUT	DX, AL
	JMP	VGAI_MW_Loop

VGAI_MW_X:
	RET

VGAI_MultiWrite ENDP

	; Attrib reg routines ---------------------------------------

VGAI_ReadAR PROC NEAR
	; Reads attrib controller register
	; on entry AH = reg. no to read (0-1F)
	; return AL = data
	; trashes AH, DX

	MOV	DX, 03DAh	; Ensure attribute controller port (3C0)
	IN	AL, DX		; is set to 'address' not data
	MOV	DX, 03BAh	; (One way or another for colour/mono mode)
	IN	AL, DX

	MOV	DX, 03C0h
	MOV	AL, AH
	OR	AL, 20h		; Ensure 'enable video' is set
	OUT	DX, AL		; Write new AR index value

	INC	DX
	IN	AL, DX		; Read AR value
	RET
VGAI_ReadAR ENDP

	; --------------------

VGAI_WriteAR PROC NEAR
	; Writes attrib controller register
	; on entry AH = reg. no to write (0-1F)
	;          AL = data to write
	; trashes DX, AX
	; We have to keep the 'enable video' bit zero while
	; the write is taking place, because otherwise the Windows
	; VxD which virtualises it will throw them away!

	PUSH	AX		; Save reg no & data

	MOV	DX, 03DAh	; Ensure attribute controller port (3C0)
	IN	AL, DX		; is set to 'address' not data
	MOV	DX, 03BAh
	IN	AL, DX

	MOV	DX, 03C0h
	MOV	AL, AH		; Get reg no (with video 'disable' bit)
	OUT	DX, AL		; Set index

	POP	AX		; Get back data
	OUT	DX, AL		; Send it

	MOV	AL, 20h
	OUT	DX, AL		; Set back index = 20h (video enabled)
	RET
VGAI_WriteAR ENDP

	; --------------------

VGAI_MultiReadAR PROC NEAR
	; Multiple read of a Attribute Reg bank to a memory block
	; On entry ES:DI = dest block
	;	   CX = no. of regs to read (non-zero!)
	;	   AH = starting index value
	; On exit DI = next memory value

	OR	AH, 20h		; Ensure 'enable' bit set

	CLD
VGAI_AMR_Loop:
	MOV	DX, 03DAh	; Ensure attribute controller port (3C0)
	IN	AL, DX		; is set to 'address' not data
	MOV	DX, 03BAh
	IN	AL, DX

	MOV	DX, 03C0h	; Address relevant AR bit
	MOV	AL, AH
	OUT	DX, AL		; Set index

	INC	DX
	IN	AL, DX		; Read value
	STOSB
	INC	AH
	LOOP	VGAI_AMR_Loop
	RET
VGAI_MultiReadAR ENDP	

	; --------------------

VGAI_MultiWriteAR PROC NEAR
	; Multiple write of a Attribute Reg bank from a memory block
	; On entry ES:SI = source block
	;	   CX = no. of regs to read (non-zero!)
	;	   AH = starting index value

	MOV	DX, 03DAh	; Ensure attribute controller port (3C0)
	IN	AL, DX		; is set to 'address' not data
	MOV	DX, 03BAh
	IN	AL, DX

VGAI_AMW_Loop:
	MOV	DX, 03C0h	; Address relevant AR register
	MOV	AL, AH		; Set reg no (with 'enable' bit clear)
	OUT	DX, AL		; & toggle to write data

	LODS	byte ptr ES:[SI]		; Read next data
	OUT	DX, AL				; & toggle to write next address
	INC	AH
	LOOP	VGAI_AMW_Loop

	MOV	AL, 20h
	MOV	DX, 03C0h		; 3C0 should still be 'address'
	OUT	DX, AL			; put back 'enable' bit
	RET
VGAI_MultiWriteAR ENDP

	; --------------------
	
VGAI_MultiReadGR PROC NEAR
	; Multiple read of a CRTC/Seq Reg/Graph Reg bank to a memory
	; block
	; On entry ES:DI = dest block
	;	   DX = address of index port (data port is DX+1)
	;	   CX = no. of regs to read (non-zero!)
	;	   AH = starting index value
	; On exit AH, DI = next index/memory values

	CLD
VGAI_MRG_Loop:
	MOV	AL, AH		; Write index value
	OUT	DX, AL		; to port
	INC	DX
	IN	AL, DX		; Read data value
	DEC	DX
	STOSB			; Store it
	INC	AH
	LOOP	VGAI_MRG_Loop	; Next
	RET
VGAI_MultiReadGR ENDP

	; --------------------

VGAI_MultiWriteGR PROC NEAR
	; Multiple read of a CRTC/Seq Reg/Graph Reg bank to a memory
	; block
	; On entry ES:SI = source block
	;	   DX = address of index port (data port is DX+1)
	;	   CX = no. of regs to read (non-zero!)
	;	   AH = starting index value
	CLD
VGAI_MWG_Loop:
	MOV	AL, AH		; Write index value
	OUT	DX, AL		; to port
	INC	DX
	LODS	byte ptr ES:[SI]		; Get data
	OUT	DX, AL		; Write to port
	DEC	DX
	INC	AH		; Next index value
	LOOP	VGAI_MWG_Loop
	RET
VGAI_MultiWriteGR ENDP



; Tables **********************************

; Colours-in-mode table ( Function 1Bh )
; This is the number of colours minus 1, to make fit in 1 byte

ColoursInMode	DB  15, 15, 15, 15, 3, 3, 1, 1	; Modes 0-7
		DB  0, 0, 0, 0, 0, 15, 15, 1	; Modes 8-F
		DB  15, 1, 15, 255, 15		; Modes 10h-13h, SVGA

; Lines-in-mode table   ( Function 1Bh )
; 0 = 200lines, 1 = 350lines, 2=400lines, 3=480lines
; >3 = "work it out from video flags"

LinesInMode	DB  4, 4, 4, 4, 0, 0, 0, 4	; Modes 0-7
		DB  0, 0, 0, 0, 0, 0, 0, 1	; Modes 8-C and D-F
		DB  1, 3, 3, 0, 2		; Modes 10h-13h, SVGA

; Pages-in-mode table ( Function 1Bh )

PagesInMode	DB  8, 8, 8, 8, 1, 1, 1, 8	; 0-7
		DB  0, 0, 0, 0, 0, 8, 4, 2	; 8-F
		DB  2, 1, 1, 1, 1		; 10-13, SVGA

; Static functionality table (Function 1Bh)

StaticFuncTbl	DB	0FFh			; Modes 0-7 supported
		DB	0E0h			; Modes D,E,F supported
		DB	0FH			; Modes 10-13h supported
		DB 	0, 0, 0, 0		; Reserved
		DB	00000111b		; 200, 350 & 400 line
						; text modes supported
		DB	1			; 1 character set avail
		DB	1			; 1 char set active
		DB	0FFh			; Support everything (lie!)
		DB	0Eh			; except light pen
		DB	0, 0
		DB	03Fh
		DB	0


