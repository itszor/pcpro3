; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSVID.ASI  Video BIOS
;
; Versions
;	10-01-92 INH	New version for DIVAPC
;	17-01-92	CGA graphics mode support
;	06-02-92	Genuine beep routine
;	19-02-92	VGA BIOS added
;	13-03-92	Text output in EGA/VGA support
;	18-04-92	Text plotting XOR mode, VGA read/write pixel
;	07-05-92	Write String function (at last!)
;	08-07-92	Preserve SI, DI for benefit of QuickBASIC (!)
;	15-07-92	Use VID_pgsize for page size
;	30-10-92	(0.97) Initialise VGA_Pt1Ptr
;	09-01-93	AND colour values to range (EBank bug)
;	22-02-93	Cursor translation done properly
;	23-04-93	1.12b Write TTY uses active page (DOS5 Install bug)
;	19-05-93	All-386 side BIOS functions started
;	29-06-93	Function 11h done by ARM again
;	19-07-93	Scroll added; VGA registers preserved
;	03-08-93	Mode change done by 386
;	18-10-93	(1.22) Rd/Wr Dot fiddled; GetCursorForPage chg
;	17-01-95	VGA Attached / InitInMono bits deleted
; *****************************************************************


; Video services *************************************************

; VIDInit routine **************


VID_Init    PROC    NEAR
	; Turn windows driver off, if enabled
	MOV	DX, 320h		; Windows driver port
	MOV	AL, 0Dh			; 'Disable' command
	OUT	DX, AL

	MOV	[VID_ctrlbits], 60h	; Set VGA present flag, 256K RAM
	MOV	[VID_switches], 09h	; Indicate VGA attached (??)
	MOV	[VID_VGActrl],  11h	; Set 400-line text modes
	MOV	[VGA_DCCndx],   0Bh	; I don't know either...

	MOV	[VGA_Pt1Ptr], offset VGA_PtrTbl1
	MOV	[VGA_Pt1Seg], CS

	MOV     AX, 0003h               ; Call set-mode function
	INT     10h

	RET

VID_Init    ENDP

; VID_Int Service routine ****************************************

VID_Int		PROC FAR		; VGA video interrupt entry point
	CMP	AH, 1Ch
	JA	VIDI_CheckSVGA

	; Main Video Int handler

	STI
	PUSH	DS			; Set up seg-regs
	PUSH	ES
	PUSHA
	MOV	BP, SP

	MOV	DS, CS:DataSeg@		; DS = BIOS data seg

	MOV	DI, AX
	SHR	DI, 8
	ADD	DI, DI

	CMP	VID_mode, 7		; Modes 0..3 or 7 call the
	JE	VIDI_doText		; text mode dispatch routines
	CMP	VID_mode, 3		; Others call the graphics
	JA	VIDI_doGraph		; dispatch routines

VIDI_doText:
	JMP	CS:VIDI_Dispatch[DI]
VIDI_doGraph:
	JMP	CS:VIDI_GraphDisp[DI]

VIDI_CheckSVGA:
	CMP	AH, 04Fh
	JNE	VIDI_Iret
	JMP	SVGA_Int

VIDI_Exit:
	POPA
	POP	ES
	POP	DS
VIDI_Iret:
	IRET

VID_Int	ENDP

; Text mode dispatch routines *********************************************

	; Enter with:
	; AX, BX, CX, DX, SI, DI = value on entry to INT
	; BP points to stack frame (use [BP].SavedBX, etc)
	; DS = BIOSData Seg

	; Dispatch routines for Text Modes (0,1,2,3,7)

VIDI_Dispatch	DW	VIDI_ModeChange		; Function 00h Set Mode
		DW	VIDI_SetCursorType	; Function 01
		DW	VIDI_SetCursorPos	; Function 02 
		DW	VIDI_GetCursor		; Function 03
		DW	VIDI_LightPen		; Function 04
		DW	VIDI_SetActPage		; Function 05
		DW	VIDI_ScrollUp		; Function 06 Scroll Up
		DW	VIDI_ScrollDn		; Function 07 Scroll Down
		DW	VIDI_ReadChar		; Function 08
		DW	VIDI_WriteCharAttrib	; Function 09
		DW	VIDI_WriteChar		; Function 0A
		DW	VIDI_Exit		; Function 0B Set CGA colour
		DW	VIDI_Exit		; Function 0C Write Pixel
		DW	VIDI_Exit		; Function 0D Read Pixel
		DW	VIDI_WriteTTY		; Function 0E
		DW	VIDI_ReadStatus		; Function 0F
		DW	VGAI_Fn10h		; Function 10 Palette
		DW	VGAI_Fn11h		; Function 11 Char gen
		DW	VGAI_Fn12h		; Function 12 Misc functions
		DW	VIDI_WriteString	; Function 13 Write String
		DW	VIDI_Exit		; Function 14
		DW	VIDI_Exit		; Function 15
		DW	VIDI_Exit		; Function 16
		DW	VIDI_Exit		; Function 17
		DW	VIDI_Exit		; Function 18
		DW	VIDI_Exit		; Function 19
		DW	VGAI_Fn1Ah		; Function 1A Read/write DCC
		DW	VGAI_Fn1Bh		; Function 1B Return info
		DW	VGAI_Fn1Ch		; Function 1C Save/restore state

	; Dispatch routines for graphics modes

VIDI_GraphDisp	DW	VIDI_ModeChange		; 00 Set Mode
		DW	VIDI_Exit		; 01 Set Cursor shape
		DW	VIDI_GraphSetCursorPos	; 02 
		DW	VIDI_GraphGetCursor	; 03
		DW	VIDI_LightPen		; 04 Light Pen
		DW	VIDI_GraphSetActPage	; 05 Active Page
		DW	VIDI_ScrollUp		; 06 Scroll Up
		DW	VIDI_ScrollDn		; 07 Scroll Down
		DW	VIDI_GraphRdChar	; 08 Read char at cursor
		DW	VIDI_GraphWrChar	; 09
		DW	VIDI_GraphWrChar	; 0A
		DW	VIDI_GraphSetPalette	; 0B
		DW	VIDI_GraphWriteDot	; 0C
		DW	VIDI_GraphReadDot	; 0D
		DW	VIDI_GraphWriteTTY	; 0E
		DW	VIDI_ReadStatus		; 0F Use CGA routines
		DW	VGAI_Fn10h		; 10 Palette
		DW	VGAI_Fn11h		; 11 Char gen
		DW	VGAI_Fn12h		; 12 Misc functions
		DW	VIDI_GraphWriteString	; 13 Write String
		DW	VIDI_Exit		; 14
		DW	VIDI_Exit		; 15
		DW	VIDI_Exit		; 16
		DW	VIDI_Exit		; 17
		DW	VIDI_Exit		; 18
		DW	VIDI_Exit		; 19
		DW	VGAI_Fn1Ah		; 1A Read/write DCC
		DW	VGAI_Fn1Bh		; 1B Return info
		DW	VGAI_Fn1Ch		; 1C Save/restore state

VIDI_ModeChange:	; Function 00h **********************************
	CALL	VID_ModeChange	; AL = mode
	CALL	MOU_ModeChange
	JMP	VIDI_Exit

VIDI_SetCursorType:	; Function 01h **********************************

	MOV	VID_curstype, CX	; Save CX value	
	MOV	DX, VID_CRTCport

	TEST	VID_ctrlbits, 1		; Doing CGA cursor emulation?
	JNZ	VIDI_CurTrans_X		; If not, skip this

	CMP	VID_charheight, 8	; If chars 8 or less lines high
	JBE	VIDI_CurTrans_X		; don't translate cursor

	CMP	CH, CL			; If start > stop line, cursor off
	JA	VIDI_CurTrans_X		; In which case, don't translate

	MOV	AX, CX
	AND	AH, 01Fh		; AH = start line, AL = stop line
	CALL	CursorTrans		; translate cursor
	AND	CX, 0E000h		; Reinstate CH bits 5..7
	OR	CX, AX

VIDI_CurTrans_X:
	MOV	AL, 10			; CRTC Reg 10 = Cursor start
	MOV	AH, CH			; Send CH value to reg 10
	OUT	DX, AX

	MOV	AL, 11			; CRTC Reg 11 = Cursor stop
	MOV	AH, CL			; Send CL value to reg 11
	OUT	DX, AX

	JMP	VIDI_Exit


VIDI_SetCursorPos:	; Function 02h *********************************

	; BH = display page no
	; DH = Row (0=top)
	; DL = Col (0=left)

	MOV	CH, BH			; Save in CH
	CALL	VID_GetCurPosRC		; DX = row/column
					; Get offset into BX

	CALL	VID_SetCurPos		; Set cursor entry on page CH
					; to be DX, CRTC offset to be BX
	JMP	VIDI_Exit


VIDI_GetCursor:		; Function 03h *********************************

	; Returns with CX = cursor type info
	; and with     DX = cursor position

	SHR	BX, 7			; BX = display page no.
	AND	BX, 0Eh
	MOV	AX, VID_curstbl[BX]	; Get cursor pos into DX
	MOV	[BP].SavedDX, AX

	MOV	AX, VID_curstype	
	MOV	[BP].SavedCX, AX
	JMP	VIDI_Exit

VIDI_LightPen:		; Function 04h **********************************
	; We have no light pen - return with AH=00
	MOV	[BP].SavedAX, 0
	JMP	VIDI_Exit

VIDI_SetActPage:	; Function 05h **********************************

	; Enter with new page in AL

	AND	AX, 7		; Limit	to pages 0-7
	MOV	VID_actpage, AL

	MUL	VID_pgsize	; Calculate new starting address
	MOV	VID_pgaddr, AX	; Store active offset (is this used??)

	MOV	BX, AX		; Convert to CRTC offset in BX
	SHR	BX, 1

	MOV	DX, VID_CRTCport

	MOV	AL, 12			; CRTC Reg 12 = Disp start MSB
	OUT	DX, AL
	INC	DX
	MOV	AL, BH			; Send BH value to reg 12
	OUT	DX, AL
	DEC	DX

	MOV	AL, 13			; CRTC Reg 13 = Disp start LSB
	OUT	DX, AL
	INC	DX
	MOV	AL, BL			; Send BL value to reg 13
	OUT	DX, AL

	MOV	BH, VID_actpage
	MOV	CH, BH
	CALL	VID_GetCurPos		; Get offset for page BH into BX
	CALL	VID_SetCurPos		; Set cursor position for page CH

	JMP	VIDI_Exit

VIDI_ScrollUp:		; Function 06h **********************************
	MOV	BL, AL		; Set BL = scroll distance
	CALL	VID_Scroll
	JMP	VIDI_Exit

VIDI_ScrollDn:		; Function 07h **********************************
	MOV	BL, AL
	NEG	BL		; -ve for scroll down
	CALL	VID_Scroll
	JMP	VIDI_Exit

VIDI_ReadChar:		; Function 08h **********************************

	; BH = display page
	CALL	VID_GetCurPos	; Get ES:BX as current pointer

	MOV	AX, ES:[BX]	; Read AL=char, AH=attrib
	MOV	[BP].SavedAX, AX

	JMP	VIDI_Exit

VIDI_WriteCharAttrib:	; Function 09h **********************************

			; BH = page, BL = attrib, AL = char to write
			; CX = repeat count

	; BH = page
	MOV	AH, BL		; Form AX = word to write

	PUSH	AX
	CALL	VID_GetCurPos	; BH = page number - get ES:BX = pointer
	POP	AX

VIDI_WCA1:			; Extra effort of setting up a
	MOV	ES:[BX], AX	; STOSW instruction is probably
	ADD	BX, 2		; wasted given ARM limitations of
	LOOP	VIDI_WCA1	; at least 10us per write

	JMP	VIDI_Exit


VIDI_WriteChar:		; Function 0Ah **********************************

			; BH = page, AL = char to write
			; CX = repeat count

	CALL	VID_GetCurPos	; BH = page number
				; return BX = offset

	MOV	AX, [BP].SavedAX
VIDI_WC1:			
	MOV	ES:[BX], AL	
	ADD	BX, 2		
	LOOP	VIDI_WC1	

	JMP	VIDI_Exit


VIDI_ReadStatus:	; Function 0Fh **********************************
	MOV	AH, byte ptr VID_ncols	; No. of columns on screen
	MOV	AL, VID_mode		; Current video mode
	MOV	BH, VID_actpage		; Active video page no.
	MOV	[BP].SavedAX, AX
	MOV	[BP].SavedBX, BX
	JMP	VIDI_Exit


VIDI_WriteTTY:		; Function 0Eh ***********************************

	; Enter with AL = char to write to ACTIVE PAGE!!
	; BL  = foregnd colour in graphics mode

	MOV	BH, VID_actpage
	MOV	CH, BH			; Save page number in CH

					; Get cursor offset on page
	CALL	VID_GetCurPos		; BH into BX, set up ES
					; DH = cursor row, DL = col
	MOV	AX, [BP].SavedAX	; Get AX value

	CMP	AL, 20h
	JAE	WTTY_Print
	CMP	AL, 7
	JE	WTTY_Bell
	CMP	AL, 8
	JE	WTTY_BackSpace
	CMP	AL, 10
	JE	WTTY_LineFeed
	CMP	AL, 13
	JE	WTTY_Return

WTTY_Print:
	MOV	ES:[BX], AL		; Write char only to frame buf

	; At this point
	; CH = page number
	; BX = offset of current cursor position
	; DH=row, DL=col of current cursor position

	ADD	BX, 2			; BX := next character
	INC	DL			; Move to next column
	CMP	DL, byte ptr VID_ncols	; Is it past end ?
	JAE	WTTY_NewLine		; If not, update cursor & exit
WTTY_Exit:
	CALL	VID_SetCurPos
	JMP	VIDI_Exit

WTTY_NewLine:
	MOV	DL, 0
	JMP	short WTTY_ScrollCheck
WTTY_LineFeed:			; Move cursor down one line
	ADD	BX, VID_ncols	; BX = BX + (2*ncols)
	ADD	BX, VID_ncols
WTTY_ScrollCheck:
	INC	DH
	CMP	DH, VID_lastrow		; Is it past end-of-screen?
	JBE	WTTY_Exit		; If not, update and exit

	DEC	DH			; Cursor row is one less
	SUB	BX, VID_ncols		; Current cursor offset is
	SUB	BX, VID_ncols		; less by VID_ncols*2
	CALL	VID_SetCurPos		; Put cursor in DX/BX into
					; VID_curstbl[CH]
	CALL	VID_ScrollUpOne
	JMP	VIDI_Exit

	; ******************************************

	; Write TTY service routines:
	; Entered with BX = offset of current cursor position
	; DH = cursor row, DL = cursor column, CH = page no

WTTY_BackSpace:
	CMP	DL, 0
	JE	WTTY_Exit
	DEC	DL
	SUB	BX, 2
	JMP	WTTY_Exit

WTTY_Return:
	SUB	BL, DL		; To do Carriage return, subtract
	SBB	BH, 0		; 2*column number from cursor offset
	SUB	BL, DL		; i.e. BX = BX - (2*DL)
	SBB	BH, 0
				; Row no. of cursor (DH) remains the same
	MOV	DL, 0		; Column of cursor (DL) is zero
	JMP	WTTY_Exit

WTTY_Bell:
	CALL	kbd_beep
	JMP	VIDI_Exit

VIDI_WriteString:		; Function 13h ****************************

	; At this point ES:saved BP is a pointer to the start of the string
	; BH = page number
	; CX = length of string
	; DX = initial cursor position
	CMP	AL, 4			; AL >= 4: no effect (02/07/93)
	JAE	VIDI_WS_NoUpdate

	JCXZ	VIDI_WS_CheckUpdate	; Holon does this
	TEST	AL, 2			; Is it 'write string with attribs'
	JNZ	VIDI_WS_Attrib		; function?

	; Write string functions 0-1 *********

	MOV	SI, [BP].SavedBP

VIDI_WS_1:				; If not, write string using
	MOV	AL, ES:[SI]		; WriteMoveCursor

	PUSH	SI
	PUSH	CX
	PUSH	BX
	CALL	WriteMoveCursor
	POP	BX
	POP	CX
	POP	SI

	INC	SI
	LOOP	VIDI_WS_1

	JMP	short VIDI_WS_CheckUpdate	; DX = row/column

	; Write String Functions 2-3 **********

VIDI_WS_Attrib:
	PUSH	ES
	CALL	VID_GetCurPosRC	
	MOV	DI, BX			; ES:DI is dest. pointer

	MOV	BL, byte ptr VID_ncols
	MOV	BH, VID_lastrow

	POP	DS			; DS = old ES value
	MOV	SI, [BP].SavedBP	; SI = pointer to string
	CLD

	; At this point ES:DI is pointer to display memory
	; DS:SI is the source string, and CX is the word count
	; DX is cursor row:column and BX is the screen size in
	; rows/columns

VIDI_WSA_1:
	MOVSW				; Copy char and attrib

	INC	DL			; Next Col
	CMP	DL, BL			; Are we past end?
	JB	VIDI_WSA_2		; If not, continue
	MOV	DL, 0			; Else, start next line
	INC	DH
	CMP	DH, BH			; Are we past end-of-screen
	JBE	VIDI_WSA_2		; If not, continue

	PUSH	BX
	PUSH	CX
	PUSH	DX
	PUSH	SI
	PUSH	DI
	CALL	VID_ScrollUpOne		; Else scroll screen up one line
	POP	DI
	POP	SI
	POP	DX
	POP	CX
	POP	BX

	DEC	DH			; Move cursor back 1 row
	MOV	AL, BL			; And take memory pointer
	MOV	AH, 0			; back by 1 row.
	SUB	DI, AX
	SUB	DI, AX
	
VIDI_WSA_2:
	LOOP	VIDI_WSA_1

	; Check if cursor needs updating **********

	; Enter here with
	; DH, DL = cursor position

VIDI_WS_CheckUpdate:
	MOV	DS, CS:DataSeg@
	TEST	[BP].SavedAX, 1		; Should cursor be updated?
	JZ	VIDI_WS_NoUpdate

	MOV	BX, [BP].SavedBX	; Retrieve BH = display page

	MOV	CH, BH			; Save page number in CH
	CALL	VID_GetCurPosRC		; DX = row/column
					; Get offset into BX
	CALL	VID_SetCurPos		; Set cursor entry on page CH
					; to be DX, CRTC offset to be BX
VIDI_WS_NoUpdate:
	JMP	VIDI_Exit			



; Text Mode Subroutines ******************************************************

	; CursorTrans translates the cursor scan line value in AL
	; AH = start line, AL = stop line
	; These need to be translated into the range 0..VID_charheight-1
	; This recognises 4 basic cursor shapes:
	; (i)   stop <= 4 : 'Overline' cursor, otherwise
	; (ii)  stop >  4, height = 1..3 lines : 'Underline cursor'
	; (iii) stop >  4, start >=3 : 'Half-block' cursor
	; (iv)  Anything else: full height cursor

CursorTrans PROC NEAR
	CMP	AL, 4			; If (stop <= 4), overline cursor
	JBE	CT_Exit

	MOV	BL, AL			; height = stop-start+1:
	SUB	BL, AH			; Get height-1 into BL
	MOV	AL, VID_charheight	; Get (bottom scan line-1) into AL
	DEC	AL			; = new stop line

	CMP	BL, 2			; If (Height-1) = 0..2
	JA	CT_NotUnderline		; use underline cursor
	MOV	AH, AL			; Get new start line
	SUB	AH, BL			;  = stop - (height-1)
	RET

CT_NotUnderline:
	CMP	AH, 2			; If start <= 2
	JBE	CT_Exit			;  use full cursor

	MOV	AH, AL			; Else use half-blck cursor
	INC	AH
	SHR	AH, 1
CT_Exit:
	RET

CursorTrans ENDP

	; VID_GetCurPos and VID_GetCurPosRC set up ES:BX to point
	; to the address of a given position in video memory.

	; VID_GetCurPos is entered with the current page number in
	; BH, and returns the position of the cursor on that page in BX,
	; and current cursor row/col in DH/DL.

	; VID_GetCurPosRC is entered with DH = row, DL = column,
	; BH = page, exits as above. (i.e. DX is preserved)

	; AX is trashed by this, CX is preserved

VID_GetCurPos	PROC NEAR

	MOV	AH, BH			; Save page in AH
	SHR	BX, 7
	AND	BX, 0Eh
	MOV	DX, VID_curstbl[BX]	; Get Row, Col into DH, DL
	MOV	BH, AH			

VID_GetCurPosRC:
	AND	BH, 7
	MOV	AL, byte ptr [VID_pgsize+1]
					; Assume page size is n * 256
	MUL	BH			; AL = page * pagesize / 256

	MOV	BH, AL			; BX = page * pagesize
	MOV	BL, 0

	MOV	AL, byte ptr VID_ncols	; AX = DH * VID_ncols
	MUL	DH			;
	ADD	AL, DL			; AX = DH*ncols + DL
	ADC	AH, 0
	ADD	BX, AX			; BX = (DH*VID_ncols+DL)+(page*pgsize)
	ADD	BX, AX			; BX = offset

	MOV	AX, 0B000h		; If Mode == 7
	CMP	VID_mode, 7		; it must be MDA, so 
	JE	VID_GO1			; segment = B000h
	MOV	AX, 0B800h		; else CGA, segment = B800h
VID_GO1:
	MOV	ES, AX
	RET

VID_GetCurPos	ENDP

	; *************************************************

	; VID_SetCurPos sets the cursor position on page CH to
	; be row DH, column DL, with the corresponding byte offset
	; in BX.
	; AX, DX are trashed

VID_SetCurPos PROC NEAR
	PUSH	BX

	MOV	BL, CH			; Convert BX = offset into array
	ADD	BL, BL
	AND	BX, 0Eh

	MOV	VID_curstbl[BX], DX	; Put new position into cursor
	POP	BX			; position array

	CMP	CH, VID_actpage		; Is cursor pos visible?
	JNE	VID_SCP_Exit

	SHR	BX, 1			; Convert to CRTC address
	MOV	DX, VID_CRTCport
	
	MOV	AL, 14			; CRTC Reg 14 = Cursor Pos MSB
	OUT	DX, AL
	INC	DX
	MOV	AL, BH			; Send BH value to reg 10
	OUT	DX, AL
	DEC	DX

	MOV	AL, 15			; CRTC Reg 15 = Cursor Pos LSB
	OUT	DX, AL
	INC	DX
	MOV	AL, BL			; Send BL value to reg 11
	OUT	DX, AL

VID_SCP_Exit:
	RET

VID_SetCurPos ENDP



; CGA/EGA/VGA Graphics dipatch routines ***************************************

	; Enter with:
	; AX, BX, CX, DX, SI, ES = value on entry to INT
	; SS:BP-> PUSHAframe structure containing all regs
	; DS = BIOSData Seg


VIDI_GraphSetCursorPos:	; Function 02h ********************************

	; Enter with DH = Row, DL = Column, BH = page

	SHR	BX, 7
	AND	BX, 0Eh
	MOV	VID_curstbl[BX], DX
	JMP	VIDI_Exit

VIDI_GraphGetCursor:	; Function 03h ********************************

	; Get cursor row into DH, column into DL
	; Cursor start line into CH, Cursor stop line into CL

	SHR	BX, 7
	AND	BX, 0Eh
	MOV	DX, VID_curstbl[BX]
	MOV	[BP].SavedDX, DX
	MOV	[BP].SavedCX, 0		; Graphics: no cursor

	JMP	VIDI_Exit

VIDI_GraphSetActPage:		; Function 05h ****************************

	; Enter with new page in AL

	AND	AL, 7		; Change 1.21->1.22: be less cautious!
	MOV	VID_actpage, AL
	
	MUL	VID_pgsize	; Multiply by video page size
	MOV	VID_pgaddr, AX	; Store active offset (is this used??)

	MOV	BX, AX		; Put CRTC offset in BX

	MOV	DX, VID_CRTCport	; Get CRTC address

	MOV	AL, 13			; CRTC Reg 13 = Disp start LSB
	MOV	AH, BL			; Send BL value to reg 13
	OUT	DX, AX

	MOV	AL, 12			; CRTC Reg 12 = Disp start MSB
	MOV	AH, BH
	OUT	DX, AX

	JMP	VIDI_Exit

VIDI_GraphRdChar:		; Function 08h ******************************
	; This is a bodge!!
	MOV	[BP].SavedAL, 0
	JMP	VIDI_Exit

VIDI_GraphWrChar:		; Functions 09h and 0Ah *********************

	; Enter with BL = character colour, BH = page
	; AL = ASCII character to write
	; CX = repeat count of character

	SHR	BX, 7
	AND	BX, 0Eh
	MOV	DX, VID_curstbl[BX]	; BH = page number
					; Get DL, DH = cursor pos
VIDI_GWC_1:
	MOV	AX, [BP].SavedAX	; AL = char
	MOV	BX, [BP].SavedBX	; BL = attrib, BH = page
	PUSH	CX
	PUSH	DX
	CALL	GraphWriteXY
	POP	DX
	POP	CX

	INC	DL			; Next column
	LOOP	VIDI_GWC_1

	JMP	VIDI_Exit

VIDI_GraphSetPalette:	; Function 0B *****************************

	; BX on entry:	BH = 00 - set palette reg bits 0..4 to BL 
	;		BH = 01 - set palette reg bits 5..7 to BL<<5

	CMP	BH, 00
	JNE	SetPal1

	MOV	AL, VID_palreg
	AND	AL, 0E0h
	AND	BL, 01Fh
	OR	AL, BL
	JMP	SetPal2

SetPal1:
	MOV	AL, VID_palreg
	AND	AL, 01FH
	SHL	BL, 5
	OR	AL, BL

SetPal2:
	MOV	VID_palreg, AL

	; On a VGA we do not output to the palette reg, but instead
	; set the Attribute regs to the right value.

	AND	AL, 0Fh			; Palette reg bits 0..3 are
	MOV	BX, offset CS:GSP_Lookup	; foregnd for mode 6  /
	XLAT	CS:[BX]			; background for modes 4/5

	CMP	VID_Mode, 6		; If not in CGA mode, exit
	JA	SetPal_X
	JNE	SetPal_M45

	; Mode 6 set palette routine

	MOV	AH, 1			; Colour in CGA pal reg[0..3]
	CALL	VGAI_WriteAR		; is foreground colour
SetPal_X:
	JMP	VIDI_Exit

	; Modes 4,5 set palette routine
SetPal_M45:
	MOV	AH, 0			; Colour in CGA pal reg[0..3]
	CALL	VGAI_WriteAR		; is the background colour

	MOV	BL, VID_palreg		; CGA pal reg [4..5] selects
	SHR	BL, 2			; 1 of 4 palette sets
	AND	BX, 0Ch

	MOV	AH, 01
	MOV	AL, CS:GSP_CGAPals[BX+1]
	CALL	VGAI_WriteAR
	MOV	AH, 02
	MOV	AL, CS:GSP_CGAPals[BX+2]
	CALL	VGAI_WriteAR
	MOV	AH, 03
	MOV	AL, CS:GSP_CGAPals[BX+3]
	CALL	VGAI_WriteAR
	JMP	VIDI_Exit

GSP_Lookup	DB	00h, 01h, 02h, 03h, 04h, 05h, 14h, 07h
		DB	38h, 39h, 3Ah, 3Bh, 3Ch, 3Dh, 3Eh, 3Fh
GSP_CGAPals	DB	0, 02h, 04h, 06h,   0, 3Ah, 3Ch, 3Eh
		DB	0, 13h, 15h, 17h,   0, 3Bh, 3Dh, 3Fh

VIDI_GraphWriteDot:	; Function 0C *****************************

	; Enter with AL = colour
	; CX = column
	; DX = row
	; BH = page

	MOV	AH, 01h		; Bit mask for mode 6
	CMP	VID_mode, 6
	JE	WrDot6
	JB	WrDot45

	CMP	VID_mode, 013H	; If Mode 13h, use
	JE	WrDotM13	; for all others (inc SVGA!)
				; assume VGA-style addressing

	; Get VGA address into ES:SI, bit pattern into CH *****************
	; Address = (X/8) + Y*n_columns + (BH*pagesize)
	; bit = 80H >> (X and 7)

	CALL	GetVGAPixelAddr

	; Set up VGA registers for plot ***********

	MOV	DX, IO_VGA_GraphRegs

	MOV	AL, GR_SetRes		; Put Set/Reset reg = colour
	MOV	AH, [BP].SavedAL	; 
	AND	AH, 0Fh
	OUT	DX, AX

	MOV	AL, GR_SetResEn
	MOV	AH, 0Fh
	OUT	DX, AX

	TEST	[BP].SavedAL, 80H	; Is it XOR plotting?
	JZ	WrDot_VGA_NoXor
	MOV	AL, GR_OpRotate
	MOV	AH, 018h
	OUT	DX, AX			; Set XOR mode if so
WrDot_VGA_NoXor:

	MOV	AL, GR_BitMask
	MOV	AH, CH
	OUT	DX, AX			; Set bit mask = CH data

	; Do the plotting *************************

	OR	ES:[SI], CH		; Load VGA latches with data
					; & Do the write
	MOV	AL, GR_BitMask
	MOV	AH, 0FFh
	OUT	DX, AX

	MOV	AL, GR_SetResEn
	MOV	AH, 00h
	OUT	DX, AX

	TEST	[BP].SavedAL, 80h
	JNZ	WrDot_VGA_Restore
	JMP	VIDI_Exit
	
WrDot_VGA_Restore:
	MOV	AL, GR_OpRotate
	MOV	AH, 0
	OUT	DX, AX

	JMP	VIDI_Exit

	; Mode 13h write dot ************

WrDotM13:
	CALL	GetM13PixelAddr		; Preserves AX
	MOV	ES:[SI], AL
	JMP	VIDI_Exit
	
	; CGA graphics write dot ********

	; AH = 01h
	; AL = colour (+80H for exclusive-OR)
	; CX = column (X)
	; DX = row (Y)

WrDot45:
	MOV	AH, 03h		; If modes 4/5, use 2-bit mask
	SHL	CX, 1		; and adjust CX to give desired
	INC	CX		; column address for GetPixelAddr routine

WrDot6: CALL	GetCGAPixelAddr	; Given CX=col, DX=row, set ES:BX to
				; point to given byte & set CL = count
				; to rotate bits by.

	TEST	AL, 80h		; If bit 7 of AL set, XOR-plot
	JNE	WrDotXor

	AND	AL, AH
	NOT	AH
	ROL	AH, CL		; Rotate bit mask into place
	AND	AH, ES:[BX]	; Get AH = pixels to be preserved
	ROL	AL, CL		; AL = new dots to be added
	OR	AL, AH		; AL = new value of byte
	MOV	ES:[BX], AL
	JMP	VIDI_Exit

WrDotXor:
	AND	AL, AH
	ROL	AL, CL		; get into position
	XOR	ES:[BX], AL	; Xor onto screen
WrDotExit:
	JMP	VIDI_Exit

	

VIDI_GraphReadDot:	; Function 0D *****************************

	; Enter with
	; CX = column, BX = page
	; DX = row
	; Exit with AL = dot colour

	MOV	AH, 01h		; Bit mask for mode 6
	CMP	VID_mode, 6	; Mode 6 ?
	JE	RdDot6
	JB	RdDot45		; Modes 4,5?

	CMP	VID_mode, 013h	; Mode 13h?
	JE	RdDotM13	; All other modes are VGA-style

	; Get VGA address into ES:SI, bit pattern into CH *****************

	; Address = (X/8) + Y*n_columns + BH *pagesize
	; bit = 80H >> (X and 7)

	CALL	GetVGAPixelAddr

	; Set up VGA registers for read ***********

	MOV	DX, IO_VGA_GraphRegs

	MOV	AH, 3			; AH holds the bit plane we
					; are currently reading
	MOV	BL, 0			; BL holds the result
					; CH holds the bit pattern to
					; be tested against
	MOV	AL, GR_RdPlaneSel	; Plane select register

RdDotVGA_loop:
	OUT	DX, AX			; Set to read from plane AH

	SHL	BL, 1			; Shift result up
	TEST	CH, ES:[SI]		; Is video bit set in this plane?
	JZ	RdDotVGA_Clr
	OR	BL, 1			; If so, set result bit
RdDotVGA_Clr:
	SUB	AH, 1			; Was that the last plane?
	JAE	RdDotVGA_loop		; If not, loop

	MOV	[BP].SavedAL, BL
	JMP	VIDI_Exit

	; Mode 13h read dot ******************************

RdDotM13:
	CALL	GetM13PixelAddr
	MOV	AL, ES:[SI]
	MOV	[BP].SavedAL, AL
	JMP	VIDI_Exit

	; CGA Graphics read dot **************************

RdDot45:
	MOV	AH, 03h		; If modes 4/5, use 2-bit mask
	SHL	CX, 1		; and adjust CX to give desired
	INC	CX		; column address for GetPixelAddr routine

RdDot6: CALL	GetCGAPixelAddr	; Given CX=col, DX=row, set ES:BX to
				; point to given byte & set CL = count
				; to rotate bits by.

	MOV	AL, ES:[BX]	; Get pixel data
	SHR	AL, CL		; Shift desired pixel into LSB
	AND	AL, AH		; Trim according to bit mask

	MOV	[BP].SavedAL, AL
	JMP	VIDI_Exit


VIDI_GraphWriteTTY:	; Function 0E *****************************

	; Enter with AL = character, BL = foreground colour, BH = page

	MOV	BH, VID_actpage		; Force page = active page
	MOV	SI, BX
	SHR	SI, 7
	AND	SI, 0Eh
	MOV	DX, VID_curstbl[SI]

	PUSH	SI
	CALL	WriteMoveCursor
	POP	SI	

	MOV	VID_curstbl[SI], DX	; Replace row & column
	JMP	VIDI_Exit


VIDI_GraphWriteString:	; Function 13h *****************************

	; At this point ES:BP is a pointer to the start of the string
	; BH = page number
	; CX = length of string
	; DX = initial cursor position

	MOV	SI, [BP].SavedBP
	CMP	AL, 4			; AL >= 4 : no effect (02/07/93)
	JAE	VIDI_GWS_2
	JCXZ	VIDI_GWS_Test		; For consistency with text mode
	TEST	AL, 2
	JNZ	VIDI_GWS_Attrib

VIDI_GWS_1:				; Write char using
	MOV	AL, ES:[SI]		; WriteMoveCursor
	MOV	BX, [BP].SavedBX
	PUSH	SI
	PUSH	CX
	CALL	WriteMoveCursor
	POP	CX
	POP	SI
	INC	SI
	LOOP	VIDI_GWS_1
	JMP	VIDI_GWS_Test

VIDI_GWS_Attrib:
	MOV	AL, ES:[SI]
	INC	SI
	MOV	BX, [BP].SavedBX
	MOV	BL, ES:[SI]
	PUSH	SI
	PUSH	CX
	CALL	WriteMoveCursor
	POP	CX
	POP	SI
	INC	SI
	LOOP	VIDI_GWS_Attrib

VIDI_GWS_Test:
	TEST	[BP].SavedAX, 1		; Update cursor?
	JZ	VIDI_GWS_2

					; If so, get back BL = page:
	MOV	BL, [BP].SavedBH
	SHL	BX, 1
	AND	BX, 0Eh
	MOV	VID_curstbl[BX], DX

VIDI_GWS_2:
	JMP	VIDI_Exit

; WriteMoveCursor ***********************************************************

	; WriteMoveCursor is used by graphics Write TTY routine
	; and also Function 13h (Write String) in the VGA BIOS

	; It is entered with 
	; DH=row, DL = column, AL = character to write
	; BH=page, BL=foreground colour for graphics modes
	; In mode 13h, BH = backgnd colour

	; On exit, DH, DL is new cursor position

	; Trashes AX, BX, CX, SI, DI

WriteMoveCursor	PROC	NEAR
	CMP	AL, 20h
	JAE	WMC_Print
	CMP	AL, 07h
	JE	WMC_Bell
	CMP	AL, 08h
	JE	WMC_BackSpace
	CMP	AL, 0Ah
	JE	WMC_LineFeed
	CMP	AL, 0Dh
	JE	WMC_Return

WMC_Print:
	PUSH	DX			; Save cursor position
	CALL	GraphWriteXY
	POP	DX			; Restore it

	INC	DL			; Move to next col.
	CMP	DL, byte ptr VID_ncols	; Wrapped of end of line?
	JAE	WMC_NewLine		; if so, start new line
WMC_Exit:
	RET

WMC_NewLine:
	MOV	DL, 0			; start new line & do a line feed..
WMC_LineFeed:
	INC	DH			; Move on to next line
	CMP	DH, VID_lastrow		; off end of screen?
	JBE	WMC_Exit		; if not, update & exit
	DEC	DH
	PUSH	DX
	CALL	VID_ScrollUpOne
	POP	DX
	RET

WMC_Bell:
	CALL	kbd_beep
	RET

WMC_BackSpace:
	CMP	DL, 0
	JE	WMC_Exit
	DEC	DL
	RET

WMC_Return:
	MOV	DL, 0
	RET

WriteMoveCursor	ENDP

; CGA graphics subroutines **************************************************

	; GetCGAPixelAddr is used by the read/write pixel routines

	; It is passed CX = column, DX = row of pixel
	; & returns ES:BX = pointer to byte containing pixel
	; CL = bit position within byte of pixel 0..7
	; AX is preserved

GetCGAPixelAddr	PROC NEAR

	MOV	BX, 0		; Starting address
	SHR	DX, 1		; Is it an 'odd' row?
	JNC	GPA_evenrow
	MOV	BX, 2000H	; Starting address for odd rows
GPA_evenrow:
	SHL	DX, 4		; DX = (row/2) * 16
	ADD	BX, DX
	SHL	DX, 2		; DX = (row/2) * 64
	ADD	BX, DX		; BX = base + (row/2) * 80
	MOV	DX, CX
	SHR	DX, 3
	ADD	BX, DX		; BX = base + (row/2)*80 + (col/8)
	AND	CL, 7
	XOR	CL, 7		; CL = 7 - (col MOD 8)
	MOV	DX, 0B800H
	MOV	ES, DX
	RET

GetCGAPixelAddr	ENDP

; VGA graphics subroutines ******************************************

; This gets a VGA address into ES:SI, & bit pattern into CH
	; given CX = X, DX = Y, BH = page no.
	; Address = (X/8) + Y*n_columns + BH * pgsize
	; bit = 80H >> (X and 7)

GetVGAPixelAddr PROC NEAR

	MOV	AL, byte ptr [VID_pgsize+1]	; Assume page = n*256
	MUL	BH			; AX = page*pagesize/256
	MOV	BH, AL

	MOV	AX, VID_ncols
	MUL	DX			; DX:AX = Y*n_columns
	ADD	AH, BH			; AX = Y*n_columns + page*pagesize

	MOV	SI, CX
	SHR	SI, 3			; SI = X/8
	ADD	SI, AX			; SI = VGA address

	AND	CL, 7
	MOV	CH, 80H
	SHR	CH, CL

	MOV	AX, 0A000H
	MOV	ES, AX
	RET
GetVGAPixelAddr ENDP

; GetM13PixelAddr **************************
	; GetM13PixelAddr is entered with CX=X, DX=Y, and returns
	; ES:SI pointing to the VGA address of that pixel

	; Address = X + Y*320

GetM13PixelAddr PROC NEAR
	
	MOV	SI, DX
	SHL	SI, 6		; SI = Y*64
	ADD	CH, DL		; CX = X + Y*256
	ADD	SI, CX		; SI = X+ Y*(256+64)
	MOV	CX, 0A000H
	MOV	ES, CX
	RET

GetM13PixelAddr ENDP

; ********************************************************************

	; GraphWriteXY
	; This is used as a generic write-character routine
	; It is entered with
	;   AL = character
	;   BH = page number, BL = foreground colour +80h if XOR plotting
	;   DH = row, DL = column
	;   DS = BIOS data segment

	; It must preserved ES, DS, but will trash AX, BX, CX, DX, SI and DI

GraphWriteXY PROC NEAR
	MOV	CL, VID_Mode
	CMP	CL, 13h			; Super-VGA mode?
	JA	GWXY_SVGA		; Assume VGA for now!!
	MOV	CH, 0
	MOV	SI, CX
	ADD	SI, SI
	JMP	CS:WriteXYDispatch[SI]	; Call routine according to mode

GWXY_Exit:
	RET

	; Graphics Character-write dispatch table **************

WriteXYDispatch	DW	GWXY_Text	; Mode 0
		DW	GWXY_Text	; Mode 1
		DW	GWXY_Text	; Mode 2
		DW	GWXY_Text	; Mode 3
		DW	GWXY_Modes45	; Mode 4
		DW	GWXY_Modes45	; Mode 5
		DW	GWXY_Mode6	; Mode 6
		DW	GWXY_Text	; Mode 7
		DW	GWXY_Exit	; Mode 8
		DW	GWXY_Exit	; Mode 9
		DW	GWXY_Exit	; Mode 0Ah
		DW	GWXY_Exit	; Mode 0Bh
		DW	GWXY_Exit	; Mode 0Ch
		DW	GWXY_VGA	; Mode 0Dh
		DW	GWXY_VGA	; Mode 0Eh
		DW	GWXY_VGA	; Mode 0Fh
		DW	GWXY_VGA	; Mode 10h
		DW	GWXY_VGA	; Mode 11h
		DW	GWXY_VGA	; Mode 12h
		DW	GWXY_Mode13	; Mode 13h
	

; VGA Character plot dispatch routine ***********************************

GWXY_SVGA:	; Assume always VGA-compatible for now!!
GWXY_VGA:
	; At this point *******************************************
	; DH = row, DL = column, AL = character, BL = colour (+80h for
	; XOR plotting), and BH is page number.
	; base of the required graphics page.

	; First, set SI = offset into character generator *********

	MOV	CL, VID_charheight
	MUL	CL			; AX = character * charheight
	MOV	SI, AX

	; Next set DI = video offset ******************************

	; = BH*pgsize + row * charheight * n_columns  + col

	MOV	AL, byte ptr [VID_pgsize+1]
	MUL	BH
	MOV	BH, AL			; BH = BH*(pgsize>>8)

	MOV	AL, DH
	MUL	CL			; AX = row * charheight

	MOV	CL, DL			; CX = column
	MOV	CH, 0

	MUL	VID_ncols		; DX:AX = row*charheight*ncols
	ADD	AX, CX			; + column
	ADD	AH, BH			; + Page*Pgsize

	MOV	DI, AX			

	; Set Graphics Controller registers ***********************

	MOV	DX, IO_VGA_GraphRegs

	MOV	AL, GR_SetRes		; Put Set/Reset reg = zero
	MOV	AH, 0
	OUT	DX, AX

	MOV	AL, GR_SetResEn		; Set/Res enable = NOT colour
					; i.e. all bits which are zero
					; in the colour will have
	MOV	AH, BL			; Set/Reset enabled, thus
	AND	AH, 0Fh			; always clearing them to 0.
	XOR	AH, 0Fh
	OUT	DX, AX

	TEST	BL, 80H
	JZ	GWXY_VGA_NoXor
	MOV	AL, GR_OpRotate
	MOV	AH, 018H		; Is it XOR plotting?
	OUT	DX, AX	
GWXY_VGA_NoXor:

	; Assume Write Mode 0!!

	; Set up registers for plot ******************************

	MOV	DX, VID_ncols
	MOV	CL, VID_charheight
	MOV	CH, 0
	CLD

	; Set up segment registers *******************************

	PUSH	DS
	PUSH	ES
	MOV	AX, 0			; First, retrieve base of
	MOV	DS, AX			; character generate at INT 43H
	ADD	SI, word ptr DS:[043h*4]
	MOV	DS, word ptr DS:[043h*4+2]
	MOV	AX, 0A000h
	MOV	ES, AX

	; Do the plotting ***************************************

GWXY_VGA_1:
	CMP	ES:[DI], AL		; Read existing data into latches
	LODSB
	MOV	ES:[DI], AL		; Write back
	ADD	DI, DX
	LOOP	GWXY_VGA_1

	POP	ES
	POP	DS

	MOV	DX, IO_VGA_GraphRegs
	MOV	AL, GR_SetResEn		; Put Set/Reset enable reg = zero
	MOV	AH, 0			; 'VGAHDW' plane write thing.
	OUT	DX, AX

	TEST	BL, 80H			; BL held 'XOR' attribute
	JZ	GWXY_VGA_Exit		;  If we did 'XOR' plotting,
	MOV	AL, GR_OpRotate		; reinstate the GraphOp register
	MOV	AH, 0H
	OUT	DX, AX	
GWXY_VGA_Exit:
	RET


; CGA Character plot routines ******************************************

GWXY_Modes45:	; Modes 4 & 5 text plot routine

	; DH = row, DL = column, AL = character, BL = colour (+80h for
	; XOR plotting)

	PUSH	DS
	PUSH	ES

	CALL	CGA_GetCharPtr	; Set ES:SI for character in AL

	; Offset on screen is given by
	;  Row * 320 + Column * 2
	; Calculate this into DI

	ADD	DL, DL
	MOV	DI, DX			; DX = Row*256+Col*2
	MOV	DL, 0
	SHR	DX, 2			; DX = Row * 64
	ADD	DI, DX			; DI = row * 320 + col*2

	; Set up pointers

	MOV	AX, ES		; Put DS:SI = char source pointer
	MOV	DS, AX

	MOV	AX, 0B800h	; Put ES:DI = screen dest pointer
	MOV	ES, AX

	MOV	AL, BL		; Save BL bit 7 (XOR bit)

	AND	BX, 3		; Point BX at appropriate 16-byte
	SHL	BX, 4		; colour expand table
	ADD	BX, offset CS:CGA_ExpandTbl

	MOV	CX, 4
	CLD
	TEST	AL, 80h		; Is it XOR plotting?
	JNZ	CGA_W45_Xor

CGA_W45_Mov:
	LODSB
	CALL	CGA_Expand45
	MOV	ES:[DI], AX
	LODSB
	CALL	CGA_Expand45
	MOV	ES:[DI+2000h], AX
	ADD	DI, 80
	LOOP	CGA_W45_Mov

	POP	ES
	POP	DS
	RET

CGA_W45_Xor:
	LODSB
	CALL	CGA_Expand45
	XOR	ES:[DI], AX
	LODSB
	CALL	CGA_Expand45
	XOR	ES:[DI+2000h], AX
	ADD	DI, 80
	LOOP	CGA_W45_Xor

	POP	ES
	POP	DS
	RET

		; **************************

GWXY_Mode6:	; Mode 6 text plot routine
	; DH = row, DL = column, AL = character, BL = colour (+80h for
	; XOR plotting)

	PUSH	DS
	PUSH	ES

	CALL	CGA_GetCharPtr	; Set ES:SI for character in AL

	; Offset on screen is given by
	;  Row * 320 + Column
	; Calculate this into DI

	MOV	DI, DX			; DI = row*256+column
	MOV	DL, 0
	SHR	DX, 2			; DX = row * 64
	ADD	DI, DX			; DI = row*320+column

	; Set up pointers

	MOV	AX, ES		; Put DS:SI = char source pointer
	MOV	DS, AX

	MOV	AX, 0B800h	; Put ES:DI = screen dest pointer
	MOV	ES, AX

	CLD
	MOV	CX, 4

	MOV	DX, 0		; Set DX = 0 if black
	TEST	BL, 1		; or all 1's if white
	JZ	CGA_W6_Black
	MOV	DX, 0FFFFh
CGA_W6_Black:

	TEST	BL, 80h		; Is it XOR plotting?
	JNZ	CGA_W6_XOR

CGA_W6_Mov:
	LODSW
	AND	AX, DX
	MOV	ES:[DI], AL
	MOV	ES:[DI+2000h], AH
	ADD	DI, 80
	LOOP	CGA_W6_Mov

	POP	ES
	POP	DS
	RET

CGA_W6_Xor:
	LODSW
	AND	AX, DX
	XOR	ES:[DI], AL
	XOR	ES:[DI+2000h], AH
	ADD	DI, 80
	LOOP	CGA_W6_Xor

	POP	ES
	POP	DS
	RET


	; Mode 13h text plot routine **********************************

	; DH = row, DL = column, AL = character, BL = colour (+80h for
	; XOR plotting), BH = backgnd colour

GWXY_Mode13:
	PUSH	DS
	PUSH	ES

	; Get character offset ( = AL * charheight )

	MOV	CL, VID_charheight
	MUL	CL
	MOV	SI, AX	

	; Screen offset is given by
	; 8 * column + 320*charheight*row	

	MOV	AL, DH
	MUL	CL			; AX = row * charheight

	SHL	AX, 6
	MOV	DI, AX			; DI = row * charheight * 64
	SHL	AX, 2
	ADD	DI, AX			; DI = row * charheight * 320
	MOV	DH, 0
	SHL	DX, 3			; DX = column * 8
	ADD	DI, DX			; DI = screen address


	MOV	AX, 0			; First, retrieve base of
	MOV	DS, AX			; character generate at INT 43H
	ADD	SI, word ptr DS:[043h*4]
	MOV	DS, word ptr DS:[043h*4+2]
	MOV	AX, 0A000h
	MOV	ES, AX
	CLD
	XOR	BL, BH

	; At this point
	; DS:SI = source character to plot
	; CL = char height
	; ES:DI = screen location for plot
	; BL = foregnd EOR backgnd, BH = backgnd colour


GWXY_M13_L1:
	MOV	CH, 8
	LODSB

GWXY_M13_L2:
	CBW			; If MSB(AL) is set, AH = 0FFh
	AND	AH, BL		; If set AH = Fgnd EOR Bgnd, Else AH=0
	XOR	AH, BH		; If set AH = Fgnd Else AH = Bgnd
	MOV	ES:[DI], AH	; Write to vid memory
	INC	DI
	SHL	AL, 1		; Get next bit of AL
	DEC	CH		; Next column
	JNZ	GWXY_M13_L2
	ADD	DI, 312
	DEC	CL
	JNZ	GWXY_M13_L1

	POP	ES
	POP	DS
	RET


	; Text mode plot routines **************************************

	; Enter with DX = cursor position, BH = page, AL = character
	; BL = attribute
	; This uses VID_pgaddr correctly

GWXY_Text:
	PUSH	ES
	MOV	CL, AL			; Preserve char in CL
	MOV	CH, BL			; Attrib in CH
	CALL	VID_GetCurPosRC		; Set ES:BX to address of
					; row DH, col DL, page BH
	MOV	ES:[BX], CX		; Send character to screen
	POP	ES
	RET

GraphWriteXY ENDP



; GraphWriteXY subroutines *********************************************

	; CGA_GetCharPtr ---------------

	; CGA_GetCharPtr is used by the CGA modes 4-6 text plotting
	; routines. It sets ES:SI to point to the pixel data
	; for the character given in AL. Characters 0-7Fh are
	; found from the INT 43h vector, whereas 80-FFh come from
	; a table pointed to by Int vector 1Fh
	; 19/Jul/93 - CGA always assumes chars are 8 high.

	; AX is corrupted.
	
CGA_GetCharPtr	PROC NEAR
	MOV	SI, 0
	MOV	ES, SI

	MOV	SI, 1Fh*4
	TEST	AL, 80h			; Is it a graphics character?
	JNZ	CGA_GCP1		; If so, read 1Fh vector
	MOV	SI, 43h*4		; Else read 43h vector
CGA_GCP1:
	LES	SI, dword ptr ES:[SI]	; Get vector
	AND	AX, 07Fh
	SHL	AX, 3
	ADD	SI, AX
	RET

CGA_GetCharPtr	ENDP


	; CGA Expand45 -------------------

	; CGA_Expand45 is used by the Modes 4 and 5 text plotting routines
	; to do a 1-to-2 pixel expansion: AL is the input and AX is the
	; result, so that AL bit 0 goes to AX bits 0..1, AL bit 1 goes
	; to AX 2..3, and so on. Writing in different colours is 
	; achieved by using a different table to expand the pixels. This
	; is ready set-up on entry in BX

CGA_Expand45	PROC NEAR

	MOV	AH, AL		; Save pixel data
	AND	AL, 0Fh		; Isolate bits 0.3
	XLAT	CS:[BX]		; Expand
	XCHG	AH, AL		; Save as MSB, get original char back

	SHR	AL, 4
	XLAT	CS:[BX]
	RET

CGA_Expand45	ENDP	

CGA_ExpandTbl:
	DB	00000000b, 00000000b, 00000000b, 00000000b
	DB	00000000b, 00000000b, 00000000b, 00000000b
	DB	00000000b, 00000000b, 00000000b, 00000000b
	DB	00000000b, 00000000b, 00000000b, 00000000b

	DB	00000000b, 00000001b, 00000100b, 00000101b
	DB	00010000b, 00010001b, 00010100b, 00010101b
	DB	01000000b, 01000001b, 01000100b, 01000101b
	DB	01010000b, 01010001b, 01010100b, 01010101b

	DB	00000000b, 00000010b, 00001000b, 00001010b
	DB	00100000b, 00100010b, 00101000b, 00101010b
	DB	10000000b, 10000010b, 10001000b, 10001010b
	DB	10100000b, 10100010b, 10101000b, 10101010b

	DB	00000000b, 00000011b, 00001100b, 00001111b
	DB	00110000b, 00110011b, 00111100b, 00111111b
	DB	11000000b, 11000011b, 11001100b, 11001111b
	DB	11110000b, 11110011b, 11111100b, 11111111b

	; *****************************************************



