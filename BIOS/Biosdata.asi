; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSDATA.ASI	Definitions for BIOS RAM data
;
; Versions
; 0.1	12-08-91 INH	Original
;	10-11-91	SYS_Warmboot position
;	06-02-92	SVC interrupts in use
;	13-02-92	Mouse Interrupts
;	26-02-92	Mouse data changed
;	11-03-92	New mouse data
;	30-10-92	(0.97) VGA_Pt1ptr (etc) added
;	24-02-93	Shifted mouse variables
; 1.24	07-01-94	HD BIOS data area added
;	27-01-94	Xtd BIOS data seg. added
;     1998-03.20 MB     VESA 2.0 vars added to extended bit
; *****************************************************************

BIOSData	SEGMENT PARA at BIOSDataSeg

		ORG	0

	; 00h
SER_porttbl	DW	0, 0, 0, 0
PRN_porttbl	DW	0, 0, 0
SYS_XDataSeg	DW	0		; Pointer to Xtd Data segment
SYS_equipmt	DW	0
		DB	0		; "Manufacturing test port"
SYS_RAMsize	DW	0
		DW	0		; "Manufacturing test port"
	; 17h
KBD_shifts	DB	0
KBD_xshifts	DB	0
KBD_altvalue	DB	0
KBD_outptr	DW	0
KBD_inptr	DW	0
KBD_buffer	DB	32 DUP (?)
	; 3Eh
FDD_intflag	DB	0
FDD_motorstat	DB	0
FDD_timer	DB	0
FDD_lasterr	DB	0
	; 42h
FDD_cmdbuf	DB	7 DUP (?)
	; 49h
VID_mode	DB	0
VID_ncols	DW	0
VID_pgsize	DW	0
VID_pgaddr	DW	0
VID_curstbl	DW	0, 0, 0, 0, 0, 0, 0, 0
	; 60h
VID_curstype	DW	0
VID_actpage	DB	0
VID_CRTCport	DW	0
VID_modereg	DB	0
VID_palreg	DB	0
	; 67h
SYS_resetptr	DD	0
SYS_lastbadint	DB	0
TIC_daytime	DW	0
TIC_daytimeH	DW	0
TIC_rollover	DB	0
KBD_break	DB	0
SYS_warmboot	DW	0
	; 74h
HDD_lasterr	DB	0
HDD_ndrives	DB	0
HDD_ctrlbyte	DB	0
HDD_CmdByte	DB	0
			; This should be 'Fixed disk port offset'
	; 78h
PRN_timetbl	DB	0, 0, 0, 0
SER_timetbl	DB	0, 0, 0, 0
KBD_bufstart	DW	0
KBD_bufend	DW	0
	; 84h
VID_lastrow	DB	0		; 84h Number of rows minus one
VID_charheight	DB	0		; 85h
		DB	0		; 86h (high byte of charheight)
VID_ctrlbits	DB	0		; 87h bit 0 clear if cursor emulation on
VID_switches	DB	0		; 88h
VID_VGActrl	DB	0		; 89h
VGA_DCCndx	DB	0		; 8Ah
	; 8Bh
FDD_DataRate	DB	0
HDD_StatusReg	DB	0
HDD_ErrReg	DB	0
HDD_IntFlag	DB	0
	; 8Fh
FDD_drvflags	DB	0
FDD_mediastate	DB	0, 0		; Media state for drives 0,1
FDD_workarea	DB	0, 0
FDD_currtrack	DB	0, 0		; Current track for drives
	; 96h
KBD_miscstat	DB	0
KBD_LEDstat	DB	0
SYS_waitptr	DD	0
SYS_waitval	DW	0
SYS_waitvalH	DW	0
	; A0h
SYS_waitflag	DB	0
		DB	7 DUP (?)	; Used by LANs apparently
VGA_Pt1Ptr	DW	0
VGA_Pt1Seg	DW	0
	; B0h
	; Extras defined by us
SYS_BlkMvStat	DB	0		; Status for block move Int15/87h

HPC_Status	DB	0		; Copy of HPC status port

HPC_MemSegA	DW	0		; Segment address of shared memory
					; buffer A (used by HD/FD BIOS)
HPC_MemSegB	DW	0		; Segment address of shared memory
					; buffer B (used by user processes)
HDD_cfgbits	DB	0		; bit 0: Hard Disk 0 - 1 is IDE, 0=HPC
					; bit 1: Hard Disk 1 - 1 is IDE, 0=HPC
					; bit 4 set if Hard Disk 0 is RISCOS and
					; Hard Disk 1 is a local 'Master'.
FDD_ndrives	DB	0		; Number of drives
FDD_present	DB	0		; Bits for real floppy drives,
					; bit 0: 1 if 'real' floppy 0
					; bit 1: 1 if 'real' floppy 1
MOU_enabled	DB	0		; bit 0 set if we're enabled


; According to Boardmaker, the region 40:F0 to 40:F3 is reserved for use by
; overlay managers et al.

		ORG	100h
PRN_ScreenLock	DB	0

BIOSData	ENDS


; Extended data segment -------------------------------------------------

; The BIOS grabs itself an extended chunk of RAM at 09FC0h to hold such
; information as the HD parameter tables and the mouse data, because
; the standard segment at 0040h is now too small.


BIOSXData	SEGMENT PARA at BIOSXDataSeg

MOU_DataStart:

MOU_ModeFlags	DB	0		; Current video mode flags

MOU_HandlerMask	DW	0, 0, 0, 0
MOU_HandlerOfs	DW	0, 0, 0, 0
MOU_HandlerSeg	DW	0, 0, 0, 0

MOU_Xpos	DW	0
MOU_Ypos	DW	0

MOU_ShowCount	DB	0
MOU_Buttons	DB	0

MOU_Xmotion	DW	0
MOU_Ymotion	DW	0

MOU_LPressCount	DB	0
MOU_LPressX	DW	0
MOU_LPressY	DW	0
MOU_LRlseCount	DB	0
MOU_LRlseX	DW	0
MOU_LRlseY	DW	0
MOU_RPressCount	DB	0
MOU_RPressX	DW	0
MOU_RPressY	DW	0
MOU_RRlseCount	DB	0
MOU_RRlseX	DW	0
MOU_RRlseY	DW	0

MOU_Xmin	DW	0
MOU_Ymin	DW	0
MOU_Xmax	DW	0
MOU_Ymax	DW	0
MOU_XspeedShift	DB	0
MOU_YspeedShift	DB	0

MOU_Xspeed	DW	0
MOU_Yspeed	DW	0
MOU_DblSpeedVal	DW	0
MOU_PtrPage	DB	0

MOU_DataLen	EQU	$ - offset MOU_DataStart

; Hard disk parameter tables

HDD_Drv0Parms	DrvParmTbl <>		; Parameters for hard drive 0

HDD_Drv1Parms	DrvParmTbl <>		; Parameters for hard drive 1

; Floppy disk information bytes

FDD_MAX_DRIVES	equ	2

FDD_driveinfo	DB	FDD_MAX_DRIVES dup (0)


; Various HPC Buffers

HPC_CallBlock	HPC_CallParms <>	; Parameters for calls made by BIOS

HPC_CmdBuf	DB	32 dup (?)	; Work area for hard disk read/write
HPC_ResBuf	DB	32 dup (?)	; Buffer for commands & results

VID_VESAMode	DW	0
VID_DACWidth	DB	0

TIC_demotics	DD	0

BIOSXData	ENDS

