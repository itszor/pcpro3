; ****************************************************************
;
; DIVA Project 80386 code
;
; BIOSRAM.ASI	BIOS RAM test
;
; Versions
; 0.1	 7-10-91 INH	Original
;	04-03-92	Rewritten, not using EMS
;	20-06-94	Uses MSC_SendCR
;	21-07-94	16M RAM size adjusted
;     11-03-1998 MB     Added reporting of VRAM (Gemini only now)
;                       (and suggestion on ROM failure)
; *****************************************************************

; Get total RAM size routine ********************************

; Return with total installed RAM in Kbytes in AX

RAM_GetRAMsize	PROC NEAR


	MOV	AL, 03h			; Read RAMMAP register in SCAMP
	OUT	IO_CFG_Index, AL	; which is set from on-board
	IN	AL, IO_CFG_Data		; links
	CMP	AL, 0			; If 0, it's a Gemini not SCAMP
	JE	RGS_Gemini

	PUSH	BX
	AND	AX, 0Fh			; isolate bits 0-3
	MOV	BX, AX
	SHL	BX, 1
	MOV	AX, CS:RAMSizeTable[BX]	; Look up corresponding RAM size

	POP	BX
	RET

RGS_Gemini:			; Gemini's CPU.C.CPU emulates a similar set
	MOV	AL, 40h		; of registers at the same ports.
	OUT	IO_CFG_Index, AL	; Register 40h = RAM size in MB
	IN	AL, IO_CFG_Data	;
	MOV	AH, 0
	SHL	AX, 10		; Convert to size in K
	RET
RAM_GetRAMsize	ENDP

; Assumes Gemini!
RAM_GetVRAMsize	PROC NEAR
	MOV	AL, 41h
	OUT	IO_CFG_Index, AL	; Register 41h = VRAM size in MB
	IN	AL, IO_CFG_Data	;
	MOV	AH, 0
	SHL	AX, 10		; Convert to size in K
	RET
RAM_GetVRAMsize ENDP

; Assumes Gemini!
RAM_GetVRAMEmsize	PROC NEAR
	MOV	AL, 42h
	OUT	IO_CFG_Index, AL	; Register 42h = Display size in 64Ks
	IN	AL, IO_CFG_Data		;
	MOV	AH, 0
	SHL	AX, 5
	RET
RAM_GetVRAMEmsize	ENDP

RAMSizeTable	DW	512, 1024, 1536, 2048
		DW	2048, 4096, 6144, 8192
		DW	8192, 16256, 8192, 16256
		DW	3072, 5120, 12288, 12288


; RAM_ShowInfo routine *********************************************

RAM_ShowInfo	PROC	NEAR

	MOV	SI, offset CS:TotalRAMMsg	; Send 'total RAM' message
	CALL	MSC_SendMsg
	CALL	RAM_GetRAMsize		; Get total RAM size into AX
	CALL	MSC_SendNum		; Write to screen
	MOV	SI, offset CS:KbyteMsg
	CALL	MSC_SendMsg

	MOV	SI, offset CS:VRAMMsg	; Send Video RAM message
	CALL	MSC_SendMsg
	CALL	RAM_GetVRAMsize
	CMP	AX, 0
	CALL	MSC_SendNum
	MOV	SI, offset CS:KbyteMsg
	CALL	MSC_SendMsg

	RET
RAM_ShowInfo	ENDP


; RAM_RAMTest routine **********************************************

RAM_MainRAMTest	PROC	NEAR

	PUSH	DS

	MOV	SI, offset CS:MainRAMMsg	;'Main Memory' message
	CALL	MSC_SendMsg

	MOV	CX, SYS_RAMsize
	SHR	CX, 2				;CX = no. of 4K blocks

	; Write test pattern ******************

	MOV	BX, 1				;Start at block 1 (not 0)
						;to avoid corrupting stack
						;(etc).

RAM_RT_1:					;Write test pattern
	CALL	B386_RAMTWriteBlock
	INC	BX
	CMP	BX, CX
	JB	RAM_RT_1

	; Read test pattern ********************

	MOV	BX, 1
RAM_RT_2:
	CALL	B386_RAMTReadBlock
	CMP	AX, DX
	JNE	RAM_RT_Error

	INC	BX
	CMP	BX, CX
	JB	RAM_RT_2

	; Print 'OK' message and exit ***********

	MOV	AX, SYS_RAMsize			;Get main memory size
	INC	AX				;Add one for extended BIOS area!
	CALL	MSC_SendNum

	MOV	SI, offset CS:KbyteMsg
	CALL	MSC_SendMsg
	POP	DS
	RET

RAM_RT_Error:
	CALL	RAMT_ErrorMessage
	POP	DS
	RET

RAM_MainRAMTest	ENDP






; RAM_XtdRAMTest routine *****************************************

RAM_XtdRAMTest	PROC NEAR

	PUSH	DS
	MOV	SI, offset CS:XtdRAMMsg	;'Xtd Memory' message
	CALL	MSC_SendMsg

	MOV	AH, 088h		; Get extended RAM size
	INT	15h
	MOV	CX, AX

	MOV	BX, 256			; BX = starting block no
	SHR	CX, 2			; Convert into 4K blocks
	JCXZ	RAM_XRT_Exit		; If zero, skip test
	ADD	CX, BX			; Starting at 1M

	; Write test pattern ******************

RAM_XRT_1:					;Write test pattern
	CALL	B386_RAMTWriteBlock
	INC	BX
	CMP	BX, CX
	JB	RAM_XRT_1

	; Read test pattern ********************

	MOV	BX, 256
RAM_XRT_2:
	CALL	B386_RAMTReadBlock
	CMP	AX, DX
	JNE	RAM_XRT_Error

	INC	BX
	CMP	BX, CX
	JB	RAM_XRT_2

	; Print 'OK' message and exit ***********


RAM_XRT_Exit:
	MOV	AX, BX			; Convert last block checked
	SUB	AX, 256			; to memory size
	SHL	AX, 2
	CALL	MSC_SendNum		; Send number
	MOV	SI, offset CS:KbyteMsg
	CALL	MSC_SendMsg
	POP	DS
	RET

RAM_XRT_Error:
	CALL	RAMT_ErrorMessage
	POP	DS
	RET

RAM_XtdRAMTEst  ENDP


; RAMT_ErrorMessage ********************************************

	; Read error: enter here with
	; BX = 4K block number
	; SI = offset into block
	; AX = value written
	; DX = value read

RAMT_ErrorMessage	PROC NEAR

	PUSH	AX
	PUSH	SI

	MOV	SI, offset CS:RAMTErr1		; Send 'Error at' message
	CALL	MSC_SendMsg

	MOV	AX, BX				; Display MSW of address
	SHR	AX, 4
	CALL	MSC_SendHex

	POP	SI
	MOV	AX, BX				; Calculate LSW of address
	SHL	AX, 12				; = blk no << 12 + offset
	ADD	AX, SI
	CALL	MSC_SendHex			; Display LSW of address

	MOV	SI, offset CS:RAMTErr2		; Send 'Wrote' message
	CALL	MSC_SendMsg

	POP	AX				; Give correct value
	CALL	MSC_SendHex

	MOV	SI, offset CS:RAMTErr3		; Display 'Read' message
	CALL	MSC_SendMsg

	MOV	AX, DX				; Give read-back value
	CALL	MSC_SendHex

	CALL	MSC_SendCR
	RET

RAMT_ErrorMessage	ENDP

; Messages ********************************************************

TotalRAMMsg	DB	'Total RAM   : ', 0
MainRAMMsg	DB	'Main RAM    : ', 0
XtdRAMMsg	DB	'Extended RAM: ', 0
VRAMMsg		DB	'Video RAM   : ', 0
VRAM1Msg	DB	'K hardware', 13, 0
VRAM2Msg	DB	'K emulated', 13, 10, 0
KbyteMsg	DB	'K', 13, 10, 0

RAMTErr1	DB	13, 10, 07, 'ERROR at address ',0
RAMTErr2	DB	'H : Wrote ',0
RAMTErr3	DB	' Read ', 0
RAMTErr4	DB	13, 10, 0

ROMFailMsg	DB 	07, "ERROR: ROM failed checksum =", 0
ROMFailSuggest	DB	'(check your cache settings in !PCConfig)', 13, 10, 0


; RAM_ROMcheck routine ****************************************

; Does a simple checksum of ROM contents
; in theory, should be zero

RAM_ROMcheck	PROC	NEAR

	PUSH	DS

	MOV	AX, CS
	MOV	DS, AX

	MOV	AX, 0
	MOV 	SI, 0
	MOV	CX, BIOSROMLength
	CLD

ROMT_1:
	ADD	AL, [SI]
	INC	SI
	LOOP	ROMT_1

	POP	DS

	CMP	AL, 0
	JZ	ROMT_OK

	MOV	SI, offset CS:ROMFailMsg
	CALL	MSC_SendMsg

	CALL	MSC_SendHex

	CALL	MSC_SendCR

	MOV	SI, offset CS:ROMFailSuggest
	CALL	MSC_SendMsg

	RET

ROMT_OK:
	RET

RAM_ROMcheck	ENDP

