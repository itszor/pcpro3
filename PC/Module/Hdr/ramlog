        MACRO
        PrL $Condition,$String
 [ DoPrints>1
   B$Condition %FT3
   B  %FT2
3  BL %FT1
   B  %FT2
1  STMFD r13!,{r0,lr}   ; preserve any flags there
   PrNl
   ADR  r0,%FT4
   BL   PrintStrR0
   LDMFD r13!,{r0,pc}^
4  DCB  "$String",0
   ALIGN
2
 ]
        MEND
    
        MACRO
        PrErr   $String   
 [ ((DoPrints>1) :LAND: (DoPrints<>6))
   BVC      %FT1
   STMFD    r13!,{r0,r2,lr}
   MOV      r2,r0
   LDR      r0,[r2],#4
   BL       PrintStrR0
   BL       PrintNewLine
   BL       PrintR2        ; print error no if print enabled
   BL       PrintStrR0   ; andreport the PFB error found
   ADR      r0,%FT3
   BL       PrintStrR0
   MOV      r0,pc
   ORR      r0,r0,#V_flag
   TEQP     r0,#0
   MOVNE    r0,r0
   LDMFD    r13!,{r0,r2,lr}
   B        %FT1
3
   =        " @ "
   =        "$String"
   =        " "
   =        0
   ALIGN
1
 ]
        MEND

