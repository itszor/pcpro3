; Macros

        MACRO
        PrMBuf                  ; r1 -> mbuf chain
 [ DoPrints>0
   BL %FT1
   B  %FT2
1  STMFD r13!,{r2,r3,lr}   ; preserve any flags there
;   ToSVCE 2,3
   BL   DisplayMBuf
;   FromSVCE 2,3   
   LDMFD r13!,{r2,r3,pc}^
2
 ]
        MEND


        MACRO
        PrTime $String
 [ DoPrints>0
   BL %FT1
   B  %FT2
1  STMFD r13!,{r0,r1,lr}   ; preserve any flags there
   ToSVCE 0,1
   BL   PrintStr
   DCB  10,13,"Time:$String",0
   ALIGN
   BL TimeStamp
   FromSVCE 0,1   
   LDMFD r13!,{r0,r1,pc}^
2
 ]
        MEND

