      else
        StartWindowRunning();
      break;

    case IconMenuItem_stask:
      FocusLost();
      StopWindowRunning();
      RunInFullScreenMode();
      OpenAndStartWindow();
      break;

    case IconMenuItem_reset:
      SYS_FEState.ResetRequest = true;
      if ( CFG.UseWindowFE )
