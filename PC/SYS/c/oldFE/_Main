static void ObtainCaret()   /* Called to place the caret in main_window */
{
  wimp_caretstr caret;

  /* Give our window the input focus */

  caret.w = main_window;
  caret.i = -1;
  caret.x = caret.y = 0;
  caret.height = 0;
  caret.index = 0;

  wimpt_noerr(wimp_set_caret_pos(&caret) );
}

static void LoseCaret()   /* Called to place the caret in main_window */
{
  wimp_caretstr caret;

  /* Give our window the input focus */

  caret.w = -1;
  caret.i = -1;
  caret.x = caret.y = 0;
  caret.height = 0;
  caret.index = 0;

  wimpt_noerr(wimp_set_caret_pos(&caret) );
}

