/* test for presence of StrongARM */

static bool CheckForSA()
{
  _kernel_swi_regs R;
  _kernel_oserror *err;

  R.r[0] = 0;
  err = _kernel_swi ( 0x6D /*OS_PlatformFeatures*/, &R, &R );

  if ( (err == NULL) && ((R.r[0] & 0x1F) == 0x1F) ) /* SA present if SWI recognised & bits 0-4 set*/
  {
    SYS_trace ("StrongARM detected");
    return TRUE;
  }
  else

  return FALSE;

}
