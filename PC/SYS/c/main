/* Find Version of RISCOS in use ******************************** */

static int GuessRISCOSversion() /* returns 3 for RISCOS 3 */
{
  _kernel_swi_regs R;

  R.r[0] = 129;
  R.r[1] = 0;
  R.r[2] = 255;
  _kernel_swi ( OS_Byte, &R, &R );

  if ( R.r[1] >= 0xA8 )
    return 4;
  if ( R.r[1] >= 0xA3 )
    return 3;

  return 2;
}

