static bool ModesHardReset()
{
  WIN_WinModeActive = false;
  VID_PortsHardReset();      /* Set up ports for mode 3 */
  VID_UpdateModeVars();
  memset ( VIDS_MemoryBlk, 0, VID_MemorySize);
  VID_AreaChanged ( 0, VID_PCXtotal-1, 0, VID_PCYtotal-1, 1 );
  return false;
}

