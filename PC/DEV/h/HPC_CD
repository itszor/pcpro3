/* Acorn C/C++ 5's swis.h defines CD_Control, CDFS's SWI, as a number. */
#undef CD_Control
extern void CD_Control ( struct CD_CONTROL_PARAMS *pIn,
                         struct CD_CONTROL_RESULT *pOut );

