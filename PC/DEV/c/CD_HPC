#define MKWORD(a,b) ( ((b)<<8) + (a) )    /* Little endian ! */
#define MKLONG(a,b,c,d) ( ((d)<<24) + ((c)<<16) + ((b)<<8) + (a) )


#define CD_WORKING 0x100
#define CD_CHANGED 0x200

