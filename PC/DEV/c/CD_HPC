#if ASM_CDREAD
#else
static DRIVE *GetDrive ( int drvnum )
{
  DRIVE *p;
  if ( drvnum < 0 || drvnum >= MAXDRIVES )
    return NULL;

  p = &CD_Drives[drvnum];
  if ( p->flags & CD_WORKING )
    return p;
  else
    return NULL;
}
#endif
