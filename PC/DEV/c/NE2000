#define CR_DMASEND  0x18
#define CR_DMAABORT 0x20


/* RdDecodeTable & WrDecodeTable ------------------- */

/* RdDecodeTable and WrDecodeTable are given an I/O offset and a page
   number, and are used to find out which register this refers to. If the
   table entry has the 'ACT' bit set, action must be taken (via RdRegAction
   or WrRegAction) to read or write the data in this register.
*/

static BYTE  RdDecodeTable [16][4] =
{
  CR    |ACT, CR    |ACT, CR  |ACT, CR  |ACT,
  CLDA0,      PAR0,       PSTART,   noRd,
  CLDA1,      PAR1,       PSTOP,    noRd,
  BNDRY,      PAR2,       RNPP,     noRd,
  TSR   |ACT, PAR3,       TPSR,     noRd,
  NCR,        PAR4,       LNPP,     noRd,
  FIFO,       PAR5,       ADRC0,    noRd,
  ISR   |ACT, CURR  |ACT, ADRC1,    noRd,
  CRDA0 |ACT, MAR0,       noRd,     noRd,
  CRDA1 |ACT, MAR1,       noRd,     noRd,
  noRd,       MAR2,       noRd,     noRd,
  noRd,       MAR3,       noRd,     noRd,
  RSR   |ACT, MAR4,       RCR,      noRd,
  CNTR0,      MAR5,       TCR,      noRd,
  CNTR1,      MAR6,       DCR,      noRd,
  CNTR2 |ACT, MAR7,       IMR,      noRd
};

static BYTE  WrDecodeTable [16][4] =
{
  CR    |ACT, CR    |ACT, CR  |ACT, CR  |ACT,
  PSTART|ACT, PAR0,       CLDA0,    noWr,
  PSTOP |ACT, PAR1,       CLDA1,    noWr,
  BNDRY |ACT, PAR2,       RNPP,     noWr,
  TPSR,       PAR3,       noWr,     noWr,
  TBCR0,      PAR4,       LNPP,     noWr,
  TBCR1,      PAR5,       ADRC0,    noWr,
  ISR   |ACT, CURR  |ACT, ADRC1,    noWr,
  RSAR0 |ACT, MAR0  |ACT, noWr,     noWr,
  RSAR1 |ACT, MAR1  |ACT, noWr,     noWr,
  RBCR0 |ACT, MAR2  |ACT, noWr,     noWr,
  RBCR1 |ACT, MAR3  |ACT, noWr,     noWr,
  RCR   |ACT, MAR4  |ACT, noWr,     noWr,
  TCR,        MAR5  |ACT, noWr,     noWr,
  DCR,        MAR6  |ACT, noWr,     noWr,
  IMR   |ACT, MAR7  |ACT, noWr,     noWr
};

/* NE2000 board state --------------------------------------------- */

static BYTE NE2_Prom   [PROM_LEN] =
{
  0, 0, 0, 0, 0, 0,
  0x20, 0x00, 1, 0, 0, 0, 0, 0, 0x57, 0x57,
  0, 0, 0, 0, 0, 0,
  0x20, 0x00, 1, 0, 0, 0, 0, 0, 0x42, 0x42
};

static int               NE2_IntNum;
static BYTE              NE2_Regs   [REGS_MAX];
static int               NE2_PageNo;
static int               NE2_DMAaddr;
static int               NE2_DMAcount;
static struct BufHeader *NE2_Hdr;
static BYTE             *NE2_RAMbuf;
static bool              NE2_Enabled;
static bool              NE2_IntActive = false;

/* The fast path (see 'Fast path', below) */
static bool PV_Active = false;
static void PV_Notify ( void );


/* Misc routines =============================================== */

static void NE2_Enable ( bool Enable )
{
  regs(0) = Enable ? 1 : 0;
  SWI ( PCNE2_Enable );
  NE2_Enabled = Enable;
}

/* ---------------------------------------- */

static void ResetNE2State ( void )
{
  NE2_Enable(false);

  copy6 ( (char *)NE2_Prom,        NE2_Hdr->NetAddr );
  copy6 ( (char *)NE2_Prom + 0x10, NE2_Hdr->NetAddr );

  NE2_Regs[CR]   = CR_STOP | CR_DMAABORT;
  NE2_Regs[DCR]  = 0x04;
  NE2_Regs[IMR]  = 0;
  NE2_Regs[TCR]  = 0;

  NE2_PageNo     = 0;
  NE2_DMAaddr    = 0;
  NE2_DMAcount   = 0;

  NE2_Regs[ISR] |= isrRESET;
  NE2_Hdr->OvflowCount = 0;
  NE2_IntActive  = false;

}

/* ---------------------------------------- */

/* NetIntCheck() is called whenever something has happened which
   might cause an interrupt. It may be called on a callback by the
   PCNE2 module, when a packet has been received or transmitted.

   As of 1/Mar/96, we allow the interrupt to be cancelled, because
   the RM NE2000 NDIS driver uses this as a method of finding out
   which IRQ line we're using.
*/

static void NetIntCheck ( void )
{
  register int t;

  if ( PV_Active )
  {
    PV_Notify();
    return;
  }

  t = NE2_Regs[ISR] | NE2_Hdr->TxIntStatus | NE2_Hdr->RxIntStatus;

#if DEBUG
  static int lastt=0;

  if ( t != lastt )
    SYS_trace("Status %Xh->%Xh", lastt, t);
  lastt=t;
#endif

  if ( (t & NE2_Regs[IMR] & 0x7F) != 0 )
  {
     if ( !NE2_IntActive )
     {
#if DEBUG
       SYS_trace("IRQ: status %X", t);
#endif
       NE2_IntActive=true;
       SYS_Interrupt ( NE2_IntNum );
     }
  }
  else
  {
    if ( NE2_IntActive )
    {
      NE2_IntActive=false;
      SYS_Interrupt ( NE2_IntNum | IRQ_CLEAR_BIT );
    }
  }
}

/* ----------------------------------------- */

static void UpdateReceiveOptions()
{
  BYTE *p = &NE2_Regs[MAR0];

  regs(0) = NE2_Regs[RCR];   /* Receive config options */
  regs(1) = (int) p;   /* Multicast Address filter bits */

  /* Optimisation: don't do multicast if all filter bits are zero */

  if (( p[0] | p[1] | p[2] | p[3] | p[4] | p[5] | p [6] | p[7] ) == 0 )
    regs(0) &= ~RCR_MULTICAST;

  SWI ( PCNE2_SetRxOptions );
}

/* Data movement routines ================================================ */

/* Data movement on and off the NE2000 is done using the 'Remote DMA'
   channel. This addresses 64K of memory space containing a 32-byte
   PROM repeated from 0-3FFF and 8000-BFFF, and a 16K RAM buffer
   from 4000-7FFF and C000-FFFF.  We have to be mildly cagey about
   doing the right thing even when the DMA counters have silly values
   in, hence the defensive programming.
*/

/* -------------------------------------------- */

static void DMALengthCheck ( int len )
{
  /* Len should be > 0, otherwise some actions may be repeated */
  NE2_DMAaddr  += len;
  NE2_DMAcount -= len;

  /* 8390's DMA Wraps round apparently */

  if ( NE2_DMAaddr == NE2_Regs[PSTOP] << 8 )
    NE2_DMAaddr = NE2_Regs[PSTART] << 8;

  if ( NE2_DMAcount <= 0 )
  {
    NE2_DMAcount  &= 0xFFFF;           /* Wrap round! */
    NE2_Regs[ISR] |= isrDMA_COMPLETE;  /* Show DMA complete */
    NetIntCheck();                     /* Might have caused interrupt */
  }
}




/* -------------------------------------------- */

static void DoBlockDMA ( bool OutNotIn )
{
  int len, addr, pstop;
  pstop = NE2_Regs[PSTOP] << 8;

  /* This does block I/O as rapidly as possible, where it is to & from
     NE2 RAM */

  while ( NE2_DMAcount != 0 )
  {
    /* Can't do it if it doesn't start in RAM */
    if ( (NE2_DMAaddr & RAM_SEL_BIT)==0)
      break;

    /* Set initial values */

    addr = NE2_DMAaddr & RAM_AMASK;
    len  = NE2_DMAcount;

    /* Stop if we will hit the end of RAM */
    if ( len + addr > RAM_LEN )
     len = RAM_LEN-addr;

    /* Stop if we will hit the PSTOP address */
    if ( (NE2_DMAaddr+len > pstop) && (NE2_DMAaddr < pstop) )
      len = pstop-NE2_DMAaddr;

    /* Get as many data bytes as will go */
    if ( OutNotIn )
      len = CPU_BlockOut ( BLOCK_DATA_PORT, NE2_RAMbuf+addr, len );
    else
      len = CPU_BlockIn  ( BLOCK_DATA_PORT, NE2_RAMbuf+addr, len );

    if ( len == 0 ) /* PC isn't playing ball */
      break;

    if ( NE2_Regs[DCR] & 1 )   /* If word DMA mode */
      len = (len + 1) & (~1);  /* round up to next word */

    DMALengthCheck(len);       /* Update pointers, wrapping, etc */
  }
}

/* -------------------------------------------- */

static void DataWrite ( int data )
{
  if ( NE2_Regs[DCR] & 1 )   /* If word DMA mode */
  {
    if ( NE2_DMAaddr & RAM_SEL_BIT )
    {
      NE2_RAMbuf[ NE2_DMAaddr & (RAM_AMASK-1) ] = data;
      NE2_RAMbuf[(NE2_DMAaddr & RAM_AMASK) | 1] = data >> 8;
    }
    DMALengthCheck(2);
  }
  else
  {
    if ( NE2_DMAaddr & RAM_SEL_BIT )
      NE2_RAMbuf[NE2_DMAaddr & RAM_AMASK] = data;

    DMALengthCheck(1);
  }
}

/* -------------------------------------------- */

static int DataRead ( void )
{
  int res;

  if ( NE2_Regs[DCR] & 1 )   /* If word DMA mode */
  {
    if ( NE2_DMAaddr & RAM_SEL_BIT )
    {
      res =  NE2_RAMbuf[ NE2_DMAaddr & (RAM_AMASK-1) ]
          + (NE2_RAMbuf[(NE2_DMAaddr & RAM_AMASK) | 1] << 8);
    }
    else
      res = NE2_Prom[ (NE2_DMAaddr & PROM_AMASK) >> 1 ];

    DMALengthCheck(2);
  }
  else
  {
    if ( NE2_DMAaddr & RAM_SEL_BIT )
      res = NE2_RAMbuf[NE2_DMAaddr & RAM_AMASK];
    else
      res = NE2_Prom[ (NE2_DMAaddr & PROM_AMASK) >> 1 ];

    DMALengthCheck(1);
  }
  return res;
}


/* Write Command Reg action routine ===================================== */


static void CommandRegAction ( int data )
{
  NE2_PageNo   = (data >> 6) & 3;
  NE2_Regs[CR] =  data & (~CR_TRANSMIT);

  /* Stop/start bits ================= */

  if ( data & CR_STOP )
  {
    if ( NE2_Enabled )
    {
      NE2_Regs[CR] |= CR_START;     /* Strange 8390 behaviour */
      NE2_Enable(false);
    }
    NE2_Regs[ISR] |= isrRESET;
  }

  else if ( data & CR_START )
  {
    if ( !NE2_Enabled )
    {
      NE2_Enable(true);
    }
    NE2_Regs[ISR] &= ~isrRESET;
  }


  /* Remote DMA actions =============== */

  switch ( data & CR_DMAMASK )
  {
    case CR_DMAREAD:
      DoBlockDMA ( false );
      break;

    case CR_DMAWRITE:
      DoBlockDMA ( true );
      break;

    case CR_DMASEND:
      SYS_trace("Unsupported: 8390 Send Command"); /* !! */
      break;

    default:
      break;
  }

  /* Transmit start bit =============== */

  if ( data & CR_TRANSMIT )
  {
    if ( NE2_Enabled )
    {
      /* Calculate address in R0 from Tx Page Start Register */
      regs(0) =  ((NE2_Regs[TPSR] << 8) & RAM_AMASK);

      /* R1 is packet length */
      regs(1) = NE2_Regs[TBCR0] + ( NE2_Regs[TBCR1] << 8 );

#if DEBUG
      SYS_trace("Tx: page start = %X, len=%X", NE2_Regs[TPSR], regs(1) );
      SYS_tracedata ( NE2_RAMbuf+regs(0), 16 );
#endif
      SWI ( PCNE2_Transmit );
    }
  }


}

/* Read and Write action routines ======================================= */

static int RdRegAction ( int reg )
{
  switch ( reg )
  {
    case CR:
      return NE2_Regs[CR] + (NE2_Hdr->TxInProgress ? CR_TRANSMIT : 0);

    case ISR:
      return NE2_Regs[ISR] | NE2_Hdr->TxIntStatus | NE2_Hdr->RxIntStatus;

    case TSR:
      return NE2_Hdr->TxStatus;

    case RSR:
      return NE2_Hdr->RxStatus;

    case CURR:
      return NE2_Hdr->RxCURR;

    case CRDA0:
      return (NE2_DMAaddr & 0xFF);

    case CRDA1:
      return ((NE2_DMAaddr >> 8) & 0xFF);

    case CNTR2: /* Overrun counter */
      return NE2_Hdr->OvflowCount;

    default:
      break;
  }
  return NE2_Regs[reg];
}

/* ---------------------------------------------------------------- */

static void WrRegAction ( int reg, int data )
{
  switch ( reg )
  {
    case CR:  /* Command register */
      CommandRegAction ( data );
      break;

    /* Writing a 1 bit to the Interrupt status register clears the
       corresponding interrupt flag */

    case ISR:
      if ( data & (isrTX_OK | isrTX_FAIL) )
        NE2_Hdr->TxIntStatus &= ~data;
      if ( data & (isrRX_OK | isrRX_FAIL | isrRX_OVERRUN) )
        NE2_Hdr->RxIntStatus &= ~data;
      NE2_Regs[ISR] &= ~(data & 0x7F);

      NetIntCheck();
      break;

    case IMR:
      NetIntCheck();
      break;

    case CURR:
      NE2_Hdr->RxCURR  = data;
      break;

    case BNDRY:
#if DEBUG
      SYS_trace("Set Bndry=%X", data);
#endif
      NE2_Hdr->RxBNDRY = data;
      break;

    case PSTART:
      NE2_Hdr->RxPSTART= data;
      break;

    case PSTOP:
      NE2_Hdr->RxPSTOP = data;
      break;

    case RSAR0:
      NE2_DMAaddr = (NE2_DMAaddr & 0xFF00) | data;
      break;

    case RSAR1:
      NE2_DMAaddr = (NE2_DMAaddr & 0xFF) | (data << 8);
      break;

    case RBCR0:
      NE2_DMAcount = (NE2_DMAcount & 0xFF00) | data;
      break;

    case RBCR1:
      NE2_DMAcount = (NE2_DMAcount & 0xFF) | (data << 8);
      break;

    case RCR:
    case MAR0:   case MAR1:   case MAR2:   case MAR3:
    case MAR4:   case MAR5:   case MAR6:   case MAR7:
      UpdateReceiveOptions();
      break;

    default:
      break;
  }
}


/* I/O Handlers ========================================================= */

static void NE2_Out8 ( int addr, int data )
{
  switch ( addr & 0x18 )
  {
    case 0x10:  /* Offset 10-17h: Data port */
      DataWrite(data);
      return;

    case 0x0:   /* Offset 00-0Fh: Register write */
    case 0x8:
      {
        int reg = WrDecodeTable[addr & 0xF][NE2_PageNo];

        NE2_Regs[ reg & 0x3F ] = data;
        if ( reg & ACT )
          WrRegAction ( reg & 0x3F, data );
      }
      return;

   case 0x18:
      ResetNE2State();
      return;
  }
}

/* ---------------------------------------- */

static void NE2_Out16 ( int addr, int data )
{
  if ( (addr & 0x18) == 0x10 )
    DataWrite(data);
  else
  {
    NE2_Out8 ( addr,   data & 0xFF );
    NE2_Out8 ( addr+1, data >> 8   );
  }
}

/* ---------------------------------------- */

static int  NE2_In8 ( int addr )
{
  int tmp;

  switch ( addr & 0x18 )
  {
    case 0x10:  /* Offset 10-17h: Data port */
      return DataRead();

    case 0x0:   /* Offset 00-0Fh: Register Read */
    case 0x8:
      tmp = RdDecodeTable[addr & 0xF][NE2_PageNo];

      if ( tmp & ACT )
        return RdRegAction ( tmp & 0x3F );

      return NE2_Regs[ tmp & 0x3F ];

   case 0x18:
      ResetNE2State();
      break;
  }
  return 0;
}

/* ---------------------------------------- */

static int  NE2_In16 ( int addr )
{
  if ( (addr & 0x18) == 0x10 )
    return DataRead();
  else
  {
    register int tmp=NE2_In8 (addr);
    return tmp + (NE2_In8(addr+1) << 8 );
  }
}

/* ---------------------------------------- */

/* Fast path ==============================================================

   A driver that knows of it can use the same card - the same PCNE2
   connection, Ethernet address and interrupt - without the 8390: frames
   go both ways through two rings in memory shared by the PC and the ARM,
   which the ARM reads and writes directly. A frame then costs the PC one port write to
   send, and a batch of them one port read to receive, where the 8390's
   remote DMA costs a mailbox access for every word. A driver that does
   not know of it sees an NE2000 as before.

   Ports, 16-bit:

     PV_CMD   write: command; read: PV_ID if the fast path is there, or
              after PVCMD_WHERE, the shared block's address >> 4 and then
              its length >> 4
     PV_PARLO write: parameter bits 0-15; read: PV_VERSION
     PV_PARHI write: parameter bits 16-31; read: how the last attach went
              (PVA_*), as the status word says, but through the mailbox:
              for when the PC can't see what the ARM wrote
     PV_KICK  write: frames are waiting to be sent; the value is the low
              16 bits of the new tx_head (see 'Write interlock'). Not
              needed while tx_busy is set: the ARM is already sending, and
              looks for more before it clears it.
              read: what interrupted (PVINT_*), which also clears the
              interrupt

   Commands:

     PVCMD_WHERE   the next two reads of PV_CMD give the shared block's
                   PC address >> 4 (0 if there is none) and its length >>
                   4. It is in the E0000-EFFFF window: 32K if the Windows
                   driver isn't given any (SharedMemFlags bit 2), else 16K, from CPU_AllocSharedMem
                   as HPC's buffers are: on a real card the Gemini's L2
                   cache holds the PC's ordinary RAM (CFGR_RAM_CACHED) and
                   does not see the ARM write to it, whatever the PC's page
                   tables say, while this window it leaves alone.
     PVCMD_ATTACH  parameter = the shared block's PC address, from
                   PVCMD_WHERE. The PC fills in the block with status 0
                   and writes the magic word last. Shortly after (on a
                   callback), the ARM checks it, empties both rings, gives
                   the Ethernet address, sets status to 1 (or a negative
                   PVERR_*), and starts receiving. The PC waits for the
                   status to change.
     PVCMD_DETACH  stop, and go back to being an NE2000.
     PVCMD_RXOPTS  parameter = RCR_BROADCAST/MULTICAST/PROMISC, with the
                   multicast filter in the block.
     PVCMD_RXKICK  the PC has made room in the receive ring after the ARM
                   found it full (rx_stalled).

   The shared block, little-endian words, in memory the PC does not cache:

     W_MAGIC .. W_SIZE   set by the PC before attaching
     tx_head, rx_tail, flags, rx_stalled (cleared)   written by the PC
     tx_tail, tx_busy, rx_head, rx_stalled (set), status, mac, counters
                                                           by the ARM

   Each ring holds records: a word with the frame's length in its low 16
   bits, then the frame (from its destination address, no CRC), padded to
   a word. Heads and tails are byte offsets in the ring, wrapping at its
   size, which is a multiple of 4; a record may wrap round the end. A ring
   is empty when head == tail, so it is never filled to the last word.

   Write interlock. On the Gemini card the PC's stores reach memory
   through a write FIFO, but its I/O reaches the ARM at once, so a kick
   can arrive before the frames it is about. The PC writes the frames,
   then tx_head, then the kick with tx_head's low bits; the ARM waits for
   tx_head to reach that value, and the FIFO keeps the writes in order, so
   by then the frames are there too. Attaching waits for the magic word
   in the same way. The waiting is done on a callback, never in the port
   handler: the FIFO does not empty while the PC is held in the mailbox
   on the port write, so a wait there could only time out (as HPC 1.1's
   does, on its callback). So commands that read the block (ATTACH,
   RXOPTS) are carried out a little after the port write, and the PC
   waits for the status word.

   Receiving uses PCNE2 as the NE2000 does: it writes each frame into its
   RAM at RxCURR. Here that RAM is just a staging ring, pages
   PV_RX_PSTART-PV_RX_PSTOP, which PV_RxDrain empties into the PC's ring.
   Frames to send are copied into pages PV_TX_PAGE onwards and given to
   PCNE2_Transmit, which sends at once.
*/

#define PV_FIRST        0x310   /* 0x300-7 are HPC's, 0x308-B Windrv's */
#define PV_LAST         0x317
#define PV_CMD          (PV_FIRST+0)
#define PV_PARLO        (PV_FIRST+2)
#define PV_PARHI        (PV_FIRST+4)
#define PV_KICK         (PV_FIRST+6)

#define PV_ID           0x4E50   /* "PN" */
#define PV_VERSION      3        /* 1 had the rings in the PC's own RAM,
                                    2 power-of-two rings in a 16K block */

#define PV_SHM_LEN      0x4000   /* The shared block: 16K, or */
#define PV_SHM_BIGLEN   0x8000   /*   32K when Windrv has none */

#define PVCMD_ATTACH    1
#define PVCMD_DETACH    2
#define PVCMD_RXOPTS    3
#define PVCMD_RXKICK    4
#define PVCMD_WHERE     5

#define PVINT_RX        1        /* frames in the receive ring */
#define PVINT_TXSPACE   2        /* room in the send ring, as asked for */

#define PVF_TXSPACE     1        /* flags: interrupt when frames are sent */

#define PVERR_MAGIC     (-1)     /* status values */
#define PVERR_LAYOUT    (-2)
#define PVERR_ADDRESS   (-3)     /* not the shared block */

#define PVA_NONE        0        /* PV_PARHI's reading: no attach asked */
#define PVA_ATTACHED    1        /*   attached; or a PVERR_* */
#define PVA_PENDING     2        /*   asked, callback not yet run */

#define PV_MAGIC        0x4E435041  /* "APCN" */

/* Word offsets in the shared block */
#define W_MAGIC         0
#define W_VERSION       1
#define W_SIZE          2        /* of the whole block, bytes */
#define W_TXOFF         3
#define W_TXSIZE        4
#define W_RXOFF         5
#define W_RXSIZE        6
#define W_TXHEAD        7
#define W_TXTAIL        8
#define W_RXHEAD        9
#define W_RXTAIL        10
#define W_FLAGS         11
#define W_RXSTALLED     12
#define W_STATUS        13
#define W_MAC0          14       /* bytes 0-3 */
#define W_MAC1          15       /* bytes 4-5 */
#define W_MCAST0        16       /* the 8390's multicast filter */
#define W_MCAST1        17
#define W_TXFRAMES      18
#define W_TXERRORS      19
#define W_RXFRAMES      20
#define W_RXDROPPED     21
#define W_TXBUSY        22       /* the ARM is sending: no kick needed */
#define W_HDRWORDS      32

#define PV_MAXFRAME     1514
#define PV_SPINS        200000   /* Some tens of ms */

/* PCNE2's RAM: frames to send from page 40h, received into 46h-7Fh */
#define PV_TX_PAGE      0x40
#define PV_RX_PSTART    0x46
#define PV_RX_PSTOP     0x80

static volatile unsigned *PV_Sh;  /* The shared block, as the ARM sees it */
static BYTE    *PV_TxRing, *PV_RxRing;
static unsigned PV_TxSize, PV_RxSize;
static int      PV_ParLo, PV_ParHi;
static int      PV_TxKick;        /* tx_head's low bits from the last kick */
static bool     PV_KickWaiting;   /* PV_TxWork should wait for PV_TxKick */
static int      PV_IntCause;
static bool     PV_IntUp;
static bool     PV_Busy, PV_Again;
static BYTE     PV_MultiMask[8];
static Callback PV_TxCB, PV_RxCB, PV_CmdCB;
static unsigned PV_AttachAddr;    /* Commands waiting for PV_CmdWork */
static bool     PV_AttachPending;
static int      PV_RxOpts;
static bool     PV_RxOptsPending;
static int      PV_AttachResult;  /* PVA_* or PVERR_*, for PV_PARHI */
static BYTE    *PV_ShmARM;        /* The shared block, or NULL */
static unsigned PV_ShmPC;         /* its PC address */
static unsigned PV_ShmLen;
static int      PV_WhereReads;    /* PV_CMD reads left of PVCMD_WHERE's */
static int      PV_Waits, PV_Timeouts;

/* Ring copies, either way round the end ----------------------------- */

static unsigned PV_Wrap ( unsigned pos, unsigned size )
{
  return pos >= size ? pos - size : pos;
}

static unsigned PV_Used ( unsigned head, unsigned tail, unsigned size )
{
  return head >= tail ? head - tail : head + size - tail;
}

/* Room for a record: a ring is never filled to the last word */

static unsigned PV_Room ( unsigned head, unsigned tail, unsigned size )
{
  return size - 4 - PV_Used ( head, tail, size );
}

static void PV_RingWrite ( BYTE *ring, unsigned size, unsigned pos,
                           BYTE *src, unsigned len )
{
  unsigned off = PV_Wrap ( pos, size );
  unsigned first = size - off;

  if ( first > len )
    first = len;
  memcpy ( ring + off, src, first );
  if ( len > first )
    memcpy ( ring, src + first, len - first );
}

static void PV_RingRead ( BYTE *dst, BYTE *ring, unsigned size,
                          unsigned pos, unsigned len )
{
  unsigned off = PV_Wrap ( pos, size );
  unsigned first = size - off;

  if ( first > len )
    first = len;
  memcpy ( dst, ring + off, first );
  if ( len > first )
    memcpy ( dst + first, ring, len - first );
}

static unsigned PV_RingWord ( BYTE *ring, unsigned size, unsigned pos )
{
  return *(volatile unsigned *)(ring + PV_Wrap ( pos, size ));
}

/* Interrupts --------------------------------------------------------- */

static void PV_Raise ( int cause )
{
  PV_IntCause |= cause;
  if ( !PV_IntUp )
  {
    PV_IntUp = true;
    SYS_Interrupt ( NE2_IntNum );
  }
}

static int PV_TakeCause ( void )
{
  int cause = PV_IntCause;

  PV_IntCause = 0;
  if ( PV_IntUp )
  {
    PV_IntUp = false;
    SYS_Interrupt ( NE2_IntNum | IRQ_CLEAR_BIT );
  }
  return cause;
}

/* Receiving ---------------------------------------------------------- */

/* Copies one frame's data out of PCNE2's staging ring, which wraps from
   PV_RX_PSTOP back to PV_RX_PSTART */

static void PV_StagingRead ( BYTE *dst, unsigned addr, unsigned len )
{
  unsigned start = PV_RX_PSTART << 8, stop = PV_RX_PSTOP << 8;

  while ( len > 0 )
  {
    unsigned seg;

    if ( addr >= stop )
      addr = start + (addr - stop);
    seg = stop - addr;
    if ( seg > len )
      seg = len;
    memcpy ( dst, NE2_RAMbuf + (addr & RAM_AMASK), seg );
    dst  += seg;
    addr += seg;
    len  -= seg;
  }
}

/* Moves whatever PCNE2 has received into the PC's ring. May be entered
   again from a callback while it runs: then it just says so, and the
   outer one goes round again. */

static void PV_RxDrain ( void )
{
  struct BufHeader *pH = NE2_Hdr;
  int intstate;

  intstate = _kernel_irqs_disabled();
  _kernel_irqs_off();
  if ( PV_Busy )
  {
    PV_Again = true;
    if ( !intstate ) _kernel_irqs_on();
    return;
  }
  PV_Busy = true;
  if ( !intstate ) _kernel_irqs_on();

  do
  {
    unsigned head, tail, delivered = 0;
    int curr;

    PV_Again = false;
    if ( !PV_Active )
      break;

    head = PV_Sh[W_RXHEAD];
    tail = PV_Sh[W_RXTAIL];
    curr = pH->RxCURR;

    while ( pH->RxBNDRY != curr )
    {
      BYTE *p = NE2_RAMbuf + ((pH->RxBNDRY << 8) & RAM_AMASK);
      int next = p[1];
      unsigned len = (p[2] | (p[3] << 8)) - 4;
      unsigned rec = (4 + len + 3) & ~3u;
      unsigned word;

      if ( len < 14 || len > PV_MAXFRAME + 4 ||
           next < PV_RX_PSTART || next >= PV_RX_PSTOP )
      {
        SYS_trace("NE2000 fast path: bad frame in staging ring, dropped");
        pH->RxBNDRY = curr;
        PV_Sh[W_RXDROPPED]++;
        break;
      }

      if ( PV_Room ( head, tail, PV_RxSize ) < rec )
      {
        /* No room: the PC sends PVCMD_RXKICK when it has made some */
        PV_Sh[W_RXSTALLED] = 1;
        tail = PV_Sh[W_RXTAIL];
        if ( PV_Room ( head, tail, PV_RxSize ) < rec )
          break;
      }

      word = len;
      PV_RingWrite ( PV_RxRing, PV_RxSize, head, (BYTE *)&word, 4 );
      {
        /* Into the ring directly when it doesn't wrap there */
        unsigned off = PV_Wrap ( head + 4, PV_RxSize );

        if ( off + len <= PV_RxSize )
          PV_StagingRead ( PV_RxRing + off, (pH->RxBNDRY << 8) + 4, len );
        else
        {
          PV_StagingRead ( SYS_TempBuf, (pH->RxBNDRY << 8) + 4, len );
          PV_RingWrite ( PV_RxRing, PV_RxSize, head + 4, SYS_TempBuf,
                         len );
        }
      }
      head = PV_Wrap ( head + rec, PV_RxSize );
      pH->RxBNDRY = next;
      delivered++;
    }

    if ( delivered != 0 )
    {
      /* The ring's contents first, then its head, then the interrupt */
      PV_Sh[W_RXHEAD] = head;
      PV_Sh[W_RXFRAMES] += delivered;
      PV_Raise ( PVINT_RX );
    }
  }
  while ( PV_Again );

  PV_Busy = false;
  pH->RxIntStatus = 0;
}

/* Called when PCNE2 has received or sent something, and from the poll */

static void PV_Notify ( void )
{
  NE2_Hdr->TxIntStatus = 0;
  PV_RxDrain();
}

static void PV_RxWork ( int x )
{
  NotUsed(x);
  PV_RxDrain();
}

/* Sending ------------------------------------------------------------ */

static void PV_TxWork ( int x )
{
  unsigned head, tail;
  int spins = 0;
  NotUsed(x);

  if ( !PV_Active )
    return;

  if ( PV_KickWaiting )
  {
    PV_KickWaiting = false;
    while ( (PV_Sh[W_TXHEAD] & 0xFFFF) != PV_TxKick )
    {
      if ( ++spins >= PV_SPINS )
      {
        if ( ++PV_Timeouts <= 10 )
          SYS_trace("NE2000 fast path: tx_head %X never came",
                    PV_TxKick);
        break;
      }
    }
    if ( spins > 0 && spins < PV_SPINS && ++PV_Waits <= 10 )
      SYS_trace("NE2000 fast path: waited %d spins for frames", spins);
  }

  tail = PV_Sh[W_TXTAIL];

  for (;;)
  {
    head = PV_Sh[W_TXHEAD];

    while ( tail != head )
    {
      unsigned len = PV_RingWord ( PV_TxRing, PV_TxSize, tail ) & 0xFFFF;
      unsigned rec = (4 + len + 3) & ~3u;

      if ( len < 14 || len > PV_MAXFRAME ||
           rec > PV_Used ( head, tail, PV_TxSize ) )
      {
        SYS_trace("NE2000 fast path: bad record (length %d), ring reset",
                  len);
        PV_Sh[W_TXERRORS]++;
        tail = head;
        break;
      }

      PV_RingRead ( NE2_RAMbuf + ((PV_TX_PAGE << 8) & RAM_AMASK),
                    PV_TxRing, PV_TxSize, tail + 4, len );
      regs(0) = (PV_TX_PAGE << 8) & RAM_AMASK;
      regs(1) = len;
      SWI ( PCNE2_Transmit );
      if ( regs(0) == 0 )
        PV_Sh[W_TXFRAMES]++;
      else
        PV_Sh[W_TXERRORS]++;

      tail = PV_Wrap ( tail + rec, PV_TxSize );
    }

    PV_Sh[W_TXTAIL] = tail;

    /* Kicks resume once tx_busy is clear, so look once more after
       clearing it: anything queued before then is sent now. */
    PV_Sh[W_TXBUSY] = 0;
    if ( PV_Sh[W_TXHEAD] == tail )
      break;
    PV_Sh[W_TXBUSY] = 1;
  }

  NE2_Hdr->TxIntStatus = 0;

  if ( PV_Sh[W_FLAGS] & PVF_TXSPACE )
    PV_Raise ( PVINT_TXSPACE );
}

/* Attaching and detaching -------------------------------------------- */

static void PV_Detach ( void )
{
  if ( !PV_Active )
    return;
  PV_Active = false;
  (void) PV_TakeCause();
  PV_Sh = NULL;
  ResetNE2State();    /* An NE2000 again, stopped */
  SYS_trace("NE2000 fast path: detached");
}

static void PV_Attach ( unsigned addr )
{
  volatile unsigned *sh;
  unsigned size, txoff, txsize, rxoff, rxsize;
  int spins = 0;
  char *mac = NE2_Hdr->NetAddr;

  PV_Detach();

  if ( PV_ShmARM == NULL || addr != PV_ShmPC )
  {
    SYS_trace("NE2000 fast path: %X is not the shared block", addr);
    PV_AttachResult = PVERR_ADDRESS;
    if ( PV_ShmARM != NULL )
      ((volatile unsigned *) PV_ShmARM)[W_STATUS] = (unsigned) PVERR_ADDRESS;
    return;
  }
  sh = (volatile unsigned *) PV_ShmARM;

  /* The PC writes the magic word last: wait for it (Write interlock) */
  while ( sh[W_MAGIC] != PV_MAGIC )
  {
    if ( ++spins >= PV_SPINS )
    {
      SYS_trace("NE2000 fast path: no magic at %X (%X there)", addr,
                sh[W_MAGIC]);
      sh[W_STATUS] = (unsigned) PVERR_MAGIC;
      PV_AttachResult = PVERR_MAGIC;
      return;
    }
  }

  size   = sh[W_SIZE];
  txoff  = sh[W_TXOFF];
  txsize = sh[W_TXSIZE];
  rxoff  = sh[W_RXOFF];
  rxsize = sh[W_RXSIZE];

  if ( sh[W_VERSION] != PV_VERSION ||
       size > PV_ShmLen ||
       (txsize & 3) != 0 || (rxsize & 3) != 0 ||
       txsize < 2048 || rxsize < 2048 ||
       (txoff & 3) != 0 || (rxoff & 3) != 0 ||
       txoff < W_HDRWORDS*4 || rxoff < W_HDRWORDS*4 ||
       txoff + txsize > size || rxoff + rxsize > size ||
       (txoff < rxoff + rxsize && rxoff < txoff + txsize) )
  {
    SYS_trace("NE2000 fast path: bad layout at %X", addr);
    sh[W_STATUS] = (unsigned) PVERR_LAYOUT;
    PV_AttachResult = PVERR_LAYOUT;
    return;
  }

  PV_Sh     = sh;
  PV_TxRing = (BYTE *) sh + txoff;
  PV_RxRing = (BYTE *) sh + rxoff;
  PV_TxSize = txsize;
  PV_RxSize = rxsize;

  sh[W_TXTAIL]     = sh[W_TXHEAD] = 0;
  sh[W_RXHEAD]     = sh[W_RXTAIL] = 0;
  sh[W_RXSTALLED]  = 0;
  sh[W_TXBUSY]     = 0;
  sh[W_TXFRAMES]   = sh[W_TXERRORS] = 0;
  sh[W_RXFRAMES]   = sh[W_RXDROPPED] = 0;
  sh[W_MAC0] = (mac[0] & 0xFF) | ((mac[1] & 0xFF) << 8) |
               ((mac[2] & 0xFF) << 16) | ((unsigned)(mac[3] & 0xFF) << 24);
  sh[W_MAC1] = (mac[4] & 0xFF) | ((mac[5] & 0xFF) << 8);

  /* PCNE2's RAM as a staging ring, emptied */
  NE2_Enable(false);
  NE2_Hdr->RxPSTART = PV_RX_PSTART;
  NE2_Hdr->RxPSTOP  = PV_RX_PSTOP;
  NE2_Hdr->RxCURR   = PV_RX_PSTART;
  NE2_Hdr->RxBNDRY  = PV_RX_PSTART;
  NE2_Hdr->RxIntStatus = NE2_Hdr->TxIntStatus = 0;
  if ( NE2_IntActive )
  {
    NE2_IntActive = false;
    SYS_Interrupt ( NE2_IntNum | IRQ_CLEAR_BIT );
  }

  PV_IntCause = 0;
  PV_IntUp = false;
  PV_KickWaiting = false;
  PV_Busy = PV_Again = false;
  PV_Active = true;

  regs(0) = RCR_BROADCAST;
  SWI ( PCNE2_SetRxOptions );
  NE2_Enable(true);

  sh[W_STATUS] = 1;
  PV_AttachResult = PVA_ATTACHED;
  SYS_trace("NE2000 fast path: attached at %X, rings %X+%X, %X+%X",
            addr, txoff, txsize, rxoff, rxsize);
}

static void PV_SetRxOptions ( int rcr )
{
  unsigned m0, m1;
  int i;

  if ( !PV_Active )
    return;
  m0 = PV_Sh[W_MCAST0];
  m1 = PV_Sh[W_MCAST1];
  for ( i = 0; i < 4; i++ )
  {
    PV_MultiMask[i]   = (m0 >> (8*i)) & 0xFF;
    PV_MultiMask[i+4] = (m1 >> (8*i)) & 0xFF;
  }
  regs(0) = rcr & (RCR_BROADCAST | RCR_MULTICAST | RCR_PROMISC);
  regs(1) = (int) PV_MultiMask;
  if ( (m0 | m1) == 0 )
    regs(0) &= ~RCR_MULTICAST;
  SWI ( PCNE2_SetRxOptions );
}

/* Commands that read the shared block, after the PC has gone on (see
   'Write interlock') */

static void PV_CmdWork ( int x )
{
  NotUsed(x);
  if ( PV_AttachPending )
  {
    PV_AttachPending = false;
    PV_Attach ( PV_AttachAddr );
  }
  if ( PV_RxOptsPending )
  {
    PV_RxOptsPending = false;
    PV_SetRxOptions ( PV_RxOpts );
  }
}

/* I/O handlers -------------------------------------------------------- */

static void PV_Out16 ( int addr, int data )
{
  data &= 0xFFFF;
  switch ( addr )
  {
    case PV_PARLO:
      PV_ParLo = data;
      return;

    case PV_PARHI:
      PV_ParHi = data;
      return;

    case PV_KICK:
      if ( PV_Active )
      {
        PV_Sh[W_TXBUSY] = 1;   /* Before the PC goes on: no more kicks */
        PV_TxKick = data;
        PV_KickWaiting = true;
        SYS_SetCallback ( &PV_TxCB, PV_TxWork, 0 );
      }
      return;

    case PV_CMD:
      switch ( data )
      {
        case PVCMD_ATTACH:
          PV_Detach();
          PV_AttachAddr = (unsigned) PV_ParLo | ((unsigned) PV_ParHi << 16);
          PV_AttachPending = true;
          PV_AttachResult = PVA_PENDING;
          PV_RxOptsPending = false;
          SYS_SetCallback ( &PV_CmdCB, PV_CmdWork, 0 );
          return;
        case PVCMD_DETACH:
          PV_AttachPending = false;
          PV_RxOptsPending = false;
          PV_AttachResult = PVA_NONE;
          PV_Detach();
          return;
        case PVCMD_RXOPTS:
          PV_RxOpts = PV_ParLo;
          PV_RxOptsPending = true;
          SYS_SetCallback ( &PV_CmdCB, PV_CmdWork, 0 );
          return;
        case PVCMD_RXKICK:
          if ( PV_Active )
            SYS_SetCallback ( &PV_RxCB, PV_RxWork, 0 );
          return;
        case PVCMD_WHERE:
          PV_WhereReads = 2;
          return;
      }
      break;
  }
  SYS_trace("NE2000 fast path: OUT %Xh = %Xh", addr, data);
}

static void PV_Out8 ( int addr, int data )
{
  NotUsed(addr);
  NotUsed(data);  /* All the ports are 16-bit */
}

static int PV_In16 ( int addr )
{
  switch ( addr )
  {
    case PV_CMD:
      if ( PV_WhereReads > 0 )
      {
        if ( --PV_WhereReads == 1 )
          return PV_ShmARM != NULL ? (int) (PV_ShmPC >> 4) : 0;
        return PV_ShmARM != NULL ? (int) (PV_ShmLen >> 4) : 0;
      }
      return PV_ID;
    case PV_PARLO:
      return PV_VERSION;
    case PV_PARHI:
      return PV_AttachResult & 0xFFFF;
    case PV_KICK:
      return PV_TakeCause();
  }
  return 0xFFFF;
}

static int PV_In8 ( int addr )
{
  NotUsed(addr);
  return 0xFF;
}

/* The poll: anything a lost kick or callback left behind */

static void PV_Poll ( void )
{
  if ( PV_Sh[W_TXHEAD] != PV_Sh[W_TXTAIL] )
  {
    PV_Sh[W_TXBUSY] = 1;
    SYS_SetCallback ( &PV_TxCB, PV_TxWork, 0 );
  }
  PV_RxDrain();
}

static bool PV_Reset ( void )
{
  PV_Detach();
  return false;
}

/* ---------------------------------------- */

static bool NE2_Poll ( void )
{
  /* This is put in in case the module is, for whatever reason,
     unable to call us back */
  if ( PV_Active )
    PV_Poll();
  else
    NetIntCheck();
  return false;
}

/* ---------------------------------------- */

static bool NE2_Shutdown ( void )
{
  NE2_Enable(false);
  return false;
}

/* ---------------------------------------- */

static bool NE2_SetConfig ( void )
{
  char *p;

  NE2_IntNum = CFG.NE2000Int;

  /* The fast path's shared block, once */
  if ( PV_ShmARM == NULL &&
       (CFG.SharedMemFlags & (SM_DONT_ALLOC | SM_DONT_USE)) == 0 )
  {
    struct SharedMem SM;
    bool ok;

    /* Windrv's share too, when it isn't to have one */
    SM.length = (CFG.SharedMemFlags & SM_NOT_WINDRV) ? PV_SHM_BIGLEN
                                                     : PV_SHM_LEN;
    ok = CPU_AllocSharedMem ( &SM );
    if ( !ok && SM.length != PV_SHM_LEN )
    {
      SM.length = PV_SHM_LEN;
      ok = CPU_AllocSharedMem ( &SM );
    }
    if ( ok )
    {
      PV_ShmARM = SM.ARMaddr;
      PV_ShmPC  = SM.PCaddr;
      PV_ShmLen = SM.length;
      SYS_trace("NE2000 fast path: shared block at %X, %X bytes", PV_ShmPC,
                PV_ShmLen);
    }
    else
      SYS_trace("NE2000 fast path: no shared memory left for it");
  }

  if ( !SYS_IntAvailable (NE2_IntNum) )
    SYS_error ( true, "cene2int", NE2_IntNum );

  p = NE2_Hdr->NetAddr;
  SYS_trace("NE2000 present on Port %X Int %d", NE2_FIRST, NE2_IntNum );
  SYS_trace("Net address: %02X:%02X:%02X:%02X:%02X:%02X",
              p[0], p[1], p[2], p[3], p[4], p[5] );

  if ( p[3] == 0x42 || p[4] == 0x42 || p[5] == 0x42 )
    SYS_trace("Ethernet addr may give WfWG problems");

  SYS_registerEvent ( SYS_PollChain, NE2_Poll, 0 );
  return false;
}


/* ---------------------------------------- */

extern bool NE2_Init ( void )
{

  /* Look for PCNE2 module ******** */

  regs(0) = 0;
  regs(1) = (int) NetIntCheck;
  regs(3) = 0;
  SWI ( PCNE2_Initialise );
  if ( regs(0) != 0x8390 )
    return true;

  if ( regs(3) != 177 )     /* R3 returns version number */
    SYS_error( true, "sene2ver", "v1.77");

  /* Get BufHeader & RAM buffer pointers  */

  NE2_Hdr   = (struct BufHeader *) regs(1);
  NE2_RAMbuf = (BYTE *) regs(2);

  /* Set up I/O handlers ********** */

  SYS_registerEvent ( SYS_SetConfig, NE2_SetConfig, 0 );

  SYS_registerIO ( NE2_FIRST, NE2_LAST,
                     NE2_In8, NE2_In16, NE2_Out8, NE2_Out16, 0 );
  SYS_registerEvent ( SYS_Shutdown, NE2_Shutdown, 0 );

  /* The fast path, beside it */
  SYS_registerIO ( PV_FIRST, PV_LAST, PV_In8, PV_In16, PV_Out8, PV_Out16, 0 );
  SYS_registerEvent ( SYS_HardReset, PV_Reset, 0 );

  ResetNE2State();

  /* Set normal receive support */

  regs(0) = RCR_BROADCAST;
  SWI ( PCNE2_SetRxOptions );

  return true;
}

