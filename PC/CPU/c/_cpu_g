static int PICR_value = 0;
static int IRQbits [16] =
{
  0,          PICR_IRQ1, 0,          PICR_IRQ3,
  PICR_IRQ4,  PICR_IRQ5, PICR_IRQ6,  PICR_IRQ7,
  PICR_IRQ8,  PICR_IRQ8, PICR_IRQ10, PICR_IRQ11,
  PICR_IRQ12, 0,         PICR_IRQ14, PICR_IRQ15
};

