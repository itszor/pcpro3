void CPUS_CauseInt ( int IRQno )
{
  int b;

  /*if (IRQno == 14)
  {
    IDEEm_IRQ14();
    SYS_trace("IRQ14 delivered");
  }*/

  b = IRQno & 0xFFFF; /* Assume IRQ_CLEAR_BIT is 0x10000 ! */
  if ( b > 15 )
    return;

  b = IRQbits[b];

  /* Ensure bit is clear */
  PICR_value &= ~b;
  CPUS_Write ( PICR, PICR_value );
  if ( IRQno & IRQ_CLEAR_BIT )
    return;

  CPUS_Write ( PICR, PICR_value ); /* Short delay */
  PICR_value |= b;
  CPUS_Write ( PICR, PICR_value );
}

