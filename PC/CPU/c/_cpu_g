void CPU_StopRun ( void )
{
  *CPU_pTimerWord = 0;
  *CPUS_pStopFlag = 1;
}

/* ----------------------- */

void CPU_ResetOK ( void ) /* Called to say reset succeeded */
{
  CPU_ResetInProgress = false;
  CPU_StopRun();
}

/* ----------------------- */

static void EnsureReset( void )
{
  int i;

  for (i=0; i<5; i++)
  {
    CPU_TimedRun(100);
    if ( !CPU_ResetInProgress )
      return;

    SYS_trace ("Hard Reset");
    CPU_Reset();
  }

  SYS_error ( true, "henoreset");
}

