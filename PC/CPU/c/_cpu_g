/* ------------------------------- */

static int RoundSize ( int ramsize )
{
  int i;
  for ( i=0; i < RAMSIZE_COUNT; i++ )
  {
    if ( ramsize >= ramsizes[i].val )
      return i;
  }
  return RAMSIZE_COUNT-1;
}

