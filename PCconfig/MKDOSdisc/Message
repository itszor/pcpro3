/* MakeSerialNo() function ********************************** */

/* Hashes a filename to a 32-bit volume number ************* */

int MakeSerialNo ( char * name )
{
  int res =3D 0x12345678;
  int mult =3D 0x29BF;

  while ( *name !=3D 0 )
  {
    res ^=3D ((int)*name * mult );
    mult +=3D 0x100;
    name++;
  }

  return res;
}          =20

/* PhysToLogical() function ********************************* */

int PhysToLogical ( struct DiskAddress d )
{
  return (d.sect-1) + nsects * ( d.head + nheads * d.cyl );
}
