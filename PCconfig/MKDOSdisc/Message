/*  SetBytes() ********************************************** */

void SetBytes( int offset, int value, int nbytes )
{
  while ( nbytes-- > 0 )
  {
    buf[offset++] =3D LSB(value);
    value =3D value >> 8;
  }
}


/*  WritePartitionTable() *********************************** */

void WritePartitionTable()
{
  memcpy ( buf, DefaultPartitionTable, SECT_SIZE );                  =20

  buf [0x1BF ] =3D  Part_Start.head;         /* Starting head */
  buf [0x1C0 ] =3D  Part_Start.sect          /* Starting sector */
                   + ( MSB(Part_Start.cyl) << 6 );
  buf [0x1C1 ] =3D  LSB(Part_Start.cyl);     /* Starting cylinder */

  buf [0x1C2]  =3D  part_type;

  buf [0x1C3 ] =3D  Part_End.head;           /* Ending head */
  buf [0x1C4 ] =3D  Part_End.sect            /* Ending sector */
                   + ( MSB(Part_End.cyl) << 6 );=20
  buf [0x1C5 ] =3D  LSB(Part_End.cyl);       /* Ending cylinder */
                       =20
  SetBytes( 0x1C6, part_start, 4 );        /* Starting sector */
  SetBytes( 0x1CA, part_size, 4 );
  =20
  WriteBuf(1);                /* Write partition table boot sector */
}           =20
            =20
/* WriteBootSector() **************************************** */
                                                   =20
void WriteBootSector()
{
  if ( part_type !=3D DOS5 )
  {
    memcpy ( buf, DOS3BootSector, SECT_SIZE );=20
    SetBytes ( 0x1C, part_start, 2);         /* No. of 'hidden' sects */
    SetBytes ( 0x13, part_size, 2 );         /* Size of partition */=20
  }
  else
  {
    memcpy ( buf, DOS5BootSector, SECT_SIZE );=20
    SetBytes ( 0x1C, part_start, 4);         /* No. of 'hidden' sects */
    SetBytes ( 0x20, part_size, 4 );         /* Size of partition */=20
    SetBytes ( 0x27, vol_serialno, 4 );      /* Volume serial no. */
  }

  SetBytes ( 0x0D, cluster_size, 1);       /* Cluster size */
  SetBytes ( 0x16, FAT_size, 2 );          /* Size of each FAT */
  SetBytes ( 0x18, nsects, 2 );            /* Sectors per track */
  SetBytes ( 0x1A, nheads, 2 );            /* Number of heads */
  WriteBuf(1);
                                                     =20
}

/* WriteOneFAT() ******************************************** */

/* A FAT simply needs to contain FFF8 and FFFF as its first two
   entries. In a 12-bit FAT this takes 3 bytes, in a 16-bit FAT it
   takes 4.
*/            =20

void WriteOneFAT()
{
  memset ( buf, 0, SECT_SIZE );  /* Clear buffer */

  if ( part_type =3D=3D DOS33_SMALL )  /* If 12 bit FAT */
    SetBytes ( 0x00, 0xFFFFF8, 3 );
  else
    SetBytes ( 0x00, 0xFFFFFFF8, 4 );

  WriteBuf(1);
  WriteZeroes ( FAT_size - 1 );
}



/* FormatDisk () *********************************************** */

static void FormatDisk ()
{                                                                      =20
  int i;
  /* Partition table is at start of disk */

  fseek ( outfile, 0, SEEK_SET );
  WritePartitionTable();                /* Write partition table */
  WriteZeroes ( part_start - 1 );        /* & move to start of DOS area */

  /* Boot sector is at start of DOS parition */
  WriteBootSector();             /* Writes 1 sector */
                                                         =20
  /* Write FATs after boot sector *********** */

  for (i=3D0; i<NFATs; i++ )   /* Writes NFATs * FAT_size sectors */   =20
    WriteOneFAT();         =20

  /* Write blanks for root directory */

  WriteZeroes (ROOT_DIR_SECTS);

}


/* SetParameters() ***************************************************** */

/* Sets disk_size, part_size, Part_Start, Part_End, cluster_size, FAT_size =
*/
/* given approx_size in sectors */

static BOOL SetParameters ( int approx_size )
{
  int tmp;
                                   =20
  /* Use Acorn PCEM 1.80 algorithm for heads/sects/tracks mapping */
     =20
  nsects =3D 17;

  for ( nheads=3D4; nheads < 0xFF; nheads +=3D 2 )
  { =20
    ntracks =3D approx_size / (nheads * nsects);
     if ( ntracks <=3D 1024 )
       break;
  }

  if ( nheads >=3D 0xFF || approx_size <=3D 0 )
  {
    werr ( FALSE, msgs_lookup("toobig") );
    return FALSE;
  }

  disk_size =3D nheads * ntracks * nsects;                                 =
 =20

  /* Work out how many tracks in DOS partition ************** */

  Part_Start.head =3D 1;
  Part_Start.sect =3D 1;
  Part_Start.cyl  =3D 0;
  Part_End.head =3D nheads-1;
  Part_End.sect =3D nsects;
  Part_End.cyl  =3D ntracks-1;

  /* Calculate partition addresses and size ****************** */
                            =20
  part_size  =3D PhysToLogical(Part_End) - PhysToLogical(Part_Start) + 1;
  part_start =3D PhysToLogical(Part_Start);                                =
   =20

  if ( part_size < (4085*8) )        /* Use 12-bit FAT */
  {                       =20
    part_type =3D DOS33_SMALL;
    cluster_size =3D 8;=20
    tmp =3D (part_size/8) + 2;            /* number of FAT entries */
    FAT_size =3D (tmp+339)/340;           /* 340 entries per sector */
  }
  else if ( part_size < 65535 )
  {             =20
    part_type =3D DOS33_BIG;               /* Use 16-bit FAT */            =
              =20
    cluster_size =3D 4;
    tmp =3D (part_size/4) + 2;
    FAT_size =3D (tmp+255)/256;
  }
  else
  {

    /* Pick cluster size to give < 65518 clusters */
    for ( cluster_size=3D4; part_size >=3D cluster_size*65518; cluster_size=
 *=3D 2 ) ;

    part_type =3D DOS5;          =20
    tmp =3D (part_size/cluster_size) + 2;      /* FAT holds all clusters + =
2 */
    FAT_size =3D (tmp+255)/256;
  }

  return TRUE;
}

/* ************************************ */

BOOL MakeFile ( char *filename, int size )
{
  _kernel_swi_regs R;

  R.r[0] =3D 6;            /* Delete file if already exists */
  R.r[1] =3D (int) filename;
  _kernel_swi ( OS_File, &R, &R );

  R.r[0] =3D 11;            /* Create file with type <R2> */
  R.r[1] =3D (int) filename;
  R.r[2] =3D 0xFC8;         /* DOS disk */
  R.r[4] =3D 0;
  R.r[5] =3D size;

  if ( _kernel_swi ( OS_File, &R, &R ) !=3D NULL )
  {
    werr( FALSE, msgs_lookup("nocreat"), filename );
    return FALSE;
  }

  return TRUE;
}                =20

/* Main routine ***************************************************** */

BOOL CreateDisk ( char *filename, int size_MB, BOOL InitForDOS )
{   =20
  if ( !SetParameters(size_MB * 1956) )
    return FALSE;
                  =20
  if ( !MakeFile (filename, disk_size * SECT_SIZE) )
    return FALSE;

  outfile =3D fopen ( filename, "r+b" );
  if (outfile=3D=3DNULL)
  {
    werr( FALSE, msgs_lookup("noreopen"), filename);
    return FALSE;
  }

  if ( InitForDOS )   =20
  {
    vol_serialno =3D MakeSerialNo ( filename );
    FormatDisk();              =20
  }
  else
    WriteZeroes(1);   /* Zero out partition table */

  fclose(outfile);

  return TRUE;
}

