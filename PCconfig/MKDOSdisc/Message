/* WriteBuf() *********************************************** */

/* Writes the given number of sectors from 'buf' to the output file */
=20
int WriteBuf( int n )
{
  if ( fwrite( buf, SECT_SIZE, n, outfile ) !=3D n )
  {
    fclose(outfile);
    werr (TRUE, msgs_lookup("writerr"));
    exit(1);
  }
  return n;
}

/* WriteZeroes() ******************************************** */

/* Writes the given number of zero sectors to the output file */

void WriteZeroes( int count )
{                          =20
  if ( count > BUF_SECTS )
    memset ( buf, 0, sizeof(buf) );
  else
    memset ( buf, 0, count * SECT_SIZE );
=20

  while ( count > 0 )
  {
    count -=3D WriteBuf ( count > BUF_SECTS ? BUF_SECTS : count );
  }               =20
}

