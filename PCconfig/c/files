/*
 * PCConfig application
 *
 * c.files - the parts of James Bye's file library (h.File) that PCConfig
 * uses. The library itself was linked in as C:o.files and its source is not
 * part of this release, so these are written afresh from h.File's
 * descriptions and from how LoadConfig and SaveConf call them.
 */

#include <stddef.h>

#include "kernel.h"
#include "swis.h"

#include "file.h"

_kernel_oserror *file_open(char *filename, int *handle, char *oa)
{
  _kernel_swi_regs r;
  _kernel_oserror *e;

  /* OPEN_EXIST_READ "r", OPEN_NEW_READ_WRITE "wr", OPEN_EXIST_READ_WRITE "wr+".
     In each, &08 makes a directory an error and, for the two that open an
     existing file, &04 makes a missing one an error too. */
  if (oa[0] == 'r')
    r.r[0] = 0x4c;
  else if (oa[1] == 'r' && oa[2] == '+')
    r.r[0] = 0xcc;
  else
    r.r[0] = 0x88;
  r.r[1] = (int)filename;
  e = _kernel_swi(OS_Find, &r, &r);
  if (e != NULL)
    return e;
  *handle = r.r[0];
  return NULL;
}

_kernel_oserror *file_close(int handle)
{
  _kernel_swi_regs r;

  r.r[0] = 0;
  r.r[1] = handle;
  return _kernel_swi(OS_Find, &r, &r);
}

_kernel_oserror *file_writeabyte(int handle, int byte)
{
  _kernel_swi_regs r;

  r.r[0] = byte;
  r.r[1] = handle;
  return _kernel_swi(OS_BPut, &r, &r);
}

/* The string as it is: SaveConf writes the newline after it itself. */
int file_writealine(int handle, char *string, int string_size)
{
  _kernel_swi_regs r;

  if (string_size <= 0)
    return 0;
  r.r[0] = 2;
  r.r[1] = handle;
  r.r[2] = (int)string;
  r.r[3] = string_size;
  return _kernel_swi(OS_GBPB, &r, &r) == NULL ? 0 : -1;
}

_kernel_oserror *file_load(char *filename, int address)
{
  _kernel_swi_regs r;

  r.r[0] = 16;
  r.r[1] = (int)filename;
  r.r[2] = address;
  r.r[3] = 0;
  return _kernel_swi(OS_File, &r, &r);
}

/* *type is the object type: 0 for nothing there, 1 a file, 2 a directory. */
_kernel_oserror *file_readcat(char *filename, int *type, int *laddr, int *eaddr,
                              int *length, int *attrib)
{
  _kernel_swi_regs r;
  _kernel_oserror *e;

  r.r[0] = 17;
  r.r[1] = (int)filename;
  e = _kernel_swi(OS_File, &r, &r);
  if (e != NULL)
    return e;
  if (type != NULL)
    *type = r.r[0];
  if (laddr != NULL)
    *laddr = r.r[2];
  if (eaddr != NULL)
    *eaddr = r.r[3];
  if (length != NULL)
    *length = r.r[4];
  if (attrib != NULL)
    *attrib = r.r[5];
  return NULL;
}
