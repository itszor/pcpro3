static int atoi_h(char *s)
{
  int v;

  if (*s == '&') sscanf(s+1, "%x", &v); else v=atoi(s);
  return(v);
}

static char *strip_header(char *option)
{
  /* Strip header up to and including all spaces */
  while(*(option) != ' ' && *(option++) != '\0');
  while(*(option++) == ' ');
  return(--option);
}

