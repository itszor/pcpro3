int cancel_ok(char *text, char *buttons)
{
  _kernel_swi_regs r;
  _kernel_oserror e;
  e.errnum = 0;
  sprintf(&e.errmess[0],"%s\0",text);
  r.r[0] = (int)&e;
  r.r[1] = 0x910;
  r.r[2] = (int)lookup_token("_TaskName");
  r.r[3] = NULL;
  r.r[4] = NULL;
  r.r[5] = (int) buttons;
  _kernel_swi(Wimp_ReportError,&r,&r);
  /*return wimp_report_error(&e,3,lookup_token("_TaskName"));*/
  fprintf(stderr, "== %d\n", r.r[1]);
  return !(r.r[1]-3);
}

void check_for_modified_data(int *settings, int *tmp_settings, int size)
{
  if(memcmp(settings, tmp_settings, size) != NULL)
  {
    if(!window_title_updated)
    {
      char buff[256];
      raise_error(window_get_title(0,main_window,buff,256,NULL));
      strcat(buff, " *");
      raise_error(window_set_title(0,main_window,buff));
      window_title_updated = TRUE;
      configuration_changed = TRUE;
    }
  }
}

char *get_leaf_name(char *buffer)
{
  int len;

  len = strlen(buffer);
  while(*(buffer+len--) != '.' && len != 0);

  /* If seperator found, return pointer to leaf name, otherwise return buffer */
  if(*(buffer+len+1) == '.')
   return(buffer+len+2);

  return(buffer);
}

void broadcast_pc_message(int msg_num, int reason, char *file)
{
  int pc_msg[64];

  pc_msg[0] = 256;
  pc_msg[3] = 0;
  pc_msg[4] = 0x44680; /* 'About to start' message */
  pc_msg[5] = 0; /* Reason code; leave it for now */
  strcpy( ((char*) pc_msg)+24, file);
  wimp_send_message(17, pc_msg, 0, 0, 0);
}
