extern  ObjectId       iconbar_icon = 0,
                       main_window = 0,
                       discs_window = 0,
                       createdisc_window = 0,
                       printing_window = 0,
                       serial_window = 0,
                       windows_window = 0,
                       aspi_window = 0,
