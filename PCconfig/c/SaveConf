  config_lines[x++] = "\0";

  config_lines[x++] = "# Approximate size of RAM available to PC Card\0";
  copy_text_to_ptr("PCRAM",config.memory.memory_allocated,&config_lines[x++]);
  config_lines[x++] = "\0";
  config_lines[x++] = "# Minimum amount to allocate for display emulation\0";
