      sprintf(buffer, "HD1-File-Name %s\0",config.discs.drive_d_path_name);
      copy_text_to_ptr(buffer,-1,&config_lines[x++]);
      config_lines[x++] = "\0";
    }
    else
    {
      copy_text_to_ptr("HD1-SCSI-ID",config.discs.drive_d_direct_scsi_id,&config_lines[x++]);
      config_lines[x++] = "\0";
