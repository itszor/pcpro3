 AREA messages, CODE

 EXPORT msg_lookup, msg_block

msg_block	% 20

msg_buffer	% 256

msg_lookup	STMFD	R13!,{R1-R7,R14}
		MOV	R1,R0
		ADR	R0,msg_block
		ADR	R2,msg_buffer
		MOV	R3,#256
		MOV	R4,#0
		MOV	R5,#0
		MOV	R6,#0
		MOV	R7,#0
		SWI	&41502 + 1<<17 ; XMessageTrans_Lookup
		MOVVC	R0,R2
		LDMFD	R13!,{R1-R7,PC}

 END
